export global Theme {
    in-out property <color> bg-canvas: #0D0F12;
    in-out property <color> bg-sidebar: #14171D;
    in-out property <color> bg-panel: #14171D;
    in-out property <color> bg-card: #181C24;
    in-out property <color> bg-card-hover: #222733;
    in-out property <color> bg-card-selected: #252D3D;
    in-out property <color> border-subtle: #262D3D;
    in-out property <color> border-light: #343E54;

    in-out property <color> text-primary: #FFFFFF;
    in-out property <color> text-secondary: #9EABBE;
    in-out property <color> text-muted: #5E697C;

    in-out property <color> accent-cyan: #3CC9C4;
    in-out property <color> accent-lime: #B3C065;
    in-out property <color> accent-pink: #EF82EF;
    in-out property <color> accent-blue: #6F98E8;
    in-out property <color> accent-green: #00C282;
    in-out property <color> accent-amber: #DB9D20;
    in-out property <color> destructive: #FF4757;

    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-full: 9999px;
}
