import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <string> theme-choice: "system";
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> dark-mode: theme-choice == "system" ? system-dark : theme-choice == "dark";
    out property <bool> light-mode: !dark-mode;

    // Direction 2: Warm Alabaster & Amber Bronze (Things 3 / Craft / Notion inspired)
    in-out property <color> bg-canvas: dark-mode ? #18181B : #FAFAF9;
    in-out property <color> bg-sidebar: dark-mode ? #202024 : #F5F5F4;
    in-out property <color> bg-panel: dark-mode ? #242429 : #FFFFFF;
    in-out property <color> bg-card: dark-mode ? #27272A : #FFFFFF;
    in-out property <color> bg-card-hover: dark-mode ? #303036 : #EBEAE5;
    in-out property <color> bg-card-selected: dark-mode ? #332B1F : #FEF3C7;
    in-out property <color> border-subtle: dark-mode ? #2E2E33 : #E7E5E4;
    in-out property <color> border-light: dark-mode ? #3F3F46 : #D6D3D1;

    in-out property <color> text-primary: dark-mode ? #FAFAF9 : #1C1917;
    in-out property <color> text-secondary: dark-mode ? #A1A1AA : #57534E;
    in-out property <color> text-muted: dark-mode ? #71717A : #A8A29E;

    // Refined accents: warm amber primary with rich harmonized secondaries
    in-out property <color> accent-amber: dark-mode ? #F59E0B : #D97706;
    in-out property <color> accent-cyan: dark-mode ? #2DD4BF : #0D9488;
    in-out property <color> accent-lime: dark-mode ? #A3E635 : #65A30D;
    in-out property <color> accent-pink: dark-mode ? #F472B6 : #DB2777;
    in-out property <color> accent-blue: dark-mode ? #60A5FA : #2563EB;
    in-out property <color> accent-green: dark-mode ? #34D399 : #16A34A;
    in-out property <color> accent-violet: dark-mode ? #A78BFA : #7C3AED;
    in-out property <color> destructive: dark-mode ? #F87171 : #DC2626;

    out property <color> accent-amber-soft: dark-mode ? #F59E0B25 : #D977061A;
    out property <color> accent-cyan-soft: dark-mode ? #2DD4BF25 : #0D94881A;
    out property <color> accent-lime-soft: dark-mode ? #A3E63525 : #65A30D1A;
    out property <color> accent-pink-soft: dark-mode ? #F472B625 : #DB27771A;
    out property <color> accent-blue-soft: dark-mode ? #60A5FA25 : #2563EB1A;
    out property <color> accent-green-soft: dark-mode ? #34D39925 : #16A34A1A;
    out property <color> accent-violet-soft: dark-mode ? #A78BFA25 : #7C3AED1A;
    out property <color> destructive-soft: dark-mode ? #F8717125 : #DC26261A;
    out property <color> icon-fill-muted: dark-mode ? #A1A1AA20 : #78716C1A;

    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-full: 9999px;

    // Liquid glass surfaces: warm tinted highlights
    out property <color> glass-fill: dark-mode ? #FFFFFF0D : #FFFFFF1F;
    out property <color> glass-fill-strong: dark-mode ? #FFFFFF14 : #FFFFFF2E;
    out property <color> glass-fill-hover: dark-mode ? #FFFFFF1F : #FFFFFF45;
    out property <color> glass-border: dark-mode ? #FFFFFF26 : #FFFFFFA6;
    out property <color> glass-highlight: dark-mode ? #FFFFFF2E : #FFFFFFB8;
    out property <color> glass-shadow: #00000040;

    out property <length> title-bar-height: 44px;
    out property <length> radius-pill: 30px;

    // Dock & Navigation Rail: warm luminous amber pill with high-contrast active icons
    out property <color> dock-fill: dark-mode ? #202024 : #F5F5F4;
    out property <color> dock-fill-top: dark-mode ? #27272D : #FFFFFF;
    out property <color> dock-hairline: dark-mode ? #2E2E33 : #E7E5E4;
    out property <color> dock-indicator: dark-mode ? #2E281F : #FEF3C7;
    out property <color> dock-indicator-border: dark-mode ? #F59E0B4D : #D9770638;
    out property <color> dock-icon-active: dark-mode ? #F59E0B : #D97706;
    out property <color> dock-icon-active-fill: dark-mode ? #F59E0B2E : #D9770624;
    out property <color> dock-icon-passive: dark-mode ? #A1A1AA : #78716C;
}
