import { TaskRow, NoteRow, DayBar, SessionRow, TaskOption, SpaceRow, SpaceTask, SpaceColumn, CalendarDay } from "types.slint";

/// AppData: everything the screens show. Rust fills it from the saved data
/// and handles the callbacks; the screens only display it and report taps.
export global AppData {
    // Background motion, 0 to 1 and looping.
    in-out property <float> background-phase: 0.0;

    // Immersive focus: hides the navigation rail and the analytics panel.
    in-out property <bool> immersive: false;

    // Pomodoro
    in-out property <string> pomodoro-time: "50:00";
    in-out property <float> pomodoro-progress: 0.0;
    in-out property <bool> pomodoro-running: false;
    in-out property <string> pomodoro-phase: "focus";
    // "focus", "custom", "short_break" or "long_break": the tab to highlight.
    in-out property <string> pomodoro-mode: "focus";
    in-out property <string> pomodoro-round: "Round 1 of 4";
    // Completed rounds in the current cycle, 0 to 4.
    in-out property <int> pomodoro-rounds-done: 0;
    // "Ready", "Running", "Paused" or "Completed".
    in-out property <string> pomodoro-status: "Ready";
    in-out property <string> pomodoro-durations: "";
    in-out property <int> pomodoro-custom-mins: 40;
    in-out property <string> session-name: "";
    // "off", "lofi", "forest" or "rain".
    in-out property <string> ambient-choice: "forest";
    callback ambient-selected(string);
    callback session-name-edited(string);
    callback pomodoro-toggle();
    callback pomodoro-next();
    callback pomodoro-previous();
    callback pomodoro-reset();
    callback pomodoro-select(string);

    // Task linked to the current session. Empty id means a freeform session.
    in-out property <string> session-task-id: "";
    in-out property <string> session-task-title: "";
    in-out property <[TaskOption]> task-options: [];
    in-out property <string> task-search: "";
    callback task-picked(string);
    callback task-search-changed(string);

    // Analytics for the Pomodoro panel
    in-out property <string> activity-range: "week";
    in-out property <string> activity-sessions: "0";
    in-out property <string> activity-sessions-change: "";
    in-out property <string> activity-focus: "0m";
    in-out property <string> activity-focus-change: "";
    in-out property <string> activity-average: "0m";
    in-out property <string> activity-best: "";
    in-out property <string> activity-streak: "0 days";
    in-out property <int> activity-axis-max: 1;
    in-out property <[DayBar]> activity-bars: [];
    callback activity-range-selected(string);

    // Today
    in-out property <string> today-focus: "0m";
    in-out property <[TaskRow]> today-tasks: [];

    // Tasks
    in-out property <string> new-task-text: "";
    in-out property <[TaskRow]> tasks-today: [];
    in-out property <[TaskRow]> tasks-week: [];
    in-out property <[TaskRow]> tasks-backlog: [];
    in-out property <[TaskRow]> tasks-done: [];
    callback add-task(string);
    callback toggle-task(string);
    callback move-task(string, string);
    callback delete-task(string);

    // Spaces: where tasks live. An empty space-id means every space.
    in-out property <[SpaceRow]> spaces: [];
    in-out property <string> space-id: "";
    in-out property <string> space-name: "All spaces";
    in-out property <color> space-color: #A78BFA;
    in-out property <string> space-letter: "A";
    in-out property <int> space-open-count: 0;
    // Open tasks across every space.
    in-out property <int> all-open-count: 0;
    // "board", "matrix" or "calendar".
    in-out property <string> space-view: "board";
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <[SpaceColumn]> board-columns: [];
    in-out property <[SpaceColumn]> matrix-quadrants: [];
    in-out property <[SpaceColumn]> matrix-unsorted: [];
    in-out property <int> matrix-unsorted-count: 0;
    in-out property <[SpaceColumn]> calendar-unscheduled: [];
    in-out property <[CalendarDay]> calendar-days: [];
    in-out property <string> calendar-label: "";
    callback space-selected(string);
    // name, colour as "#RRGGBB"
    callback space-created(string, string);
    // id, name, colour
    callback space-edited(string, string, string);
    callback space-deleted(string);
    // section ("backlog", "this_week", "today"), text
    callback space-task-added(string, string);
    // From the task composer: section, title, estimate minutes, space id,
    // do date (YYYY-MM-DD, "today", "tomorrow" or empty), notes.
    callback space-task-composed(string, string, int, string, string, string);
    // task id, section
    callback space-task-moved(string, string);
    // task id, quadrant ("" clears)
    callback task-quadrant-set(string, string);
    // task id, day index in the calendar week (-1 takes it off the calendar)
    callback task-day-set(string, int);
    // day index, text: adds a task planned for that day
    callback calendar-task-added(int, string);
    // -1 or 1 moves a week; 0 returns to this week
    callback calendar-shift(int);
    callback space-undo();
    callback space-redo();
    // Task cards. Edits: id, title, estimate minutes, notes, do date,
    // deadline. Dates are YYYY-MM-DD, "today", "tomorrow" or empty.
    callback space-task-edited(string, string, string, string, string, string);
    callback space-task-toggled(string);
    callback space-task-deleted(string);
    // parent id, title
    callback step-added(string, string);
    // Starts a focus round on this task. The screen then opens Pomodoro.
    callback task-launched(string);

    // AI assistant (OpenRouter for now, a bundled model later).
    in-out property <bool> ai-key-saved: false;
    in-out property <string> ai-model: "openai/gpt-4o-mini";
    // One short line about the last AI call or key change.
    in-out property <string> ai-status: "";
    in-out property <bool> ai-busy: false;
    // The Plan with AI panel: proposals waiting for a decision.
    in-out property <bool> ai-panel-open: false;
    in-out property <[string]> ai-proposals: [];
    // Set by ai-apply when the plan started a focus round, so the screen
    // can open Pomodoro.
    in-out property <bool> ai-focus-started: false;
    // Opens or closes Windows voice typing for the focused field.
    callback mic-toggle();
    callback ai-key-save(string);
    callback ai-key-remove();
    callback ai-model-set(string);
    callback ai-test();
    // request text, start the first task now
    callback ai-plan(string, bool);
    callback ai-apply();
    callback ai-discard();
    // Sent from a worker thread when a reply arrives: kind ("plan", "sort",
    // "test"), success, text.
    callback ai-reply(string, bool, string);

    // Sort screen: one unsorted task at a time.
    in-out property <bool> triage-open: false;
    in-out property <SpaceTask> triage-task;
    in-out property <bool> triage-has-task: false;
    in-out property <int> triage-position: 0;
    in-out property <int> triage-total: 0;
    in-out property <int> triage-decided: 0;
    // The AI's suggested quadrant for the task on show, or "".
    in-out property <string> triage-suggestion: "";
    callback triage-start();
    // quadrant id
    callback triage-decide(string);
    callback triage-skip();
    callback triage-back();
    callback triage-close();
    callback triage-ask-ai();

    // Notes
    in-out property <[NoteRow]> notes: [];
    in-out property <string> selected-note-id: "";
    in-out property <string> selected-note-title: "";
    in-out property <string> selected-note-body: "";
    callback new-note();
    callback select-note(string);
    callback save-note(string, string);
    callback delete-note();

    // Insights
    in-out property <string> insight-focus-week: "0m";
    in-out property <string> insight-sessions: "0";
    in-out property <string> insight-streak: "0 days";
    in-out property <[DayBar]> insight-bars: [];
    in-out property <[SessionRow]> session-history: [];

    // Settings
    in-out property <int> setting-focus-mins: 25;
    in-out property <int> setting-short-mins: 5;
    in-out property <int> setting-long-mins: 15;
    in-out property <int> setting-rounds: 4;
    in-out property <bool> setting-auto-advance: false;
    callback adjust-setting(string, int);
    callback set-auto-advance(bool);
    // Breaks between focus rounds; off runs focus after focus.
    in-out property <bool> setting-breaks: true;
    in-out property <bool> setting-start-next: false;
    // Saved language id, such as "en".
    in-out property <string> setting-language: "en";
    // key, value: sets a number setting to exactly this value.
    callback set-setting(string, int);
    // key, value: switches a yes/no setting.
    callback set-setting-flag(string, bool);
    callback set-language(string);
}
