// Window and ambient state shared by the application shell.
export global ShellState {
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    callback window-resize-start(string, float, float);
    callback window-resize-move(float, float);
    callback window-resize-end();

    in-out property <bool> orb-drift: false;
    in-out property <string> theme-choice: "system";
    callback theme-choice-changed(string);
    in-out property <bool> is-maximized: false;
}
