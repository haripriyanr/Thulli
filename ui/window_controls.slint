import { Theme } from "theme.slint";

// Adaptive window controls for the frameless shell.
// Displays macOS traffic lights (top-left) on macOS, or sleek frameless controls (top-right) on Windows/Linux.
export component WindowControls {
    in property <bool> is-maximized: false;
    in property <bool> is-macos: false;

    callback minimize();
    callback maximize();
    callback close();

    // macOS traffic light buttons (Close | Minimize | Maximize)
    if root.is-macos: macos-cluster := Rectangle {
        width: 68px;
        height: 24px;
        mac-hover := TouchArea { width: 100%; height: 100%; }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            // Close (Red)
            mac-close-touch := TouchArea {
                width: 12px;
                height: 12px;
                clicked => { root.close(); }

                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #FF5F56;
                    border-width: 0.5px;
                    border-color: #E0443E;

                    if mac-hover.has-hover: Path {
                        width: 6px;
                        height: 6px;
                        x: 3px;
                        y: 3px;
                        stroke: #4D0000;
                        stroke-width: 1.2px;
                        commands: "M 0 0 L 6 6 M 6 0 L 0 6";
                    }
                }
            }

            // Minimize (Yellow)
            mac-min-touch := TouchArea {
                width: 12px;
                height: 12px;
                clicked => { root.minimize(); }

                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #FFBD2E;
                    border-width: 0.5px;
                    border-color: #DEA123;

                    if mac-hover.has-hover: Rectangle {
                        width: 6px;
                        height: 1.2px;
                        x: 3px;
                        y: 5.4px;
                        background: #5A3E00;
                    }
                }
            }

            // Maximize / Fullscreen (Green)
            mac-max-touch := TouchArea {
                width: 12px;
                height: 12px;
                clicked => { root.maximize(); }

                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #27C93F;
                    border-width: 0.5px;
                    border-color: #1AAB29;

                    if mac-hover.has-hover: Path {
                        width: 6px;
                        height: 6px;
                        x: 3px;
                        y: 3px;
                        stroke: #004812;
                        stroke-width: 1.1px;
                        commands: "M 1 5 L 5 1 M 1 2 L 1 5 L 4 5 M 5 4 L 5 1 L 2 1";
                    }
                }
            }
        }
    }

    // Windows & Linux controls (Minimize | Maximize | Close)
    if !root.is-macos: HorizontalLayout {
        spacing: 4px;
        alignment: end;

        // Minimize
        min-touch := TouchArea {
            width: 30px;
            height: 30px;
            clicked => { root.minimize(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 9px;
                background: min-touch.has-hover ? Theme.glass-fill-hover : transparent;

                Rectangle {
                    width: 11px;
                    height: 1.5px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: min-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }
        }

        // Maximize / restore
        max-touch := TouchArea {
            width: 30px;
            height: 30px;
            clicked => { root.maximize(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 9px;
                background: max-touch.has-hover ? Theme.glass-fill-hover : transparent;

                if !root.is-maximized: Rectangle {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-width: 1.4px;
                    border-color: max-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    border-radius: 2.5px;
                }

                if root.is-maximized: Rectangle {
                    width: 9px;
                    height: 9px;
                    x: (parent.width - self.width) / 2 - 1.5px;
                    y: (parent.height - self.height) / 2 + 1.5px;
                    border-width: 1.4px;
                    border-color: max-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    border-radius: 2.5px;

                    Rectangle {
                        x: 2.5px;
                        y: -2.5px;
                        width: parent.width;
                        height: parent.height;
                        border-width: 1.4px;
                        border-color: max-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        border-radius: 2.5px;
                    }
                }
            }
        }

        // Close
        close-touch := TouchArea {
            width: 30px;
            height: 30px;
            clicked => { root.close(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 9px;
                background: close-touch.has-hover ? #E5484D : transparent;

                Path {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: close-touch.has-hover ? #FFFFFF : Theme.text-secondary;
                    stroke-width: 1.5px;
                    commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                }
            }
        }
    }
}
