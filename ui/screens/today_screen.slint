import { Theme } from "../theme.slint";
import { IconCalendar } from "../icons.slint";
import { GlassCard } from "../components/glass.slint";
import { SectionTitle, TaskRowView } from "../components/rows.slint";
import { AppData } from "../app_data.slint";

/// TodayScreen: what is planned for today and the focus time recorded today.
export component TodayScreen inherits Rectangle {
    clip: true;
    background: transparent;

    function next-section(section: string) -> string {
        if section == "today" { return "week"; }
        if section == "week" { return "backlog"; }
        return "today";
    }

    Flickable {
      width: 100%;
      height: 100%;
      content-height: page.preferred-height;
      content-width: self.width;
      page := VerticalLayout {
        width: parent.width;
        padding-top: 24px;
        padding-bottom: 24px;
        padding-left: 28px;
        padding-right: 28px;
        spacing: 18px;

        VerticalLayout {
            spacing: 4px;
            Text { text: @tr("Today"); font-size: 22px; font-weight: 700; color: Theme.text-primary; }
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                IconCalendar { width: 14px; height: 14px; stroke-color: Theme.text-secondary; }
                Text { text: @tr("Focused today: {}", AppData.today-focus); font-size: 13px; color: Theme.text-secondary; }
            }
        }

        GlassCard {
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: start;
                SectionTitle { text: @tr("Planned for today"); }

                if AppData.today-tasks.length == 0: Text {
                    text: @tr("Nothing planned for today. Add tasks on the Spaces screen.");
                    font-size: 13px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                for task in AppData.today-tasks: TaskRowView {
                    title: task.title;
                    meta: task.meta;
                    done: task.done;
                    section: task.section;
                    action-label: @tr("Later");
                    action-tip: @tr("Move to this week");
                    toggled => { AppData.toggle-task(task.id); }
                    moved => { AppData.move-task(task.id, "week"); }
                    deleted => { AppData.delete-task(task.id); }
                }
            }
        }
      }
    }
}
