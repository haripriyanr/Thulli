import { Theme } from "../theme.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";
import { IconFolder, IconCheck } from "../icons.slint";
import { ThulliEmptyState } from "../components/empty_state.slint";
import { ShellState } from "../shell_state.slint";
import { ListModel, TaskModel } from "../types.slint";

/// State and callbacks for the lists screen. Rust fills the models and
/// handles the callbacks; see src/app/lists.rs.
export global ListsState {
    in-out property <[ListModel]> lists: [];
    in-out property <[ListModel]> archived-lists: [];
    in-out property <[TaskModel]> archived-tasks: [];
    in-out property <bool> show-archive: false;
    /// Create / edit panel. An empty `editor-id` means a new list.
    in-out property <bool> editor-open: false;
    in-out property <string> editor-id: "";
    in-out property <string> editor-name: "";
    /// Index into the palette (see ListPalette and src/app/lists.rs).
    in-out property <int> editor-color: 0;

    callback request-refresh();
    callback save-list(string, string, int);      // id (empty for new), name, palette index
    callback edit-list(string);                   // id; Rust fills the editor
    callback duplicate-list(string);
    callback archive-list(string);
    callback restore-list(string);
    callback open-list(string);
    callback reopen-task(string);
}

/// Colours offered for a list.
global ListPalette {
    out property <[color]> swatches: [
        #3CC9C4, #6F98E8, #B3C065, #EF82EF, #DB9D20, #6FDBAB
    ];
}

/// Small text button.
component TextAction inherits TouchArea {
    in property <string> label;
    in property <bool> emphasis: false;
    width: 80px;
    height: 28px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-sm;
        background: root.emphasis ? (root.has-hover ? Theme.bg-card-selected : Theme.bg-card) : (root.has-hover ? Theme.bg-card-hover : transparent);
        border-width: root.emphasis ? 1px : 0px;
        border-color: Theme.border-light;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: root.emphasis ? Theme.accent-cyan : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// One list as a row: badge, name, pending count and actions.
component ListRow inherits Rectangle {
    in property <ListModel> list;
    in property <bool> archived: false;

    height: 72px;
    background: row-open.has-hover ? Theme.bg-card-hover : Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // Behind the actions: clicking the row opens the list on the board.
    row-open := TouchArea {
        clicked => { ListsState.open-list(root.list.id); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 14px;

        Rectangle {
            width: 36px;
            height: 36px;
            y: 18px;
            border-radius: Theme.radius-full;
            background: root.list.color;
            Text {
                text: root.list.badge-letter;
                font-size: 15px;
                font-weight: 700;
                color: #000000;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.list.name;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: root.list.pending-count == 0 ? "All clear" : root.list.pending-count + " pending tasks";
                font-size: 12px;
                color: root.list.pending-count == 0 ? Theme.text-muted : Theme.accent-cyan;
            }
        }

        if !root.archived: HorizontalLayout {
            alignment: end;
            spacing: 2px;
            TextAction { width: 56px; label: "Edit"; clicked => { ListsState.edit-list(root.list.id); } }
            TextAction { width: 84px; label: "Duplicate"; clicked => { ListsState.duplicate-list(root.list.id); } }
            TextAction { width: 72px; label: "Archive"; clicked => { ListsState.archive-list(root.list.id); } }
        }

        if root.archived: HorizontalLayout {
            alignment: end;
            TextAction { width: 72px; label: "Restore"; clicked => { ListsState.restore-list(root.list.id); } }
        }
    }
}

/// One finished task in the archive.
component DoneRow inherits Rectangle {
    in property <TaskModel> task;

    height: 52px;
    background: Theme.bg-card;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        IconCheck {
            width: 14px;
            height: 14px;
            y: 19px;
            stroke-color: Theme.accent-lime;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.task.title;
                font-size: 13px;
                color: Theme.text-muted;
                overflow: elide;
            }
            Text {
                text: root.task.list-name;
                font-size: 11px;
                color: Theme.text-muted;
            }
        }
        TextAction { width: 72px; label: "Reopen"; clicked => { ListsState.reopen-task(root.task.id); } }
    }
}

/// ListsScreen: the list rows, the create / edit panel and the archive.
export component ListsScreen inherits Rectangle {
    background: transparent;

    init => { ListsState.request-refresh(); }

    VerticalLayout {
        padding: 20px;
        padding-bottom: ShellState.content-bottom-inset;
        spacing: 14px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: ListsState.show-archive ? "Archive" : "Your Lists";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            TextAction {
                width: 110px;
                label: ListsState.show-archive ? "Back to lists" : "Archive";
                clicked => { ListsState.show-archive = !ListsState.show-archive; }
            }
            TextAction {
                width: 90px;
                label: "New list";
                emphasis: true;
                clicked => {
                    ListsState.editor-id = "";
                    ListsState.editor-name = "";
                    ListsState.editor-color = 0;
                    ListsState.editor-open = true;
                    ListsState.show-archive = false;
                }
            }
        }

        // Create / edit panel
        if ListsState.editor-open: Rectangle {
            height: 160px;
            background: Theme.bg-card-selected;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.accent-cyan;

            FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        ListsState.editor-open = false;
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: ListsState.editor-id == "" ? "Create a new list" : "Edit list";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    name-input := LineEdit {
                        text: ListsState.editor-name;
                        placeholder-text: "List name (e.g. Work, Personal)";
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for swatch[idx] in ListPalette.swatches: TouchArea {
                            width: 22px;
                            height: 22px;
                            clicked => { ListsState.editor-color = idx; }
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: Theme.radius-full;
                                background: swatch;
                                border-width: ListsState.editor-color == idx ? 2px : 0px;
                                border-color: #FFFFFF;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        TextAction { width: 80px; label: "Cancel"; clicked => { ListsState.editor-open = false; } }
                        TextAction {
                            width: 80px;
                            label: "Save";
                            emphasis: true;
                            clicked => {
                                ListsState.save-list(ListsState.editor-id, name-input.text, ListsState.editor-color);
                            }
                        }
                    }
                }
            }
        }

        if !ListsState.show-archive: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                alignment: start;
                for list in ListsState.lists: ListRow { list: list; }
                if ListsState.lists.length == 0: ThulliEmptyState {
                    title: "No lists yet";
                    subtitle: "Lists keep related tasks together. Create one to get started.";
                    IconFolder {
                        width: 40px;
                        height: 40px;
                    }
                }
            }
        }

        if ListsState.show-archive: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                alignment: start;

                Text {
                    text: "Archived lists";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-muted;
                }
                for list in ListsState.archived-lists: ListRow { list: list; archived: true; }
                if ListsState.archived-lists.length == 0: Text {
                    text: "No archived lists.";
                    font-size: 12px;
                    color: Theme.text-muted;
                }

                Text {
                    text: "Finished tasks";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-muted;
                }
                for task in ListsState.archived-tasks: DoneRow { task: task; }
                if ListsState.archived-tasks.length == 0: Text {
                    text: "Finished tasks show up here.";
                    font-size: 12px;
                    color: Theme.text-muted;
                }
            }
        }
    }
}
