import { Theme } from "../theme.slint";
import { IconTimer, IconLanguage, IconCheck } from "../icons.slint";
import { LanguagePicker } from "../components/language_picker.slint";
import { GlassCard } from "../components/glass.slint";
import { Switch, SelectBox, SettingRow } from "../components/settings_controls.slint";
import { AppData } from "../app_data.slint";

/// A small text button.
component PlainButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: label-text.preferred-width + 28px;
    height: 40px;
    border-radius: 10px;
    background: touch.has-hover ? Theme.glass-fill-hover : Theme.glass-fill-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    label-text := Text { text: root.label; font-size: 14px; font-weight: 600; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// A titled group of settings.
component SettingsSection inherits GlassCard {
    in property <string> title;
    in property <string> caption;
    corner: 20px;
    height: body.preferred-height;
    body := VerticalLayout {
        padding: 28px;
        padding-top: 24px;
        spacing: 8px;
        Text { text: root.title; font-size: 20px; font-weight: 700; color: Theme.text-primary; }
        if root.caption != "": Text { text: root.caption; font-size: 15px; color: Theme.text-muted; }
        @children
    }
}

/// SettingsScreen: timer settings and language. Every change is saved
/// straight away and the timer picks it up.
export component SettingsScreen inherits Rectangle {
    clip: true;
    background: transparent;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: page.preferred-height;
        page := VerticalLayout {
            width: parent.width;
            padding-top: 20px;
            padding-bottom: 28px;
            padding-right: 28px;
            spacing: 18px;
            alignment: start;

            Text { text: @tr("Settings"); font-size: 28px; font-weight: 700; color: Theme.text-primary; }

            SettingsSection {
                title: @tr("Language");
                caption: "";
                HorizontalLayout {
                    spacing: 14px;
                    padding-top: 6px;
                    VerticalLayout { alignment: start; padding-top: 22px; IconLanguage { width: 22px; height: 22px; } }
                    SettingRow {
                        horizontal-stretch: 1;
                        strong: true;
                        label: @tr("App language");
                        hint: @tr("Choice applies immediately and is saved on this device.");
                        LanguagePicker { width: 280px; }
                    }
                }
            }

            SettingsSection {
                title: @tr("AI");
                caption: @tr("Planning, speech recognition and reading aloud all run on this device. Nothing you say or type leaves it.");
                SettingRow {
                    label: AppData.ai-models-ready ? @tr("AI models installed") : @tr("AI models (about 2.3 GB)");
                    hint: AppData.ai-models-ready ? @tr("Remove them to free the space; they download again when needed.") : @tr("They download the first time you use AI, or now.");
                    HorizontalLayout {
                        spacing: 8px;
                        // Installed: a green Ready badge.
                        if AppData.ai-models-ready: Rectangle {
                            width: ready-row.preferred-width + 24px;
                            height: 40px;
                            border-radius: 20px;
                            background: Theme.accent-green.with-alpha(0.16);
                            border-width: 1px;
                            border-color: Theme.accent-green.with-alpha(0.55);
                            ready-row := HorizontalLayout {
                                x: 12px;
                                spacing: 6px;
                                alignment: center;
                                VerticalLayout { alignment: center; IconCheck { width: 14px; height: 14px; stroke-color: Theme.accent-green; } }
                                Text { text: @tr("Ready"); font-size: 14px; font-weight: 600; color: Theme.accent-green; vertical-alignment: center; }
                            }
                        }
                        PlainButton { label: @tr("Refresh"); clicked => { AppData.ai-models-refresh(); } }
                        if !AppData.ai-models-ready: PlainButton { label: AppData.ai-busy ? @tr("Downloading...") : @tr("Download now"); clicked => { if !AppData.ai-busy { AppData.ai-models-download(); } } }
                        if AppData.ai-models-ready: PlainButton { label: @tr("Remove"); clicked => { AppData.ai-models-remove(); } }
                    }
                }
                if AppData.ai-status != "": Text { text: AppData.ai-status; font-size: 13px; color: Theme.text-secondary; wrap: word-wrap; }
            }

            SettingsSection {
                title: @tr("Timer settings");
                caption: @tr("Manage the productivity timer.");

                // Pomodoros: breaks on or off, with the cycle under it.
                HorizontalLayout {
                    spacing: 14px;
                    padding-top: 10px;
                    VerticalLayout { alignment: start; padding-top: 22px; IconTimer { width: 22px; height: 22px; stroke-color: Theme.text-secondary; } }
                    SettingRow {
                        horizontal-stretch: 1;
                        strong: true;
                        label: @tr("Pomodoros");
                        hint: @tr("Alternate focused work sprints with timed breaks.");
                        Switch { on: AppData.setting-breaks; toggled(on) => { AppData.set-setting-flag("pomodoro_breaks", on); } }
                    }
                }
                HorizontalLayout {
                    padding-left: 34px;
                    spacing: 26px;
                    // The line marks these rows as part of Pomodoros.
                    Rectangle { width: 1px; background: Theme.glass-border; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        SettingRow {
                            label: @tr("Work sprint");
                            info: "Length of one focus round";
                            SelectBox {
                                current: AppData.setting-focus-mins;
                                label: @tr("{}min", AppData.setting-focus-mins);
                                options: [
                                    { label: "15min", value: 15 }, { label: "20min", value: 20 }, { label: "25min", value: 25 },
                                    { label: "30min", value: 30 }, { label: "40min", value: 40 }, { label: "45min", value: 45 },
                                    { label: "50min", value: 50 }, { label: "60min", value: 60 }, { label: "75min", value: 75 },
                                    { label: "90min", value: 90 },
                                ];
                                selected(v) => { AppData.set-setting("default_session_mins", v); }
                            }
                        }
                        if AppData.setting-breaks: SettingRow {
                            label: @tr("Short break");
                            info: "Break after each focus round";
                            SelectBox {
                                current: AppData.setting-short-mins;
                                label: @tr("{}min", AppData.setting-short-mins);
                                options: [
                                    { label: "3min", value: 3 }, { label: "5min", value: 5 }, { label: "10min", value: 10 },
                                    { label: "15min", value: 15 }, { label: "20min", value: 20 },
                                ];
                                selected(v) => { AppData.set-setting("default_break_mins", v); }
                            }
                        }
                        if AppData.setting-breaks: SettingRow {
                            label: @tr("Long break");
                            info: "Longer break at the end of a cycle";
                            SelectBox {
                                current: AppData.setting-long-mins;
                                label: @tr("{}min", AppData.setting-long-mins);
                                options: [
                                    { label: "10min", value: 10 }, { label: "15min", value: 15 }, { label: "20min", value: 20 },
                                    { label: "25min", value: 25 }, { label: "30min", value: 30 },
                                ];
                                selected(v) => { AppData.set-setting("pomodoro_long_break_mins", v); }
                            }
                        }
                        if AppData.setting-breaks: SettingRow {
                            label: @tr("Long break after");
                            info: "Focus rounds before the long break";
                            SelectBox {
                                width: 230px;
                                current: AppData.setting-rounds;
                                label: @tr("{} work sprints", AppData.setting-rounds);
                                options: [
                                    { label: @tr("2 work sprints"), value: 2 }, { label: @tr("3 work sprints"), value: 3 },
                                    { label: @tr("4 work sprints"), value: 4 }, { label: @tr("5 work sprints"), value: 5 },
                                    { label: @tr("6 work sprints"), value: 6 },
                                ];
                                selected(v) => { AppData.set-setting("pomodoro_rounds", v); }
                            }
                        }
                    }
                }
                SettingRow {
                    label: @tr("Start next task when ending a break early");
                    info: "Skipping a break links the next Today task and starts it";
                    Switch { on: AppData.setting-start-next; toggled(on) => { AppData.set-setting-flag("start_next_after_early_break", on); } }
                }
                SettingRow {
                    label: @tr("Start the next phase automatically");
                    info: "Keep the timer running when a phase ends";
                    Switch { on: AppData.setting-auto-advance; toggled(on) => { AppData.set-auto-advance(on); } }
                }
            }

        }
    }
}
