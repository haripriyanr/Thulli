import { Theme } from "../theme.slint";
import { ShellState } from "../shell_state.slint";
import { ThulliButton, ThulliIconButton } from "../components/buttons.slint";
import { ThulliChipRow } from "../components/chip_row.slint";
import { ThulliLineChart } from "../components/chart_line.slint";
import { ThulliBarChart } from "../components/chart_bars.slint";
import { ThulliHeatmap } from "../components/chart_heatmap.slint";
import { ThulliRatioBar } from "../components/chart_ratio.slint";
import { ThulliStatTile } from "../components/stat_tile.slint";
import { ThulliStatPanel } from "../components/stat_panel.slint";
import { ThulliTextField } from "../components/text_field.slint";
import { IconChevronLeft, IconChevronRight } from "../icons.slint";
import { ChartPointModel, StatTileModel, BarModel, HeatCellModel, TaskModel, ActivityEntryModel, ChoiceModel } from "../types.slint";

/// State and callbacks for the insights screen. The screen owner edits this
/// global freely; the shell re-exports it, so app.slint does not change.
export global InsightsState {
    in-out property <string> period-label: "This week";
    in-out property <string> list-filter: "";
    /// Lists offered by the list filter; the first entry (empty id) means all lists.
    in-out property <[ChoiceModel]> lists: [];
    /// "all", "done" or "progress".
    in-out property <string> task-filter: "all";
    /// Cumulative worked time against the goal pace line.
    in-out property <[ChartPointModel]> worked-line: [];
    in-out property <[ChartPointModel]> pace-line: [];
    /// The same lines as SVG path commands (0 to 1000 box) for the chart.
    in-out property <string> worked-path: "";
    in-out property <string> worked-area-path: "";
    in-out property <string> pace-path: "";
    in-out property <string> pace-label: "";
    in-out property <[StatTileModel]> tiles: [];
    in-out property <[BarModel]> workday-bars: [];
    /// Goal as a fraction of the tallest bar; negative hides the marker.
    in-out property <float> goal-line: -1;
    in-out property <[HeatCellModel]> heatmap: [];
    in-out property <int> streak-days: 0;
    in-out property <[TaskModel]> worked-tasks: [];
    in-out property <[ActivityEntryModel]> activity: [];
    /// Time ratio shares (0 to 1) and their labels.
    in-out property <float> ratio-focus: 0;
    in-out property <float> ratio-planning: 0;
    in-out property <float> ratio-other: 0;
    in-out property <string> ratio-focus-label: "";
    in-out property <string> ratio-planning-label: "";
    in-out property <string> ratio-other-label: "";
    // Activity editor. An empty `edit-id` hides it.
    in-out property <string> edit-id: "";
    in-out property <string> edit-title: "";
    in-out property <string> edit-start: "";
    in-out property <string> edit-end: "";
    in-out property <string> error: "";

    callback refresh();
    callback previous-period();
    callback next-period();
    callback set-list-filter(string);
    callback set-task-filter(string);
    callback begin-edit-activity(string);
    callback save-activity(string, string, string);   // id, start HH:MM, end HH:MM
    callback delete-activity(string);
    callback export-csv();
    callback export-report();
}

/// InsightsScreen: where the week's time went.
export component InsightsScreen inherits Rectangle {
    background: transparent;

    init => {
        InsightsState.refresh();
    }

    Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: content.preferred-height + ShellState.content-bottom-inset + 24px;

        content := VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            padding: 24px;
            padding-top: 16px;
            spacing: 14px;
            alignment: start;

            // Header
            HorizontalLayout {
                spacing: 10px;
                height: 36px;

                Text {
                    text: "Insights";
                    font-size: 22px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { }
                ThulliIconButton {
                    size: 28px;
                    hover-bg: Theme.bg-card-hover;
                    active-bg: Theme.bg-card-selected;
                    y: 4px;
                    clicked => {
                        InsightsState.previous-period();
                    }
                    IconChevronLeft {
                        width: 16px;
                        height: 16px;
                        x: 6px;
                        y: 6px;
                    }
                }
                Text {
                    text: InsightsState.period-label;
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    min-width: 110px;
                }
                ThulliIconButton {
                    size: 28px;
                    hover-bg: Theme.bg-card-hover;
                    active-bg: Theme.bg-card-selected;
                    y: 4px;
                    clicked => {
                        InsightsState.next-period();
                    }
                    IconChevronRight {
                        width: 16px;
                        height: 16px;
                        x: 6px;
                        y: 6px;
                    }
                }
                ThulliButton {
                    text: "Export CSV";
                    variant: "secondary";
                    width: 96px;
                    height: 32px;
                    y: 2px;
                    clicked => {
                        InsightsState.export-csv();
                    }
                }
                ThulliButton {
                    text: "Report PDF";
                    variant: "secondary";
                    width: 96px;
                    height: 32px;
                    y: 2px;
                    clicked => {
                        InsightsState.export-report();
                    }
                }
                ThulliButton {
                    text: "Reports";
                    variant: "secondary";
                    width: 76px;
                    height: 32px;
                    y: 2px;
                    clicked => {
                        ShellState.navigate("reports");
                    }
                }
            }

            ThulliChipRow {
                choices: InsightsState.lists;
                selected: InsightsState.list-filter;
                visible: InsightsState.lists.length > 1;
                height: InsightsState.lists.length > 1 ? 30px : 0px;
                picked(id) => {
                    InsightsState.set-list-filter(id);
                }
            }

            // Worked time against pace
            ThulliStatPanel {
                title: "Worked time";
                subtitle: InsightsState.pace-label;

                ThulliLineChart {
                    height: 170px;
                    line: InsightsState.worked-path;
                    area: InsightsState.worked-area-path;
                    reference: InsightsState.pace-path;
                }
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Text {
                        text: "Your time";
                        font-size: 11px;
                        color: Theme.accent-cyan;
                    }
                    Text {
                        text: "Goal pace";
                        font-size: 11px;
                        color: Theme.text-muted;
                    }
                }
            }

            // Tiles
            HorizontalLayout {
                spacing: 12px;
                for tile in InsightsState.tiles: ThulliStatTile {
                    title: tile.title;
                    value: tile.value;
                    caption: tile.caption;
                    height: 92px;
                }
            }

            // Ratio and per-day bars
            HorizontalLayout {
                spacing: 12px;

                ThulliStatPanel {
                    title: "Time ratio";
                    horizontal-stretch: 1;

                    ThulliRatioBar {
                        first: InsightsState.ratio-focus;
                        second: InsightsState.ratio-planning;
                        third: InsightsState.ratio-other;
                    }
                    Text {
                        text: "Focus  " + InsightsState.ratio-focus-label;
                        font-size: 12px;
                        color: Theme.accent-cyan;
                    }
                    Text {
                        text: "Planning  " + InsightsState.ratio-planning-label;
                        font-size: 12px;
                        color: Theme.accent-blue;
                    }
                    Text {
                        text: "Other  " + InsightsState.ratio-other-label;
                        font-size: 12px;
                        color: Theme.accent-pink;
                    }
                }

                ThulliStatPanel {
                    title: "Each day";
                    horizontal-stretch: 2;

                    ThulliBarChart {
                        height: 150px;
                        bars: InsightsState.workday-bars;
                        goal-line: InsightsState.goal-line;
                        bar-color: Theme.accent-blue;
                    }
                }
            }

            // Consistency
            ThulliStatPanel {
                title: "Consistency";
                subtitle: InsightsState.streak-days == 1 ? "1 day streak" : (InsightsState.streak-days + " day streak");

                HorizontalLayout {
                    alignment: start;
                    ThulliHeatmap {
                        cells: InsightsState.heatmap;
                    }
                }
            }

            // Tasks worked on
            ThulliStatPanel {
                title: "Tasks worked on";

                ThulliChipRow {
                    choices: [
                        { id: "all", label: "All" },
                        { id: "done", label: "Done" },
                        { id: "progress", label: "In progress" },
                    ];
                    selected: InsightsState.task-filter;
                    picked(id) => {
                        InsightsState.set-task-filter(id);
                    }
                }

                if InsightsState.worked-tasks.length == 0: Text {
                    text: "No tracked tasks in this week.";
                    font-size: 12px;
                    color: Theme.text-muted;
                }

                for task in InsightsState.worked-tasks: HorizontalLayout {
                    spacing: 10px;
                    height: 26px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: 9px;
                        border-radius: 4px;
                        background: task.list-color.with-alpha(0.7);
                    }
                    Text {
                        text: task.title;
                        font-size: 13px;
                        color: task.status == "completed" ? Theme.text-secondary : Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: task.list-name;
                        font-size: 11px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: (task.tracked-mins >= 60 ? (Math.floor(task.tracked-mins / 60) + "h ") : "") + Math.mod(task.tracked-mins, 60) + "m";
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 56px;
                    }
                }
            }

            // Activity log
            ThulliStatPanel {
                title: "Activity";

                if InsightsState.edit-id != "": Rectangle {
                    background: Theme.bg-panel;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-light;
                    height: editor.preferred-height;

                    editor := VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Edit " + InsightsState.edit-title;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ThulliTextField {
                                placeholder: "Start (HH:MM)";
                                text <=> InsightsState.edit-start;
                            }
                            ThulliTextField {
                                placeholder: "End (HH:MM)";
                                text <=> InsightsState.edit-end;
                            }
                        }
                        if InsightsState.error != "": Text {
                            text: InsightsState.error;
                            font-size: 12px;
                            color: Theme.destructive;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            ThulliButton {
                                text: "Delete";
                                variant: "secondary";
                                width: 72px;
                                height: 30px;
                                clicked => {
                                    InsightsState.delete-activity(InsightsState.edit-id);
                                }
                            }
                            ThulliButton {
                                text: "Cancel";
                                variant: "secondary";
                                width: 72px;
                                height: 30px;
                                clicked => {
                                    InsightsState.edit-id = "";
                                    InsightsState.error = "";
                                }
                            }
                            ThulliButton {
                                text: "Save";
                                variant: "secondary";
                                width: 72px;
                                height: 30px;
                                clicked => {
                                    InsightsState.save-activity(InsightsState.edit-id, InsightsState.edit-start, InsightsState.edit-end);
                                }
                            }
                        }
                    }
                }

                if InsightsState.activity.length == 0: Text {
                    text: "Nothing tracked in this week.";
                    font-size: 12px;
                    color: Theme.text-muted;
                }

                for entry in InsightsState.activity: HorizontalLayout {
                    spacing: 12px;
                    height: 30px;
                    Text {
                        text: entry.day-label;
                        font-size: 12px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        min-width: 80px;
                    }
                    Text {
                        text: entry.task-title;
                        font-size: 13px;
                        color: entry.kind == "break" ? Theme.text-secondary : Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: entry.time-label;
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: entry.duration-label;
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 52px;
                    }
                    TouchArea {
                        width: 44px;
                        height: 30px;
                        clicked => {
                            InsightsState.begin-edit-activity(entry.id);
                        }
                        Text {
                            text: "Edit";
                            width: 100%;
                            height: 100%;
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.accent-cyan;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
