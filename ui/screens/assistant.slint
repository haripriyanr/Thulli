import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ThulliButton } from "../components/buttons.slint";
import { IconChat } from "../icons.slint";
import { ChatThreadModel, ChatMessageModel, MemoryModel, SuggestionModel } from "../types.slint";

/// State and callbacks for the assistant screen. The screen owner edits this
/// global freely; the shell re-exports it, so app.slint does not change.
export global AssistantState {
    in-out property <[ChatThreadModel]> threads: [];
    in-out property <[ChatMessageModel]> messages: [];
    in-out property <string> open-thread-id: "";
    /// True while a reply is being produced on a worker thread.
    in-out property <bool> busy: false;
    in-out property <[MemoryModel]> memories: [];
    in-out property <[SuggestionModel]> suggestions: [];
    in-out property <string> day-summary: "";
    /// False until the user has chosen a model file in preferences.
    in-out property <bool> model-ready: false;
    /// Plain-language reason shown in place of the input when the model is not ready.
    in-out property <string> model-notice: "";
    /// Short line under the messages: errors, or what a change did.
    in-out property <string> status-text: "";
    /// Plain-language lines for changes waiting for the user's Apply.
    in-out property <[string]> proposals: [];
    /// Earlier wordings of the memory whose history is open.
    in-out property <string> history-memory-id: "";
    in-out property <[string]> memory-history: [];
    /// Memory kinds, in the order the picker shows them.
    in-out property <[string]> memory-kind-ids: ["preference", "commitment", "person_or_project", "pattern"];
    in-out property <string> new-memory-kind: "preference";

    callback send(string);
    callback new-chat();
    callback open-thread(string);
    callback add-memory(string, string);        // kind, text
    callback edit-memory(string, string);       // id, text
    callback archive-memory(string);
    callback show-memory-history(string);       // id
    callback accept-suggestion(string);
    callback dismiss-suggestion(string);
    callback quick-action(string);              // "wind_down_reflection" or "quick_prioritize"
    callback apply-proposals();
    /// Fired each time the screen is shown, so the model notice is current.
    callback shown();
    callback discard-proposals();

    /// Label for a memory kind id.
    public pure function kind-label(id: string) -> string {
        if id == "preference" { return "Preference"; }
        if id == "commitment" { return "Commitment"; }
        if id == "person_or_project" { return "Person or project"; }
        if id == "pattern" { return "Pattern"; }
        return "Memory";
    }
}

component ChatBubble inherits Rectangle {
    in property <bool> from-user: false;
    in property <string> text;

    HorizontalLayout {
        padding-left: root.from-user ? 64px : 0px;
        padding-right: root.from-user ? 0px : 64px;

        Rectangle {
            background: root.from-user ? Theme.bg-card-selected : Theme.bg-card;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 10px;
                Text {
                    text: root.text;
                    color: Theme.text-primary;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

/// AssistantScreen: thread list, chat, suggestions and memory.
export component AssistantScreen inherits Rectangle {
    background: transparent;

    HorizontalLayout {
        spacing: 16px;
        padding: 16px;

        // ---- threads ------------------------------------------------
        Rectangle {
            width: 210px;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Chats";
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                }

                ThulliButton {
                    text: "New chat";
                    variant: "secondary";
                    width: 100%;
                    clicked => { AssistantState.new-chat(); }
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 4px;
                        for t in AssistantState.threads : TouchArea {
                            height: 40px;
                            clicked => { AssistantState.open-thread(t.id); }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: Theme.radius-sm;
                                background: t.id == AssistantState.open-thread-id
                                    ? Theme.bg-card-selected
                                    : (parent.has-hover ? Theme.bg-card-hover : transparent);

                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: t.title;
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: t.updated-label;
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- chat ---------------------------------------------------
        Rectangle {
            // Takes all leftover width; its contents never widen the window.
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: AssistantState.day-summary;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ThulliButton {
                        text: "Quick Prioritize";
                        variant: "secondary";
                        width: 150px;
                        height: 30px;
                        font-size: 11px;
                        clicked => { AssistantState.quick-action("quick_prioritize"); }
                    }
                    ThulliButton {
                        text: "Wind-down Reflection";
                        variant: "secondary";
                        width: 190px;
                        height: 30px;
                        font-size: 11px;
                        clicked => { AssistantState.quick-action("wind_down_reflection"); }
                    }
                }

                // Suggestions (never shown during focus; the service decides).
                for s in AssistantState.suggestions : Rectangle {
                    height: 56px;
                    background: Theme.bg-card;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: s.title;
                                color: Theme.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: s.body;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        ThulliButton {
                            text: "Use it";
                            variant: "secondary";
                            width: 72px;
                            height: 30px;
                            font-size: 11px;
                            clicked => { AssistantState.accept-suggestion(s.id); }
                        }
                        ThulliButton {
                            text: "Not now";
                            variant: "secondary";
                            width: 72px;
                            height: 30px;
                            font-size: 11px;
                            clicked => { AssistantState.dismiss-suggestion(s.id); }
                        }
                    }
                }

                // Changes waiting for the user's decision. Nothing is applied until Apply.
                if AssistantState.proposals.length > 0 : Rectangle {
                    background: Theme.bg-card-selected;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.accent-cyan;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text {
                            text: "The assistant suggests these changes:";
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        for line in AssistantState.proposals : Text {
                            text: "- " + line;
                            color: Theme.text-secondary;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            ThulliButton {
                                text: "Apply";
                                width: 90px;
                                height: 30px;
                                font-size: 11px;
                                clicked => { AssistantState.apply-proposals(); }
                            }
                            ThulliButton {
                                text: "Discard";
                                variant: "secondary";
                                width: 90px;
                                height: 30px;
                                font-size: 11px;
                                clicked => { AssistantState.discard-proposals(); }
                            }
                        }
                    }
                }

                // Messages
                if AssistantState.messages.length == 0 : VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        IconChat {
                            width: 40px;
                            height: 40px;
                        }
                    }
                    Text {
                        text: "Ask for a hand";
                        color: Theme.text-primary;
                        font-size: 18px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Describe what you need and the assistant will turn it into tasks and notes. It runs on your device.";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }

                if AssistantState.messages.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for m in AssistantState.messages : ChatBubble {
                            from-user: m.from-user;
                            text: m.text;
                        }
                    }
                }

                if AssistantState.busy : Text {
                    text: "Thinking...";
                    color: Theme.text-muted;
                    font-size: 12px;
                }

                if AssistantState.status-text != "" : Text {
                    text: AssistantState.status-text;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                // Input, or the reason it is unavailable.
                if AssistantState.model-ready : HorizontalLayout {
                    spacing: 8px;
                    input := LineEdit {
                        horizontal-stretch: 1;
                        height: 38px;
                        placeholder-text: "Ask for a hand...";
                        enabled: !AssistantState.busy;
                        accepted(value) => {
                            if (value != "" && !AssistantState.busy) {
                                AssistantState.send(value);
                                self.text = "";
                            }
                        }
                    }
                    ThulliButton {
                        text: "Send";
                        width: 84px;
                        height: 38px;
                        enabled: !AssistantState.busy;
                        clicked => {
                            if (input.text != "" && !AssistantState.busy) {
                                AssistantState.send(input.text);
                                input.text = "";
                            }
                        }
                    }
                }

                if !AssistantState.model-ready : Rectangle {
                    height: 56px;
                    background: Theme.bg-card;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    VerticalLayout {
                        padding: 10px;
                        Text {
                            text: AssistantState.model-notice;
                            color: Theme.text-secondary;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ---- memory -------------------------------------------------
        Rectangle {
            width: 290px;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Memory";
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {
                    text: "Things the assistant keeps in mind. Change or remove any of them.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 4px;
                    for kind-id in AssistantState.memory-kind-ids : TouchArea {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        height: 34px;
                        clicked => { AssistantState.new-memory-kind = kind-id; }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: Theme.radius-sm;
                            background: kind-id == AssistantState.new-memory-kind ? Theme.bg-card-selected : Theme.bg-card;
                            border-width: 1px;
                            border-color: kind-id == AssistantState.new-memory-kind ? Theme.accent-cyan : Theme.border-subtle;
                            Text {
                                text: AssistantState.kind-label(kind-id);
                                color: Theme.text-secondary;
                                font-size: 9px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    new-memory := LineEdit {
                        horizontal-stretch: 1;
                        height: 34px;
                        placeholder-text: "Add a memory...";
                        accepted(value) => {
                            AssistantState.add-memory(AssistantState.new-memory-kind, value);
                            self.text = "";
                        }
                    }
                    ThulliButton {
                        text: "Add";
                        width: 60px;
                        height: 34px;
                        clicked => {
                            AssistantState.add-memory(AssistantState.new-memory-kind, new-memory.text);
                            new-memory.text = "";
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for m in AssistantState.memories : Rectangle {
                            height: 92px;
                            background: Theme.bg-card;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Text {
                                    text: AssistantState.kind-label(m.kind) + "  |  " + m.updated-label;
                                    color: Theme.text-muted;
                                    font-size: 9px;
                                }
                                edit := LineEdit {
                                    text: m.text;
                                    font-size: 12px;
                                    accepted(value) => { AssistantState.edit-memory(m.id, value); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    ThulliButton {
                                        text: "History";
                                        variant: "secondary";
                                        width: 70px;
                                        height: 24px;
                                        font-size: 10px;
                                        clicked => { AssistantState.show-memory-history(m.id); }
                                    }
                                    ThulliButton {
                                        text: "Remove";
                                        variant: "danger";
                                        width: 70px;
                                        height: 24px;
                                        font-size: 10px;
                                        clicked => { AssistantState.archive-memory(m.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                if AssistantState.history-memory-id != "" : Rectangle {
                    background: Theme.bg-card-selected;
                    border-radius: Theme.radius-sm;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: "Earlier wording";
                            color: Theme.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                        }
                        for old in AssistantState.memory-history : Text {
                            text: old;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if AssistantState.memory-history.length == 0 : Text {
                            text: "No earlier wording.";
                            color: Theme.text-muted;
                            font-size: 11px;
                        }
                    }
                }
            }
        }
    }
}
