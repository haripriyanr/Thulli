import { Theme } from "../theme.slint";
import { IconRefresh, IconPlay, IconPause, IconSkip, IconChevronLeft, IconChevronRight, IconTimer, IconCoffee, IconPill, IconSettings, IconBolt, IconNote, IconClose, IconTasks, IconChart, IconCheck, IconClock, IconStar, IconMinus, IconTower, IconChat, IconExpand } from "../icons.slint";
import { ThulliRing } from "../components/ring.slint";
import { GlassCard, GlassIconButton } from "../components/glass.slint";
import { AppData } from "../app_data.slint";

/// A tab or pill with an icon in front of its label. Selected tabs take a
/// violet tint. The icon is the first child.
component IconTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 38px;
    border-radius: 19px;
    background: root.selected ? Theme.accent-violet.with-alpha(0.30) : (touch.has-hover ? Theme.glass-fill-hover : Theme.glass-fill);
    border-width: 1px;
    border-color: root.selected ? Theme.accent-violet.with-alpha(0.70) : Theme.glass-border;
    animate background, border-color { duration: 200ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        @children
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

/// The purple play and pause button with a soft glow.
component PlayButton inherits Rectangle {
    in property <bool> running: false;
    callback clicked();

    width: 84px;
    height: 84px;
    border-radius: 42px;
    background: @linear-gradient(135deg, #C4B5FD 0%, #7C3AED 100%);
    drop-shadow-blur: 28px;
    drop-shadow-color: #A78BFA99;
    drop-shadow-offset-y: 6px;

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            if !root.running: IconPlay { width: 26px; height: 26px; stroke-color: #FFFFFF; fill-color: #FFFFFF38; }
            if root.running: IconPause { width: 26px; height: 26px; stroke-color: #FFFFFF; fill-color: #FFFFFF38; }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

/// One ambient sound option, with its icon above its name.
component AmbientChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    horizontal-stretch: 1;
    height: 52px;
    border-radius: 14px;
    background: root.selected ? Theme.accent-violet.with-alpha(0.28) : (touch.has-hover ? Theme.glass-fill-hover : Theme.glass-fill);
    border-width: 1px;
    border-color: root.selected ? Theme.accent-violet.with-alpha(0.70) : Theme.glass-border;
    animate background, border-color { duration: 200ms; easing: ease-out; }

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        @children
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

/// The timer card: mode tabs, the ring with previous and next, the transport
/// controls, the session name and task row, the ambient chips and the footer.
/// The task picker opens over the lower part of the card.
component TimerCard inherits GlassCard {
    corner: 26px;
    callback view-all-tasks();

    property <bool> picker-open: false;
    property <color> accent: Theme.accent-violet;
    property <string> phase-label: AppData.pomodoro-phase == "focus"
        ? "Deep Focus"
        : (AppData.pomodoro-phase == "short_break" ? "Short Break" : "Long Break");

    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        alignment: center;

        // Mode tabs
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            IconTab { label: "Focus"; selected: AppData.pomodoro-mode == "focus"; clicked => { AppData.pomodoro-select("focus"); }
                IconTimer { width: 16px; height: 16px; stroke-color: AppData.pomodoro-mode == "focus" ? Theme.accent-violet : Theme.text-secondary; } }
            IconTab { label: "Short Break"; selected: AppData.pomodoro-mode == "short_break"; clicked => { AppData.pomodoro-select("short_break"); }
                IconCoffee { width: 16px; height: 16px; stroke-color: AppData.pomodoro-mode == "short_break" ? Theme.accent-violet : Theme.text-secondary; } }
            IconTab { label: "Long Break"; selected: AppData.pomodoro-mode == "long_break"; clicked => { AppData.pomodoro-select("long_break"); }
                IconPill { width: 16px; height: 16px; stroke-color: AppData.pomodoro-mode == "long_break" ? Theme.accent-violet : Theme.text-secondary; } }
            IconTab { label: "Custom"; selected: AppData.pomodoro-mode == "custom"; clicked => { AppData.pomodoro-select("custom"); }
                IconSettings { width: 16px; height: 16px; stroke-color: AppData.pomodoro-mode == "custom" ? Theme.accent-violet : Theme.text-secondary; } }
        }

        // Ring with previous and next phase
        HorizontalLayout {
            alignment: center;
            spacing: 18px;
            GlassIconButton {
                dia: 44px;
                clicked => { AppData.pomodoro-previous(); }
                IconChevronLeft { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
            }
            ThulliRing {
                width: 320px;
                height: 320px;
                thickness: 10px;
                progress: AppData.pomodoro-progress;
                ring-color: root.accent;
                track-color: Theme.glass-border;

                // Mountain artwork across the lower part of the ring.
                Rectangle {
                    x: 14px;
                    y: 14px;
                    width: parent.width - 28px;
                    height: parent.height - 28px;
                    border-radius: self.width / 2;
                    clip: true;
                    Image {
                        source: @image-url("../../assets/rail-mountain.png");
                        image-fit: cover;
                        width: parent.width;
                        height: parent.height * 0.55;
                        y: parent.height - self.height;
                        opacity: 0.6;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        IconBolt { width: 20px; height: 20px; stroke-color: root.accent; fill-color: root.accent.with-alpha(0.25); }
                    }
                    Text { text: root.phase-label; font-size: 14px; color: Theme.text-secondary; horizontal-alignment: center; }
                    Text { text: AppData.pomodoro-time; font-size: 64px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; }
                    Text { text: AppData.pomodoro-round; font-size: 13px; color: Theme.text-secondary; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        for i in [0, 1, 2, 3]: Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: i == AppData.pomodoro-rounds-done ? root.accent : (i < AppData.pomodoro-rounds-done ? root.accent.with-alpha(0.55) : Theme.glass-border);
                        }
                    }
                }
            }
            GlassIconButton {
                dia: 44px;
                clicked => { AppData.pomodoro-next(); }
                IconChevronRight { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
            }
        }

        // Transport controls
        HorizontalLayout {
            alignment: center;
            spacing: 22px;
            GlassIconButton {
                dia: 52px;
                clicked => { AppData.pomodoro-reset(); }
                IconRefresh { width: 18px; height: 18px; stroke-color: Theme.text-secondary; }
            }
            PlayButton {
                running: AppData.pomodoro-running;
                clicked => { AppData.pomodoro-toggle(); }
            }
            GlassIconButton {
                dia: 52px;
                clicked => { AppData.pomodoro-next(); }
                IconSkip { width: 18px; height: 18px; stroke-color: Theme.text-secondary; }
            }
        }

        // Session name and task
        HorizontalLayout {
            spacing: 12px;
            GlassCard {
                horizontal-stretch: 3;
                height: 62px;
                corner: 16px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 12px;
                    IconNote { width: 18px; height: 18px; stroke-color: Theme.accent-violet; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "Session name"; font-size: 11px; color: Theme.text-muted; }
                        Rectangle {
                            height: 22px;
                            // Shown only while the field is empty. It is a label, not text.
                            Text {
                                width: 100%;
                                height: 100%;
                                text: "General Focus";
                                visible: AppData.session-name == "";
                                font-size: 15px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            TextInput {
                                width: 100%;
                                height: 100%;
                                vertical-alignment: center;
                                font-size: 15px;
                                color: Theme.text-primary;
                                text <=> AppData.session-name;
                                edited => { AppData.session-name-edited(AppData.session-name); }
                            }
                        }
                    }
                    if AppData.session-name != "": GlassIconButton {
                        dia: 26px;
                        clicked => {
                            AppData.session-name = "";
                            AppData.session-name-edited("");
                        }
                        IconClose { width: 10px; height: 10px; stroke-color: Theme.text-secondary; }
                    }
                }
            }
            GlassCard {
                horizontal-stretch: 2;
                height: 62px;
                corner: 16px;
                task-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.picker-open = !root.picker-open; }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;
                    IconTasks { width: 18px; height: 18px; stroke-color: Theme.accent-violet; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "Task"; font-size: 11px; color: Theme.text-muted; }
                        Text {
                            text: AppData.session-task-title == "" ? "None" : AppData.session-task-title;
                            font-size: 15px;
                            color: AppData.session-task-title == "" ? Theme.text-muted : Theme.text-primary;
                            overflow: elide;
                        }
                    }
                    IconChevronRight { width: 14px; height: 14px; stroke-color: Theme.text-muted; }
                }
            }
        }

        // Ambient sound
        GlassCard {
            height: 80px;
            corner: 16px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    width: 110px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        IconChat { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
                        Text { text: "Ambient Sound"; font-size: 13px; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                }
                AmbientChip { label: "None"; selected: AppData.ambient-choice == "off"; clicked => { AppData.ambient-selected("off"); }
                    IconMinus { width: 16px; height: 16px; stroke-color: AppData.ambient-choice == "off" ? Theme.accent-violet : Theme.text-secondary; } }
                AmbientChip { label: "Lo-fi"; selected: AppData.ambient-choice == "lofi"; clicked => { AppData.ambient-selected("lofi"); }
                    IconStar { width: 16px; height: 16px; stroke-color: AppData.ambient-choice == "lofi" ? Theme.accent-violet : Theme.text-secondary; } }
                AmbientChip { label: "Forest"; selected: AppData.ambient-choice == "forest"; clicked => { AppData.ambient-selected("forest"); }
                    IconTower { width: 16px; height: 16px; stroke-color: AppData.ambient-choice == "forest" ? Theme.accent-violet : Theme.text-secondary; } }
                AmbientChip { label: "Rain"; selected: AppData.ambient-choice == "rain"; clicked => { AppData.ambient-selected("rain"); }
                    IconClock { width: 16px; height: 16px; stroke-color: AppData.ambient-choice == "rain" ? Theme.accent-violet : Theme.text-secondary; } }
            }
        }

        // Footer: durations and full screen
        HorizontalLayout {
            alignment: space-between;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                IconTimer { width: 14px; height: 14px; stroke-color: Theme.text-muted; }
                Text { text: AppData.pomodoro-durations; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
            }
            IconTab { label: "Full Screen (F11)"; clicked => { AppData.immersive = true; }
                IconExpand { width: 14px; height: 14px; stroke-color: Theme.text-secondary; } }
        }
    }

    // Task picker: opens over the lower part of the card.
    if root.picker-open: Rectangle {
        x: 22px;
        width: root.width - 44px;
        height: min(root.height - 240px, 340px);
        y: root.height - self.height - 110px;
        border-radius: 18px;
        background: Theme.bg-panel;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.glass-shadow;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            // Search
            Rectangle {
                height: 40px;
                border-radius: 12px;
                background: Theme.glass-fill-strong;
                border-width: 1px;
                border-color: Theme.glass-border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    IconTasks { width: 14px; height: 14px; stroke-color: Theme.text-muted; }
                    Rectangle {
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "Search tasks";
                            visible: AppData.task-search == "";
                            font-size: 14px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        TextInput {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            font-size: 14px;
                            color: Theme.text-primary;
                            text <=> AppData.task-search;
                            edited => { AppData.task-search-changed(AppData.task-search); }
                        }
                    }
                }
            }

            // Rows, grouped by due date
            Flickable {
                vertical-stretch: 1;
                content-height: max(rows-column.preferred-height, parent.height);
                rows-column := VerticalLayout {
                    width: parent.width;
                    spacing: 2px;
                    for option in AppData.task-options: VerticalLayout {
                        spacing: 2px;
                        if option.header != "": Text {
                            text: option.header;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text-muted;
                            horizontal-alignment: left;
                        }
                        Rectangle {
                            height: 44px;
                            border-radius: 10px;
                            background: option.id == AppData.session-task-id && option.id != "" ? Theme.accent-violet.with-alpha(0.22)
                                : (row-touch.has-hover ? Theme.glass-fill-hover : transparent);
                            animate background { duration: 200ms; easing: ease-out; }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    y: (parent.height - self.height) / 2;
                                    background: option.priority == "high" ? Theme.destructive
                                        : (option.priority == "medium" ? Theme.accent-amber
                                        : (option.priority == "low" ? Theme.accent-green : transparent));
                                }
                                Text {
                                    text: option.title;
                                    font-size: 14px;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: option.meta;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                            row-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    AppData.task-picked(option.id);
                                    root.picker-open = false;
                                }
                            }
                        }
                    }
                }
            }

            // View all tasks
            Rectangle {
                height: 40px;
                border-radius: 12px;
                background: all-touch.has-hover ? Theme.glass-fill-hover : Theme.glass-fill;
                animate background { duration: 200ms; easing: ease-out; }
                Text {
                    width: 100%;
                    height: 100%;
                    text: "View all tasks";
                    font-size: 13px;
                    color: Theme.accent-violet;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                all-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.picker-open = false;
                        root.view-all-tasks();
                    }
                }
            }
        }
    }
}

/// One figure in the analytics panel, with its change since the last period.
component StatCard inherits GlassCard {
    in property <string> title;
    in property <string> value;
    in property <string> change;
    corner: 16px;
    height: 96px;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        alignment: center;
        Text { text: root.title; font-size: 12px; color: Theme.text-secondary; }
        Text { text: root.value; font-size: 22px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
        if root.change != "": Text {
            text: root.change;
            font-size: 11px;
            color: root.change.starts-with("-") ? Theme.destructive : Theme.accent-green;
        }
    }
}

/// The productivity panel: figures, the activity chart with its axis, and the
/// summary of the chosen period.
component AnalyticsCard inherits GlassCard {
    corner: 26px;

    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        alignment: start;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: Theme.accent-violet.with-alpha(0.22);
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        IconChart { width: 22px; height: 22px; stroke-color: Theme.accent-violet; }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: "Productivity"; font-size: 18px; font-weight: 700; color: Theme.text-primary; }
                Text { text: "Your focus at a glance"; font-size: 12px; color: Theme.text-muted; }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: end;
                IconTab { label: "Day"; selected: AppData.activity-range == "day"; clicked => { AppData.activity-range-selected("day"); } }
                IconTab { label: "Week"; selected: AppData.activity-range == "week"; clicked => { AppData.activity-range-selected("week"); } }
                IconTab { label: "Month"; selected: AppData.activity-range == "month"; clicked => { AppData.activity-range-selected("month"); } }
                IconTab { label: "Year"; selected: AppData.activity-range == "year"; clicked => { AppData.activity-range-selected("year"); } }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            StatCard { title: "Sessions"; value: AppData.activity-sessions; change: AppData.activity-sessions-change; }
            StatCard { title: "Focus time"; value: AppData.activity-focus; change: AppData.activity-focus-change; }
            StatCard { title: "Streak"; value: AppData.activity-streak; change: ""; }
        }

        // Chart: axis labels on the left, gridlines behind the bars.
        HorizontalLayout {
            height: 220px;
            spacing: 8px;
            VerticalLayout {
                width: 22px;
                alignment: space-between;
                Text { text: "\{AppData.activity-axis-max}"; font-size: 11px; color: Theme.text-muted; horizontal-alignment: right; }
                Text { text: "\{AppData.activity-axis-max * 3 / 4}"; font-size: 11px; color: Theme.text-muted; horizontal-alignment: right; }
                Text { text: "\{AppData.activity-axis-max / 2}"; font-size: 11px; color: Theme.text-muted; horizontal-alignment: right; }
                Text { text: "\{AppData.activity-axis-max / 4}"; font-size: 11px; color: Theme.text-muted; horizontal-alignment: right; }
                Text { text: "0"; font-size: 11px; color: Theme.text-muted; horizontal-alignment: right; }
            }
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: space-between;
                    Rectangle { height: 1px; background: Theme.glass-border; }
                    Rectangle { height: 1px; background: Theme.glass-border; }
                    Rectangle { height: 1px; background: Theme.glass-border; }
                    Rectangle { height: 1px; background: Theme.glass-border; }
                    Rectangle { height: 1px; background: Theme.glass-border; }
                }
                HorizontalLayout {
                    alignment: space-between;
                    spacing: 4px;
                    padding-bottom: 20px;
                    for bar in AppData.activity-bars: VerticalLayout {
                        alignment: end;
                        spacing: 6px;
                        Rectangle {
                            height: max(4px, 180px * bar.value);
                            width: 100%;
                            border-radius: 6px;
                            background: @linear-gradient(180deg, #C4B5FD 0%, #7C3AED 100%);
                        }
                        Text { text: bar.label; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                    }
                }
            }
        }

        // Summary of the chosen period
        GlassCard {
            corner: 16px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    IconStar { width: 16px; height: 16px; stroke-color: Theme.accent-violet; }
                    Text { text: "Summary"; font-size: 14px; font-weight: 600; color: Theme.text-primary; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    IconCheck { width: 14px; height: 14px; stroke-color: Theme.accent-green; }
                    Text { text: "\{AppData.activity-sessions} sessions completed"; font-size: 13px; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    IconClock { width: 14px; height: 14px; stroke-color: Theme.text-secondary; }
                    Text { text: "Average focus: \{AppData.activity-average}"; font-size: 13px; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    IconChart { width: 14px; height: 14px; stroke-color: Theme.text-secondary; }
                    Text {
                        text: AppData.activity-best == "" ? "Most active: none yet" : "Most active: \{AppData.activity-best}";
                        font-size: 13px;
                        color: Theme.text-secondary;
                    }
                }
            }
        }
    }
}

/// PomodoroScreen: the timer with its analytics beside it. On narrow windows
/// they stack. In full screen only the timer is shown and zooms to the centre.
export component PomodoroScreen inherits Rectangle {
    clip: true;
    background: transparent;
    callback view-all-tasks();

    property <bool> wide: root.width >= 900px;
    property <length> side: 24px;
    property <length> gap: 18px;

    property <length> timer-width: AppData.immersive
        ? min(root.width - 2 * root.side, 620px)
        : (root.wide ? (root.width - 2 * root.side - root.gap) * 0.6 : root.width - 2 * root.side);
    property <length> timer-height: AppData.immersive
        ? min(root.height - 2 * root.side, 760px)
        : (root.wide ? root.height : min(root.height, max(640px, root.height * 0.6)));

    property <length> analytics-x: root.wide ? root.side + root.timer-width + root.gap : root.side;
    property <length> analytics-y: root.wide ? 0px : root.timer-height + root.gap;
    property <length> analytics-width: root.wide ? root.width - root.analytics-x - root.side : root.width - 2 * root.side;
    property <length> analytics-height: root.height - root.analytics-y;

    timer := TimerCard {
        view-all-tasks => { root.view-all-tasks(); }
        x: AppData.immersive ? (root.width - self.width) / 2 : root.side;
        y: AppData.immersive ? (root.height - self.height) / 2 : 0px;
        width: root.timer-width;
        height: root.timer-height;
        animate x, y, width, height { duration: 800ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }

    analytics-wrap := Rectangle {
        x: root.analytics-x;
        y: root.analytics-y;
        width: root.analytics-width;
        height: root.analytics-height;
        opacity: AppData.immersive ? 0 : 1;
        animate opacity { duration: 250ms; easing: ease-out; }

        Flickable {
            width: 100%;
            height: 100%;
            content-height: max(860px, parent.height);

            AnalyticsCard {
                width: parent.width;
                height: max(860px, parent.height);
            }
        }
    }

    if AppData.immersive: IconTab {
        x: parent.width - self.width - 24px;
        y: 18px;
        label: "Exit full screen (Esc)";
        clicked => { AppData.immersive = false; }
        IconClose { width: 12px; height: 12px; stroke-color: Theme.text-secondary; }
    }
}
