import { Theme } from "../theme.slint";
import { IconRefresh, IconPlay, IconPause, IconSkip, IconChevronLeft, IconChevronRight, IconTimer } from "../icons.slint";
import { ThulliRing } from "../components/ring.slint";
import { GlassCard, GlassPill, GlassIconButton } from "../components/glass.slint";
import { AppData } from "../app_data.slint";

/// The timer card: mode tabs, the countdown ring with previous and next,
/// the custom length, the session name and the transport controls. Everything
/// shown comes from AppData; the buttons only report taps.
component TimerCard inherits GlassCard {
    corner: 26px;

    property <color> accent: AppData.pomodoro-phase == "focus"
        ? Theme.accent-amber
        : (AppData.pomodoro-phase == "short_break" ? Theme.accent-cyan : Theme.accent-violet);
    property <color> status-color: AppData.pomodoro-status == "Running"
        ? self.accent
        : (AppData.pomodoro-status == "Completed" ? Theme.accent-green : Theme.text-secondary);

    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        alignment: center;

        // Mode tabs
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            GlassPill { width: 92px; label: "Focus"; selected: AppData.pomodoro-mode == "focus"; accent: Theme.accent-amber; clicked => { AppData.pomodoro-select("focus"); } }
            GlassPill { width: 116px; label: "Short break"; selected: AppData.pomodoro-mode == "short_break"; accent: Theme.accent-cyan; clicked => { AppData.pomodoro-select("short_break"); } }
            GlassPill { width: 116px; label: "Long break"; selected: AppData.pomodoro-mode == "long_break"; accent: Theme.accent-violet; clicked => { AppData.pomodoro-select("long_break"); } }
            GlassPill { width: 96px; label: "Custom"; selected: AppData.pomodoro-mode == "custom"; accent: Theme.accent-amber; clicked => { AppData.pomodoro-select("custom"); } }
        }

        // Countdown with previous and next interval
        HorizontalLayout {
            alignment: center;
            spacing: 18px;
            GlassIconButton {
                dia: 44px;
                clicked => { AppData.pomodoro-previous(); }
                IconChevronLeft { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
            }
            ThulliRing {
                width: AppData.immersive ? 360px : 300px;
                height: AppData.immersive ? 360px : 300px;
                thickness: 12px;
                animate width, height { duration: 800ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                progress: AppData.pomodoro-progress;
                ring-color: root.accent;
                track-color: Theme.glass-border;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 7px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.status-color; }
                        }
                        Text { text: AppData.pomodoro-status; font-size: 13px; color: root.status-color; }
                    }
                    Text {
                        text: AppData.pomodoro-time;
                        font-size: AppData.immersive ? 84px : 64px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        animate font-size { duration: 800ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    }
                    Text { text: AppData.pomodoro-round; font-size: 13px; color: root.accent; horizontal-alignment: center; }
                }
            }
            GlassIconButton {
                dia: 44px;
                clicked => { AppData.pomodoro-next(); }
                IconChevronRight { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
            }
        }

        // Custom length stepper, shown in Custom mode
        if AppData.pomodoro-mode == "custom": HorizontalLayout {
            alignment: center;
            spacing: 12px;
            Text { text: "Custom length"; font-size: 13px; color: Theme.text-secondary; vertical-alignment: center; }
            GlassIconButton {
                dia: 32px;
                clicked => { AppData.adjust-setting("pomodoro_custom_mins", -1); }
                Text { text: "−"; font-size: 16px; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: "\{AppData.pomodoro-custom-mins} min"; font-size: 14px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
            GlassIconButton {
                dia: 32px;
                clicked => { AppData.adjust-setting("pomodoro_custom_mins", 1); }
                Text { text: "+"; font-size: 16px; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        // Transport controls
        HorizontalLayout {
            alignment: center;
            spacing: 18px;
            GlassIconButton {
                dia: 52px;
                clicked => { AppData.pomodoro-reset(); }
                IconRefresh { width: 18px; height: 18px; stroke-color: Theme.text-secondary; }
            }
            GlassIconButton {
                dia: 76px;
                fill: root.accent.with-alpha(0.22);
                clicked => { AppData.pomodoro-toggle(); }
                if !AppData.pomodoro-running: IconPlay { width: 26px; height: 26px; stroke-color: root.accent; fill-color: root.accent.with-alpha(0.25); }
                if AppData.pomodoro-running: IconPause { width: 26px; height: 26px; stroke-color: root.accent; fill-color: root.accent.with-alpha(0.25); }
            }
            GlassIconButton {
                dia: 52px;
                clicked => { AppData.pomodoro-next(); }
                IconSkip { width: 18px; height: 18px; stroke-color: Theme.text-secondary; }
            }
        }

        // Session name
        GlassCard {
            height: 50px;
            corner: 16px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Text { text: "Session name"; font-size: 13px; color: Theme.text-secondary; vertical-alignment: center; }
                Rectangle {
                    horizontal-stretch: 1;
                    // Shown only while the field is empty. It is a label, not text.
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "Focus";
                        visible: AppData.session-name == "";
                        font-size: 14px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    TextInput {
                        width: 100%;
                        height: 100%;
                        vertical-alignment: center;
                        font-size: 14px;
                        color: Theme.text-primary;
                        text <=> AppData.session-name;
                        edited => { AppData.session-name-edited(AppData.session-name); }
                    }
                }
            }
        }

        // Ambient sound: plays while the timer runs
        HorizontalLayout {
            spacing: 8px;
            GlassPill { horizontal-stretch: 1; label: "No sound"; selected: AppData.ambient-choice == "off"; accent: Theme.accent-amber; clicked => { AppData.ambient-selected("off"); } }
            GlassPill { horizontal-stretch: 1; label: "Lo-fi"; selected: AppData.ambient-choice == "lofi"; accent: Theme.accent-violet; clicked => { AppData.ambient-selected("lofi"); } }
            GlassPill { horizontal-stretch: 1; label: "Forest"; selected: AppData.ambient-choice == "forest"; accent: Theme.accent-green; clicked => { AppData.ambient-selected("forest"); } }
            GlassPill { horizontal-stretch: 1; label: "Rain"; selected: AppData.ambient-choice == "rain"; accent: Theme.accent-cyan; clicked => { AppData.ambient-selected("rain"); } }
        }

        // Durations and full screen
        HorizontalLayout {
            alignment: space-between;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                IconTimer { width: 14px; height: 14px; stroke-color: Theme.text-muted; }
                Text { text: AppData.pomodoro-durations; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
            }
            GlassPill {
                width: 142px;
                label: "Full screen (F11)";
                clicked => { AppData.immersive = true; }
            }
        }
    }
}

/// One figure in the analytics panel.
component StatTile inherits GlassCard {
    in property <string> title;
    in property <string> value;
    corner: 16px;
    height: 74px;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        alignment: center;
        Text { text: root.title; font-size: 11px; color: Theme.text-secondary; }
        Text { text: root.value; font-size: 19px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
    }
}

/// Focus activity for the chosen range, with the figures that matter most.
component AnalyticsCard inherits GlassCard {
    corner: 26px;

    VerticalLayout {
        padding: 22px;
        spacing: 14px;
        alignment: start;

        HorizontalLayout {
            alignment: space-between;
            Text { text: "Productivity"; font-size: 16px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 4px;
                GlassPill { width: 50px; label: "Day"; selected: AppData.activity-range == "day"; accent: Theme.accent-amber; clicked => { AppData.activity-range-selected("day"); } }
                GlassPill { width: 56px; label: "Week"; selected: AppData.activity-range == "week"; accent: Theme.accent-amber; clicked => { AppData.activity-range-selected("week"); } }
                GlassPill { width: 62px; label: "Month"; selected: AppData.activity-range == "month"; accent: Theme.accent-amber; clicked => { AppData.activity-range-selected("month"); } }
                GlassPill { width: 56px; label: "Year"; selected: AppData.activity-range == "year"; accent: Theme.accent-amber; clicked => { AppData.activity-range-selected("year"); } }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            StatTile { title: "Sessions"; value: AppData.activity-sessions; }
            StatTile { title: "Focus time"; value: AppData.activity-focus; }
            StatTile { title: "Streak"; value: AppData.activity-streak; }
        }

        HorizontalLayout {
            height: 200px;
            spacing: 6px;
            alignment: space-between;
            for bar in AppData.activity-bars: VerticalLayout {
                alignment: end;
                spacing: 4px;
                Text { text: bar.value-label; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                Rectangle {
                    height: 128px * bar.value + 4px;
                    width: 100%;
                    border-radius: 6px;
                    background: @linear-gradient(180deg, Theme.accent-violet 0%, Theme.accent-violet-soft 100%);
                }
                Text { text: bar.label; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
            }
        }

        Text { text: AppData.activity-insight; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
    }
}

/// PomodoroScreen: the timer with its analytics beside it. The timer card is
/// one element, so it zooms between the normal and full screen layouts
/// instead of being swapped for another card. Timing matches SomniStudy's
/// intro entry: 800ms with easeOutBack. The analytics fade over 250ms.
export component PomodoroScreen inherits Rectangle {
    clip: true;
    background: transparent;

    property <bool> wide: root.width >= 900px;
    property <length> side: 24px;
    property <length> gap: 18px;

    property <length> timer-width: AppData.immersive
        ? min(root.width - 2 * root.side, 620px)
        : (root.wide ? (root.width - 2 * root.side - root.gap) * 0.6 : root.width - 2 * root.side);
    property <length> timer-height: AppData.immersive
        ? min(root.height - 2 * root.side, 760px)
        : (root.wide ? root.height : min(root.height, max(560px, root.height * 0.6)));

    property <length> analytics-x: root.wide ? root.side + root.timer-width + root.gap : root.side;
    property <length> analytics-y: root.wide ? 0px : root.timer-height + root.gap;
    property <length> analytics-width: root.wide ? root.width - root.analytics-x - root.side : root.width - 2 * root.side;
    property <length> analytics-height: root.height - root.analytics-y;

    timer := TimerCard {
        x: AppData.immersive ? (root.width - self.width) / 2 : root.side;
        y: AppData.immersive ? (root.height - self.height) / 2 : 0px;
        width: root.timer-width;
        height: root.timer-height;
        animate x, y, width, height { duration: 800ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }

    analytics-wrap := Rectangle {
        x: root.analytics-x;
        y: root.analytics-y;
        width: root.analytics-width;
        height: root.analytics-height;
        opacity: AppData.immersive ? 0 : 1;
        animate opacity { duration: 250ms; easing: ease-out; }

        Flickable {
            width: 100%;
            height: 100%;
            content-height: max(560px, parent.height);

            AnalyticsCard {
                width: parent.width;
                height: max(560px, parent.height);
            }
        }
    }

    if AppData.immersive: GlassPill {
        width: 170px;
        x: parent.width - self.width - 24px;
        y: 18px;
        label: "Exit full screen (Esc)";
        clicked => { AppData.immersive = false; }
    }
}
