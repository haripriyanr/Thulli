import { Theme } from "../theme.slint";
import { IconRefresh, IconPlay, IconPause, IconSkip, IconChevronLeft, IconChevronRight, IconTimer, IconCoffee, IconPill, IconSettings, IconBolt, IconNote, IconClose, IconTasks, IconChart, IconCheck, IconClock, IconStar, IconMinus, IconTower, IconChat, IconExpand, IconHeadphones, IconWave, IconTree, IconCloudRain, IconSoundOff, IconDiamond } from "../icons.slint";
import { ThulliRing } from "../components/ring.slint";
import { GlassCard, GlassIconButton } from "../components/glass.slint";
import { IconTab, PlayButton, SceneTile, FieldCard, SearchField, StatCard } from "../components/focus_controls.slint";
import { AppData } from "../app_data.slint";

/// The timer card: mode tabs, the ring with previous and next, the transport
/// controls, the session name and task row, the ambient chips and the footer.
/// The task picker opens over the lower part of the card.
component TimerCard inherits GlassCard {
    corner: 26px;
    callback view-all-tasks();
    // Full screen shows the bare ring on the background, with no card.
    background: AppData.immersive ? transparent
        : @linear-gradient(170deg, Theme.glass-highlight 0%, Theme.glass-fill-strong 35%, Theme.glass-fill 100%);
    border-color: AppData.immersive ? transparent : Theme.glass-border;

    property <bool> picker-open: false;
    property <color> accent: Theme.accent-violet;
    property <string> phase-label: AppData.pomodoro-phase == "focus"
        ? "Deep Focus"
        : (AppData.pomodoro-phase == "short_break" ? "Short Break" : "Long Break");

    VerticalLayout {
        padding: 22px;
        padding-bottom: 28px;
        spacing: 16px;
        alignment: center;

        // Mode tabs. Full screen shows only the ring and the full screen toggle.
        if !AppData.immersive: HorizontalLayout {
            alignment: center;
            spacing: 8px;
            IconTab { label: @tr("Focus"); selected: AppData.pomodoro-mode == "focus"; clicked => { AppData.pomodoro-select("focus"); }
                IconTimer { width: 16px; height: 16px; stroke-color: AppData.pomodoro-mode == "focus" ? Theme.accent-violet : Theme.text-secondary; } }
            IconTab { label: @tr("Short Break"); selected: AppData.pomodoro-mode == "short_break"; clicked => { AppData.pomodoro-select("short_break"); }
                IconCoffee { width: 16px; height: 16px; stroke-color: AppData.pomodoro-mode == "short_break" ? Theme.accent-violet : Theme.text-secondary; } }
            IconTab { label: @tr("Long Break"); selected: AppData.pomodoro-mode == "long_break"; clicked => { AppData.pomodoro-select("long_break"); }
                IconPill { width: 16px; height: 16px; stroke-color: AppData.pomodoro-mode == "long_break" ? Theme.accent-violet : Theme.text-secondary; } }
            IconTab { label: @tr("Custom"); selected: AppData.pomodoro-mode == "custom"; clicked => { AppData.pomodoro-select("custom"); }
                IconSettings { width: 16px; height: 16px; stroke-color: AppData.pomodoro-mode == "custom" ? Theme.accent-violet : Theme.text-secondary; } }
        }

        // Ring with previous and next phase
        HorizontalLayout {
            alignment: center;
            spacing: 18px;
            if !AppData.immersive: VerticalLayout {
                alignment: center;
                GlassIconButton {
                    dia: 44px;
                    clicked => { AppData.pomodoro-previous(); }
                    IconChevronLeft { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
                }
            }
            ThulliRing {
                width: AppData.immersive ? max(320px, min(root.width, root.height) - 120px) : 320px;
                height: self.width;
                // Grows into full screen smoothly, without overshoot.
                animate width { duration: 700ms; easing: ease-in-out; }
                thickness: 10px;
                // Elapsed share of the phase. The timer ticks once a second,
                // so the arc glides between ticks instead of stepping.
                progress: AppData.pomodoro-progress;
                animate progress { duration: 1000ms; easing: linear; }
                ring-color: root.accent;
                // The gradient turns slowly with the background motion.
                ring-brush: @linear-gradient(AppData.background-phase * 360deg, #C4B5FD 0%, #8B5CF6 50%, #EC4899 100%);
                track-color: Theme.glass-border;

                // Mountain artwork across the lower part of the ring.
                Rectangle {
                    x: 14px;
                    y: 14px;
                    width: parent.width - 28px;
                    height: parent.height - 28px;
                    border-radius: self.width / 2;
                    clip: true;
                    Image {
                        source: @image-url("../../assets/rail-mountain.png");
                        image-fit: cover;
                        width: parent.width;
                        height: parent.height * 0.55;
                        y: parent.height - self.height;
                        opacity: 0.6;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        IconWave { width: 22px; height: 22px; stroke-color: root.accent; }
                    }
                    Text { text: root.phase-label; font-size: 14px; color: Theme.text-secondary; horizontal-alignment: center; }
                    // While the timer runs the digits breathe: a slow 4 s swell
                    // in size and brightness. Paused, they rest.
                    Text {
                        property <float> breath: AppData.pomodoro-running ? (1 - Math.cos(animation-tick() / 4s * 360deg)) / 2 : 0;
                        text: AppData.pomodoro-time;
                        font-size: AppData.immersive ? 96px : 64px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        transform-scale: 1 + 0.035 * self.breath;
                        opacity: 0.82 + 0.18 * self.breath;
                        animate font-size { duration: 700ms; easing: ease-in-out; }
                    }
                    Text { text: AppData.pomodoro-round; font-size: 13px; color: Theme.text-secondary; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        for i in [0, 1, 2, 3]: Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: i == AppData.pomodoro-rounds-done ? root.accent : (i < AppData.pomodoro-rounds-done ? root.accent.with-alpha(0.55) : Theme.glass-border);
                        }
                    }
                    // Full screen controls: they open out and fade in while
                    // the ring grows, and fold away when it shrinks back.
                    Rectangle {
                        height: AppData.immersive ? 62px : 0px;
                        clip: true;
                        opacity: AppData.immersive ? 1 : 0;
                        visible: self.opacity > 0.01;
                        animate height { duration: 500ms; easing: ease-out; }
                        animate opacity { duration: 400ms; delay: AppData.immersive ? 300ms : 0ms; easing: ease-out; }
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 18px;
                        spacing: 12px;
                        height: 62px;
                        GlassIconButton {
                            dia: 44px;
                            clicked => { AppData.pomodoro-toggle(); }
                            if !AppData.pomodoro-running: IconPlay { width: 18px; height: 18px; stroke-color: Theme.text-primary; fill-color: Theme.text-primary; }
                            if AppData.pomodoro-running: IconPause { width: 18px; height: 18px; stroke-color: Theme.text-primary; fill-color: Theme.text-primary; }
                        }
                        GlassIconButton {
                            dia: 44px;
                            clicked => { AppData.immersive = false; }
                            IconExpand { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
                        }
                    }
                    }
                }
            }
            if !AppData.immersive: VerticalLayout {
                alignment: center;
                GlassIconButton {
                    dia: 44px;
                    clicked => { AppData.pomodoro-next(); }
                    IconChevronRight { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
                }
            }
        }

        // Transport controls, with full screen at the right edge above the task card
        if !AppData.immersive: Rectangle {
            height: 96px;
            HorizontalLayout {
                alignment: center;
                spacing: 22px;
                VerticalLayout {
                    alignment: center;
                    GlassIconButton {
                        dia: 52px;
                        clicked => { AppData.pomodoro-reset(); }
                        IconRefresh { width: 18px; height: 18px; stroke-color: Theme.text-secondary; }
                    }
                }
                PlayButton {
                    running: AppData.pomodoro-running;
                    clicked => { AppData.pomodoro-toggle(); }
                }
                VerticalLayout {
                    alignment: center;
                    GlassIconButton {
                        dia: 52px;
                        clicked => { AppData.pomodoro-next(); }
                        IconSkip { width: 18px; height: 18px; stroke-color: Theme.text-secondary; }
                    }
                }
            }
            GlassIconButton {
                dia: 44px;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                clicked => { AppData.immersive = !AppData.immersive; }
                IconExpand { width: 16px; height: 16px; stroke-color: Theme.text-secondary; }
            }
        }

        // Session name and task
        if !AppData.immersive: HorizontalLayout {
            spacing: 12px;
            FieldCard {
                horizontal-stretch: 3;
                label: @tr("Session name");
                placeholder: @tr("General Focus");
                editable: true;
                trailing: "clear";
                text <=> AppData.session-name;
                edited(name) => { AppData.session-name-edited(name); }
                cleared => {
                    AppData.session-name = "";
                    AppData.session-name-edited("");
                }
                IconDiamond { width: 20px; height: 20px; stroke-color: Theme.text-primary; }
            }
            FieldCard {
                horizontal-stretch: 2;
                label: @tr("Task");
                placeholder: @tr("None");
                text: AppData.session-task-title;
                trailing: "chevron";
                open: root.picker-open;
                clicked => { root.picker-open = !root.picker-open; }
                IconNote { width: 20px; height: 20px; stroke-color: Theme.text-primary; }
            }
        }

        // Ambient sound
        if !AppData.immersive: GlassCard {
            height: 88px;
            corner: 18px;
            HorizontalLayout {
                padding: 12px;
                padding-left: 18px;
                spacing: 10px;
                HorizontalLayout {
                    width: 140px;
                    spacing: 10px;
                    VerticalLayout { alignment: center; IconHeadphones { width: 20px; height: 20px; stroke-color: Theme.text-primary; } }
                    Text { text: @tr("Ambient Sound"); font-size: 14px; color: Theme.text-primary; vertical-alignment: center; }
                }
                SceneTile { label: @tr("None"); scene: @image-url("../../assets/scenes/none.svg"); selected: AppData.ambient-choice == "off"; clicked => { AppData.ambient-selected("off"); }
                    IconSoundOff { width: 18px; height: 18px; stroke-color: AppData.ambient-choice == "off" ? #FFFFFF : Theme.text-secondary; } }
                SceneTile { label: @tr("Lo-fi"); scene: @image-url("../../assets/scenes/lofi.svg"); selected: AppData.ambient-choice == "lofi"; clicked => { AppData.ambient-selected("lofi"); }
                    IconWave { width: 18px; height: 18px; stroke-color: AppData.ambient-choice == "lofi" ? #FFFFFF : Theme.text-secondary; } }
                SceneTile { label: @tr("Forest"); scene: @image-url("../../assets/scenes/forest.svg"); selected: AppData.ambient-choice == "forest"; clicked => { AppData.ambient-selected("forest"); }
                    IconTree { width: 18px; height: 18px; stroke-color: AppData.ambient-choice == "forest" ? #86EFAC : Theme.text-secondary; fill-color: AppData.ambient-choice == "forest" ? #86EFAC40 : transparent; } }
                SceneTile { label: @tr("Rain"); scene: @image-url("../../assets/scenes/rain.svg"); selected: AppData.ambient-choice == "rain"; clicked => { AppData.ambient-selected("rain"); }
                    IconCloudRain { width: 18px; height: 18px; stroke-color: AppData.ambient-choice == "rain" ? #FFFFFF : Theme.text-secondary; } }
            }
        }

        // Footer: durations
        if !AppData.immersive: HorizontalLayout {
            alignment: center;
            spacing: 8px;
            VerticalLayout { alignment: center; IconTimer { width: 14px; height: 14px; stroke-color: Theme.text-muted; } }
            Text { text: AppData.pomodoro-durations; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
        }
    }

    // A tap anywhere outside the open dropdown closes it.
    if root.picker-open: TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.picker-open = false; }
    }

    // Task dropdown: opens above the task field, aligned to its right edge.
    if root.picker-open: Rectangle {
        width: min(root.width - 44px, 420px);
        x: root.width - self.width - 22px;
        height: min(root.height - 200px, 380px);
        y: root.height - self.height - 196px;
        border-radius: 18px;
        background: Theme.dark-mode ? #221C3AF2 : #FFFFFFF2;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000059;
        drop-shadow-offset-y: 10px;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            SearchField {
                placeholder: @tr("Search tasks");
                text <=> AppData.task-search;
                edited(q) => { AppData.task-search-changed(q); }
            }

            // Rows, grouped by due date
            // Rows, grouped by due date. Each row is placed by hand: a row
            // that opens a group is taller and carries the group heading.
            Flickable {
                vertical-stretch: 1;
                content-height: max(rows-column.preferred-height, self.height);
                rows-column := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    spacing: 2px;
                    for option in AppData.task-options: Rectangle {
                        height: option.header != "" ? 72px : 44px;
                        if option.header != "": Text {
                            x: 10px;
                            y: 8px;
                            text: option.header;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text-muted;
                        }
                        Rectangle {
                            y: parent.height - 44px;
                            height: 44px;
                            border-radius: 10px;
                            property <bool> chosen: option.id == AppData.session-task-id && option.id != "";
                            // Hover is a firm accent tint with an edge, so the row under
                            // the pointer reads as selected without a slow fade.
                            background: self.chosen ? Theme.accent-violet.with-alpha(0.24)
                                : (row-touch.has-hover ? Theme.accent-violet.with-alpha(0.13) : transparent);
                            border-width: row-touch.has-hover || self.chosen ? 1px : 0px;
                            border-color: Theme.accent-violet.with-alpha(0.45);
                            animate background { duration: 60ms; }
                            Rectangle {
                                x: 0;
                                y: 10px;
                                width: 3px;
                                height: parent.height - 20px;
                                border-radius: 2px;
                                background: Theme.accent-violet;
                                visible: row-touch.has-hover || parent.chosen;
                            }
                            Rectangle {
                                x: 10px;
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: option.priority == "high" ? Theme.destructive
                                    : (option.priority == "medium" ? Theme.accent-amber
                                    : (option.priority == "low" ? Theme.accent-green : transparent));
                            }
                            Text {
                                x: 28px;
                                width: parent.width - 28px - meta-text.width - 20px;
                                height: parent.height;
                                text: option.title;
                                font-size: 14px;
                                color: Theme.text-primary;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            meta-text := Text {
                                x: parent.width - self.width - 10px;
                                height: parent.height;
                                text: option.meta;
                                font-size: 11px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            row-touch := TouchArea {
                                clicked => {
                                    AppData.task-picked(option.id);
                                    root.picker-open = false;
                                }
                            }
                        }
                    }
                }
            }

            // View all tasks
            Rectangle {
                height: 40px;
                border-radius: 12px;
                background: all-touch.has-hover ? Theme.glass-fill-hover : Theme.glass-fill;
                animate background { duration: 200ms; easing: ease-out; }
                Text {
                    width: 100%;
                    height: 100%;
                    text: @tr("View all tasks");
                    font-size: 13px;
                    color: Theme.accent-violet;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                all-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.picker-open = false;
                        root.view-all-tasks();
                    }
                }
            }
        }
    }
}

/// The productivity panel: figures, the activity chart with its axis, and the
/// summary of the chosen period.
component AnalyticsCard inherits GlassCard {
    corner: 26px;

    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        alignment: start;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: Theme.accent-violet.with-alpha(0.22);
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        IconChart { width: 22px; height: 22px; stroke-color: Theme.accent-violet; }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: @tr("Productivity"); font-size: 18px; font-weight: 700; color: Theme.text-primary; }
                Text { text: @tr("Your focus at a glance"); font-size: 12px; color: Theme.text-muted; }
            }
            // Scrolls sideways when the panel is too narrow for all four.
            range-strip := Flickable {
                horizontal-stretch: 1;
                min-width: 120px;
                height: 38px;
                content-width: max(range-row.preferred-width, self.width);
                content-height: 38px;
                range-row := HorizontalLayout {
                    x: max(0px, range-strip.width - self.preferred-width);
                    width: self.preferred-width;
                    height: 38px;
                    spacing: 4px;
                    IconTab { label: @tr("Day"); selected: AppData.activity-range == "day"; clicked => { AppData.activity-range-selected("day"); } }
                    IconTab { label: @tr("Week"); selected: AppData.activity-range == "week"; clicked => { AppData.activity-range-selected("week"); } }
                    IconTab { label: @tr("Month"); selected: AppData.activity-range == "month"; clicked => { AppData.activity-range-selected("month"); } }
                    IconTab { label: @tr("Year"); selected: AppData.activity-range == "year"; clicked => { AppData.activity-range-selected("year"); } }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            StatCard { title: @tr("Sessions"); value: AppData.activity-sessions; change: AppData.activity-sessions-change; }
            StatCard { title: @tr("Focus time"); value: AppData.activity-focus; change: AppData.activity-focus-change; }
            StatCard { title: @tr("Streak"); value: AppData.activity-streak; change: ""; }
        }

        // Chart: axis labels on the left, gridlines behind the bars.
        // Every part is placed against one plot box, so the gridlines, their
        // labels and the bar bases line up exactly.
        chart := Rectangle {
            property <length> top: 8px;
            property <length> plot-x: 34px;
            property <length> plot-h: 172px;
            property <length> plot-w: self.width - self.plot-x;
            height: self.top + self.plot-h + 28px;

            for k in [0, 1, 2, 3, 4]: Rectangle {
                property <length> line-y: parent.top + parent.plot-h * (1 - k / 4);
                Text {
                    x: 0px;
                    y: parent.line-y - self.height / 2;
                    width: 24px;
                    text: @tr("{}", AppData.activity-axis-max * k / 4);
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
                Rectangle {
                    x: chart.plot-x;
                    y: parent.line-y;
                    width: chart.plot-w;
                    height: 1px;
                    background: k == 0 ? Theme.text-muted.with-alpha(0.5) : Theme.glass-border;
                }
            }

            // Bars stand on the zero line. Each slot is the same width.
            HorizontalLayout {
                x: parent.plot-x;
                y: parent.top;
                width: parent.plot-w;
                height: parent.plot-h;
                for bar in AppData.activity-bars: Rectangle {
                    horizontal-stretch: 1;
                    Rectangle {
                        width: min(26px, parent.width * 0.6);
                        height: bar.value > 0 ? max(6px, parent.height * bar.value) : 4px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height;
                        border-radius: min(6px, self.height / 2);
                        background: bar.value > 0
                            ? @linear-gradient(180deg, #C4B5FD 0%, #7C3AED 100%)
                            : Theme.accent-violet.with-alpha(0.35);
                    }
                }
            }
            HorizontalLayout {
                x: parent.plot-x;
                y: parent.top + parent.plot-h + 8px;
                width: parent.plot-w;
                for bar in AppData.activity-bars: Text {
                    horizontal-stretch: 1;
                    text: bar.label;
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        // Summary of the chosen period
        GlassCard {
            corner: 16px;
            // Wave artwork in the lower right corner, behind the text.
            Image {
                source: @image-url("../../assets/scenes/wave.svg");
                image-fit: fill;
                width: min(parent.width * 0.7, 320px);
                height: min(parent.height * 0.85, 160px);
                x: parent.width - self.width;
                y: parent.height - self.height;
                opacity: Theme.dark-mode ? 0.9 : 0.55;
            }
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    IconStar { width: 16px; height: 16px; stroke-color: Theme.accent-violet; }
                    Text { text: @tr("Summary"); font-size: 14px; font-weight: 600; color: Theme.text-primary; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    IconCheck { width: 14px; height: 14px; stroke-color: Theme.accent-green; }
                    Text { text: @tr("{} sessions completed", AppData.activity-sessions); font-size: 13px; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    IconClock { width: 14px; height: 14px; stroke-color: Theme.text-secondary; }
                    Text { text: @tr("Average focus: {}", AppData.activity-average); font-size: 13px; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    IconChart { width: 14px; height: 14px; stroke-color: Theme.text-secondary; }
                    Text {
                        text: AppData.activity-best == "" ? "Most active: none yet" : "Most active: \{AppData.activity-best}";
                        font-size: 13px;
                        color: Theme.text-secondary;
                    }
                }
            }
        }

        // Recent sessions: the last few focus sessions, newest first.
        GlassCard {
            corner: 16px;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { alignment: center; IconClock { width: 16px; height: 16px; stroke-color: Theme.accent-violet; } }
                    Text { text: @tr("Recent sessions"); font-size: 14px; font-weight: 600; color: Theme.text-primary; }
                }
                if AppData.session-history.length == 0: Text {
                    text: @tr("Finished focus sessions show up here.");
                    font-size: 13px;
                    color: Theme.text-muted;
                }
                for session[i] in AppData.session-history: VerticalLayout { if i < 4: HorizontalLayout {
                    spacing: 10px;
                    height: 34px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent-violet;
                        }
                    }
                    Text {
                        text: session.title;
                        font-size: 13px;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: session.detail;
                        font-size: 11px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                } }
            }
        }
    }
}

/// PomodoroScreen: the timer with its analytics beside it. On narrow windows
/// they stack. In full screen only the timer is shown and zooms to the centre.
export component PomodoroScreen inherits Rectangle {
    clip: true;
    background: transparent;
    callback view-all-tasks();

    property <bool> wide: root.width >= 900px;
    property <length> side: 24px;
    property <length> gap: 18px;

    property <length> timer-width: AppData.immersive
        ? root.width
        : (root.wide ? (root.width - 2 * root.side - root.gap) * 0.6 : root.width - 2 * root.side);
    property <length> timer-height: AppData.immersive
        ? root.height
        : (root.wide ? root.height - root.side : root.timer-min-height);
    // Height the timer card needs to show every row without squeezing.
    property <length> timer-min-height: 790px;

    property <length> analytics-x: root.wide ? root.side + root.timer-width + root.gap : root.side;
    property <length> analytics-y: root.wide ? 0px : root.timer-height + root.gap;
    property <length> analytics-width: root.wide ? root.width - root.analytics-x - root.side : root.width - 2 * root.side;
    property <length> analytics-height: root.wide ? root.height - root.side : analytics.preferred-height;

    // Narrow windows stack the timer above the analytics, so the page scrolls.
    page := Flickable {
        width: 100%;
        height: 100%;
        content-height: (root.wide || AppData.immersive) ? root.height : root.analytics-y + root.analytics-height + root.side;
        interactive: !root.wide && !AppData.immersive;

    // In the wide layout the timer card scrolls on its own when the window is
    // shorter than its content, the same way the analytics panel does.
    timer-scroll := Flickable {
        x: AppData.immersive ? (root.width - self.width) / 2 : root.side;
        // In full screen it centres in the visible part of the page.
        y: AppData.immersive ? (root.height - self.height) / 2 - page.content-y : 0px;
        width: root.timer-width;
        height: root.timer-height;
        animate x, y, width, height { duration: 800ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        content-height: timer.height;
        interactive: root.wide && !AppData.immersive;

        timer := TimerCard {
            view-all-tasks => { root.view-all-tasks(); }
            width: parent.width;
            height: AppData.immersive ? parent.height : max(parent.height, root.timer-min-height);
        }
    }

    analytics-wrap := Rectangle {
        x: root.analytics-x;
        y: root.analytics-y;
        width: root.analytics-width;
        height: root.analytics-height;
        opacity: AppData.immersive ? 0 : 1;
        animate opacity { duration: 250ms; easing: ease-out; }

        // The card is only as tall as its content, so no empty space below.
        Flickable {
            width: 100%;
            height: 100%;
            content-height: analytics.height;

            analytics := AnalyticsCard {
                width: parent.width;
                height: self.preferred-height;
            }
        }
    }
    }
}
