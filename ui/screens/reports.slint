import { Theme } from "../theme.slint";
import { ShellState } from "../shell_state.slint";
import { ThulliButton } from "../components/buttons.slint";
import { ThulliChipRow } from "../components/chip_row.slint";
import { ThulliBarChart } from "../components/chart_bars.slint";
import { ThulliDonut, DonutArcModel } from "../components/chart_donut.slint";
import { ThulliStatTile } from "../components/stat_tile.slint";
import { ThulliStatPanel } from "../components/stat_panel.slint";
import { ThulliTextField } from "../components/text_field.slint";
import { StatTileModel, BarModel, DonutSliceModel, TaskModel, SessionRowModel, ChoiceModel } from "../types.slint";

/// State and callbacks for the reports screen. The screen owner edits this
/// global freely; the shell re-exports it, so app.slint does not change.
export global ReportsState {
    /// "7d", "30d", "90d" or "custom".
    in-out property <string> range: "7d";
    in-out property <string> range-label: "";
    in-out property <string> custom-from: "";
    in-out property <string> custom-to: "";
    in-out property <string> list-filter: "";
    /// Lists offered by the list filter; the first entry (empty id) means all lists.
    in-out property <[ChoiceModel]> lists: [];
    in-out property <[StatTileModel]> totals: [];
    in-out property <[BarModel]> daily-tasks: [];
    in-out property <[BarModel]> daily-breaks: [];
    in-out property <[BarModel]> daily-total: [];
    in-out property <[DonutSliceModel]> time-by-list: [];
    in-out property <[DonutArcModel]> donut-arcs: [];
    in-out property <string> donut-total: "";
    in-out property <[TaskModel]> done-tasks: [];
    in-out property <string> most-productive-hour: "";
    in-out property <string> most-productive-day: "";
    in-out property <string> most-productive-month: "";
    in-out property <string> on-time-ratio: "";
    // Sessions tab
    in-out property <bool> show-sessions: false;
    in-out property <bool> show-breaks: true;
    in-out property <[SessionRowModel]> sessions: [];
    // Session form. An empty `form-id` adds a new session.
    in-out property <bool> form-visible: false;
    in-out property <string> form-id: "";
    in-out property <string> form-title: "";
    in-out property <string> form-list-id: "";
    in-out property <string> form-date: "";
    in-out property <string> form-start: "";
    in-out property <string> form-end: "";
    in-out property <bool> form-is-break: false;
    in-out property <string> error: "";

    callback refresh();
    callback set-range(string);
    callback set-custom-range(string, string);
    callback set-list-filter(string);
    callback set-show-breaks(bool);
    callback begin-add-session();
    callback add-session(string, string, string, string);   // title, list id, start, end ("YYYY-MM-DD HH:MM")
    callback edit-session(string);                          // opens the form for this session
    callback save-session(string, string, string, string, string);   // id, title, list id, start, end
    callback delete-session(string);
    callback export-csv();
    callback export-report();
}

/// ReportsScreen: totals, charts and the session log for a date range.
export component ReportsScreen inherits Rectangle {
    background: transparent;

    init => {
        ReportsState.refresh();
    }

    Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: content.preferred-height + ShellState.content-bottom-inset + 24px;

        content := VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            padding: 24px;
            padding-top: 16px;
            spacing: 14px;
            alignment: start;

            // Header
            HorizontalLayout {
                spacing: 10px;
                height: 36px;

                Text {
                    text: "Reports";
                    font-size: 22px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Text {
                    text: ReportsState.range-label;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle { }
                ThulliButton {
                    text: "Export CSV";
                    variant: "secondary";
                    width: 96px;
                    height: 32px;
                    y: 2px;
                    clicked => {
                        ReportsState.export-csv();
                    }
                }
                ThulliButton {
                    text: "Export PDF";
                    variant: "secondary";
                    width: 96px;
                    height: 32px;
                    y: 2px;
                    clicked => {
                        ReportsState.export-report();
                    }
                }
                ThulliButton {
                    text: "Insights";
                    variant: "secondary";
                    width: 76px;
                    height: 32px;
                    y: 2px;
                    clicked => {
                        ShellState.navigate("insights");
                    }
                }
            }

            // Range, tabs
            HorizontalLayout {
                spacing: 16px;
                ThulliChipRow {
                    choices: [
                        { id: "7d", label: "7D" },
                        { id: "30d", label: "30D" },
                        { id: "90d", label: "90D" },
                        { id: "custom", label: "Custom" },
                    ];
                    selected: ReportsState.range;
                    width: 250px;
                    picked(id) => {
                        ReportsState.set-range(id);
                    }
                }
                ThulliChipRow {
                    choices: [
                        { id: "overview", label: "Overview" },
                        { id: "sessions", label: "Sessions" },
                    ];
                    selected: ReportsState.show-sessions ? "sessions" : "overview";
                    width: 190px;
                    picked(id) => {
                        ReportsState.show-sessions = id == "sessions";
                    }
                }
                Rectangle { }
            }

            if ReportsState.range == "custom": HorizontalLayout {
                spacing: 8px;
                height: 34px;
                ThulliTextField {
                    placeholder: "From (YYYY-MM-DD)";
                    text <=> ReportsState.custom-from;
                    width: 170px;
                }
                ThulliTextField {
                    placeholder: "To (YYYY-MM-DD)";
                    text <=> ReportsState.custom-to;
                    width: 170px;
                }
                ThulliButton {
                    text: "Apply";
                    variant: "secondary";
                    width: 72px;
                    height: 34px;
                    clicked => {
                        ReportsState.set-custom-range(ReportsState.custom-from, ReportsState.custom-to);
                    }
                }
                Rectangle { }
            }

            if ReportsState.lists.length > 1: ThulliChipRow {
                choices: ReportsState.lists;
                selected: ReportsState.list-filter;
                picked(id) => {
                    ReportsState.set-list-filter(id);
                }
            }

            if ReportsState.error != "" && !ReportsState.form-visible: Text {
                text: ReportsState.error;
                font-size: 12px;
                color: Theme.destructive;
                wrap: word-wrap;
            }

            // ---------------- Overview ----------------
            if !ReportsState.show-sessions: VerticalLayout {
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    for tile in ReportsState.totals: ThulliStatTile {
                        title: tile.title;
                        value: tile.value;
                        caption: tile.caption;
                        height: 92px;
                    }
                }

                ThulliStatPanel {
                    title: "Daily activity";
                    subtitle: "Tasks, breaks and total";

                    Text {
                        text: "Tasks";
                        font-size: 11px;
                        color: Theme.accent-cyan;
                    }
                    ThulliBarChart {
                        height: 90px;
                        bars: ReportsState.daily-tasks;
                        bar-color: Theme.accent-cyan;
                        show-values: false;
                        label-height: 4px;
                    }
                    Text {
                        text: "Breaks";
                        font-size: 11px;
                        color: Theme.accent-amber;
                    }
                    ThulliBarChart {
                        height: 90px;
                        bars: ReportsState.daily-breaks;
                        bar-color: Theme.accent-amber;
                        show-values: false;
                        label-height: 4px;
                    }
                    Text {
                        text: "Total";
                        font-size: 11px;
                        color: Theme.accent-blue;
                    }
                    ThulliBarChart {
                        height: 120px;
                        bars: ReportsState.daily-total;
                        bar-color: Theme.accent-blue;
                        show-values: false;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    ThulliStatPanel {
                        title: "Time by list";
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 18px;
                            ThulliDonut {
                                width: 150px;
                                height: 150px;
                                arcs: ReportsState.donut-arcs;
                                center-title: ReportsState.donut-total;
                                center-caption: "worked";
                            }
                            VerticalLayout {
                                spacing: 6px;
                                alignment: center;
                                for slice in ReportsState.time-by-list: HorizontalLayout {
                                    spacing: 8px;
                                    height: 20px;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        y: 5px;
                                        border-radius: 5px;
                                        background: slice.color.with-alpha(0.85);
                                    }
                                    Text {
                                        text: slice.label;
                                        font-size: 12px;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: slice.value-label;
                                        font-size: 12px;
                                        color: Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    ThulliStatPanel {
                        title: "Your rhythm";
                        horizontal-stretch: 1;

                        Text {
                            text: "Most productive hour";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                        Text {
                            text: ReportsState.most-productive-hour != "" ? ReportsState.most-productive-hour : "Not enough data";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Most productive day";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                        Text {
                            text: ReportsState.most-productive-day != "" ? ReportsState.most-productive-day : "Not enough data";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Most productive month";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                        Text {
                            text: ReportsState.most-productive-month != "" ? ReportsState.most-productive-month : "Not enough data";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Done tasks finished on time";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                        Text {
                            text: ReportsState.on-time-ratio != "" ? ReportsState.on-time-ratio : "Not enough data";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                    }
                }

                ThulliStatPanel {
                    title: "Done tasks";
                    subtitle: ReportsState.done-tasks.length + " finished";

                    if ReportsState.done-tasks.length == 0: Text {
                        text: "No tasks finished in this range.";
                        font-size: 12px;
                        color: Theme.text-muted;
                    }
                    for task in ReportsState.done-tasks: HorizontalLayout {
                        spacing: 10px;
                        height: 26px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: 9px;
                            border-radius: 4px;
                            background: task.list-color.with-alpha(0.7);
                        }
                        Text {
                            text: task.title;
                            font-size: 13px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: task.list-name;
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: task.tracked-mins + "m";
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            min-width: 52px;
                        }
                    }
                }
            }

            // ---------------- Sessions ----------------
            if ReportsState.show-sessions: VerticalLayout {
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    ThulliChipRow {
                        choices: [
                            { id: "show", label: "Show breaks" },
                            { id: "hide", label: "Hide breaks" },
                        ];
                        selected: ReportsState.show-breaks ? "show" : "hide";
                        width: 230px;
                        picked(id) => {
                            ReportsState.set-show-breaks(id == "show");
                        }
                    }
                    Rectangle { }
                    ThulliButton {
                        text: "Add session";
                        variant: "secondary";
                        width: 104px;
                        height: 30px;
                        clicked => {
                            ReportsState.begin-add-session();
                        }
                    }
                }

                if ReportsState.form-visible: ThulliStatPanel {
                    title: ReportsState.form-id == "" ? "Add a session" : "Edit session";

                    ThulliChipRow {
                        choices: [
                            { id: "task", label: "Task" },
                            { id: "break", label: "Break" },
                        ];
                        selected: ReportsState.form-is-break ? "break" : "task";
                        picked(id) => {
                            ReportsState.form-is-break = id == "break";
                        }
                    }
                    ThulliTextField {
                        placeholder: ReportsState.form-is-break ? "Name (optional)" : "What did you work on?";
                        text <=> ReportsState.form-title;
                    }
                    if !ReportsState.form-is-break && ReportsState.lists.length > 1: ThulliChipRow {
                        choices: ReportsState.lists;
                        selected: ReportsState.form-list-id;
                        picked(id) => {
                            ReportsState.form-list-id = id;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ThulliTextField {
                            placeholder: "Date (YYYY-MM-DD)";
                            text <=> ReportsState.form-date;
                        }
                        ThulliTextField {
                            placeholder: "Start (HH:MM)";
                            text <=> ReportsState.form-start;
                        }
                        ThulliTextField {
                            placeholder: "End (HH:MM)";
                            text <=> ReportsState.form-end;
                        }
                    }
                    if ReportsState.error != "": Text {
                        text: ReportsState.error;
                        font-size: 12px;
                        color: Theme.destructive;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        ThulliButton {
                            text: "Cancel";
                            variant: "secondary";
                            width: 72px;
                            height: 30px;
                            clicked => {
                                ReportsState.form-visible = false;
                                ReportsState.error = "";
                            }
                        }
                        ThulliButton {
                            text: "Save";
                            variant: "secondary";
                            width: 72px;
                            height: 30px;
                            clicked => {
                                if (ReportsState.form-id == "") {
                                    ReportsState.add-session(
                                        ReportsState.form-title,
                                        ReportsState.form-list-id,
                                        ReportsState.form-date + " " + ReportsState.form-start,
                                        ReportsState.form-date + " " + ReportsState.form-end
                                    );
                                } else {
                                    ReportsState.save-session(
                                        ReportsState.form-id,
                                        ReportsState.form-title,
                                        ReportsState.form-list-id,
                                        ReportsState.form-date + " " + ReportsState.form-start,
                                        ReportsState.form-date + " " + ReportsState.form-end
                                    );
                                }
                            }
                        }
                    }
                }

                ThulliStatPanel {
                    title: "Sessions";
                    subtitle: ReportsState.sessions.length + " in this range";

                    HorizontalLayout {
                        spacing: 12px;
                        height: 18px;
                        Text {
                            text: "Session";
                            font-size: 11px;
                            color: Theme.text-muted;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "List";
                            font-size: 11px;
                            color: Theme.text-muted;
                            min-width: 90px;
                        }
                        Text {
                            text: "Date";
                            font-size: 11px;
                            color: Theme.text-muted;
                            min-width: 84px;
                        }
                        Text {
                            text: "Start";
                            font-size: 11px;
                            color: Theme.text-muted;
                            min-width: 44px;
                        }
                        Text {
                            text: "End";
                            font-size: 11px;
                            color: Theme.text-muted;
                            min-width: 44px;
                        }
                        Text {
                            text: "Length";
                            font-size: 11px;
                            color: Theme.text-muted;
                            horizontal-alignment: right;
                            min-width: 56px;
                        }
                        Rectangle {
                            width: 96px;
                        }
                    }

                    if ReportsState.sessions.length == 0: Text {
                        text: "No sessions in this range.";
                        font-size: 12px;
                        color: Theme.text-muted;
                    }

                    for row in ReportsState.sessions: HorizontalLayout {
                        spacing: 12px;
                        height: 30px;
                        Text {
                            text: row.title;
                            font-size: 13px;
                            color: row.is-break ? Theme.text-secondary : Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: row.list-name;
                            font-size: 12px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                            min-width: 90px;
                            max-width: 90px;
                        }
                        Text {
                            text: row.date-label;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 84px;
                        }
                        Text {
                            text: row.start-label;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 44px;
                        }
                        Text {
                            text: row.end-label;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 44px;
                        }
                        Text {
                            text: row.duration-label;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            min-width: 56px;
                        }
                        TouchArea {
                            width: 44px;
                            height: 30px;
                            clicked => {
                                ReportsState.edit-session(row.id);
                            }
                            Text {
                                text: "Edit";
                                width: 100%;
                                height: 100%;
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.accent-cyan;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            width: 40px;
                            height: 30px;
                            clicked => {
                                ReportsState.delete-session(row.id);
                            }
                            Text {
                                text: "Delete";
                                width: 100%;
                                height: 100%;
                                font-size: 11px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
