import { Theme } from "../theme.slint";
import { IconPlus, IconMore, IconUndo, IconRedo, IconBoard, IconGrid, IconCalendar, IconChevronLeft, IconChevronRight, IconChevronDown, IconNote, IconTrash, IconClose } from "../icons.slint";
import { GlassCard, GlassIconButton } from "../components/glass.slint";
import { IconTab } from "../components/focus_controls.slint";
import { SpaceBadge, SpaceForm, AddTaskField, TaskCard, ColumnShell, CardAction, TaskComposer } from "../components/space_widgets.slint";
import { SpaceTask, SpaceColumn } from "../types.slint";
import { AppData } from "../app_data.slint";
import { PlanPanel } from "ai_panels.slint";
import { DropZone } from "../components/drag.slint";
import { IconStar } from "../icons.slint";

/// A small rounded choice chip, tinted when it is the current choice.
component Chip inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.accent-violet;
    in property <bool> current: false;
    callback clicked();
    height: 24px;
    width: chip-text.preferred-width + 18px;
    border-radius: 12px;
    background: root.current ? root.tint.with-alpha(0.30) : (touch.has-hover ? root.tint.with-alpha(0.18) : Theme.glass-fill);
    border-width: 1px;
    border-color: root.current ? root.tint : Theme.glass-border;
    animate background { duration: 200ms; easing: ease-out; }
    chip-text := Text { text: root.label; font-size: 11px; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// One row of the space list.
component SpaceItem inherits Rectangle {
    in property <string> name;
    in property <color> tint;
    in property <string> letter;
    in property <int> count;
    in property <bool> selected;
    in property <bool> has-menu: true;
    callback clicked();
    callback menu();
    height: 44px;
    border-radius: 12px;
    background: root.selected ? Theme.glass-fill-hover : (touch.has-hover ? Theme.glass-fill : transparent);
    animate background { duration: 200ms; easing: ease-out; }
    touch := TouchArea {
    mouse-cursor: pointer;
    clicked => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout { alignment: center; SpaceBadge { size: 24px; tint: root.tint; letter: root.letter; } }
        Text { horizontal-stretch: 1; text: root.name; font-size: 14px; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
        if root.has-menu && touch.has-hover: VerticalLayout {
            alignment: center;
            CardAction { tip: ""; clicked => { root.menu(); }
                IconMore { width: 14px; height: 14px; stroke-color: Theme.text-secondary; } }
        }
        if !root.has-menu || !touch.has-hover: Text { text: "\{root.count}"; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; }
    }
    }
}

/// A small menu row with an icon.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.glass-fill-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        VerticalLayout { alignment: center; @children }
        Text { text: root.label; font-size: 13px; color: root.danger ? Theme.destructive : Theme.text-primary; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// The board: Backlog, This Week, Today and Done. Columns fold to a strip.
component BoardView inherits Rectangle {
    callback launched();
    property <bool> fold-backlog: false;
    property <bool> fold-week: false;
    property <bool> fold-today: false;
    property <bool> fold-done: false;

    function folded(id: string) -> bool {
        if id == "backlog" { return root.fold-backlog; }
        if id == "this_week" { return root.fold-week; }
        if id == "today" { return root.fold-today; }
        return root.fold-done;
    }
    function toggle-fold(id: string) {
        if id == "backlog" { root.fold-backlog = !root.fold-backlog; }
        else if id == "this_week" { root.fold-week = !root.fold-week; }
        else if id == "today" { root.fold-today = !root.fold-today; }
        else { root.fold-done = !root.fold-done; }
    }
    function back-of(id: string) -> string {
        if id == "this_week" { return "backlog"; }
        if id == "today" { return "this_week"; }
        return "";
    }
    function forward-of(id: string) -> string {
        if id == "backlog" { return "this_week"; }
        if id == "this_week" { return "today"; }
        return "";
    }

    board-scroll := Flickable {
        width: 100%;
        height: 100%;
        content-width: max(self.width, row.preferred-width);
        row := HorizontalLayout {
            height: board-scroll.height;
            width: max(board-scroll.width, self.preferred-width);
            spacing: 14px;
            for column in AppData.board-columns: ColumnShell {
                title: column.title;
                done: column.done;
                total: column.total;
                show-progress: column.id != "backlog" && column.id != "done";
                highlight: column.id == "today";
                collapsed: root.folded(column.id);
                zone: column.id;
                drop-view: "board";
                collapse-toggled => { root.toggle-fold(column.id); }
                min-width: root.folded(column.id) ? 60px : 250px;
                max-width: root.folded(column.id) ? 60px : 100000px;
                horizontal-stretch: root.folded(column.id) ? 0 : 1;

                if column.id == "done" && column.tasks.length > 0: Text {
                    text: "Tasks: \{column.total}";
                    font-size: 12px;
                    color: Theme.text-muted;
                }
                for task in column.tasks: VerticalLayout {
                    spacing: 8px;
                    if task.header != "": Text { text: task.header; font-size: 13px; font-weight: 600; color: Theme.text-secondary; }
                    TaskCard {
                        drag-view: "board";
                        task: task;
                        compact: column.id == "done";
                        can-back: column.id != "backlog";
                        can-forward: column.id != "done";
                        can-launch: column.id != "done";
                        toggled => { AppData.space-task-toggled(task.id); }
                        back => {
                            if column.id == "done" { AppData.space-task-toggled(task.id); }
                            else { AppData.space-task-moved(task.id, root.back-of(column.id)); }
                        }
                        forward => {
                            if column.id == "today" { AppData.space-task-toggled(task.id); }
                            else { AppData.space-task-moved(task.id, root.forward-of(column.id)); }
                        }
                        launched => { AppData.task-launched(task.id); root.launched(); }
                        deleted => { AppData.space-task-deleted(task.id); }
                        saved(title, estimate, notes, do-date, deadline) => { AppData.space-task-edited(task.id, title, estimate, notes, do-date, deadline); }
                        step-added(title) => { AppData.step-added(task.id, title); }
                        step-toggled(id) => { AppData.space-task-toggled(id); }
                    }
                }
                if column.id != "done": TaskComposer {
                    default-space: AppData.space-id != "" ? AppData.space-id : (AppData.spaces.length > 0 ? AppData.spaces[0].id : "");
                    added(title, estimate, space, do-date, notes) => { AppData.space-task-composed(column.id, title, estimate, space, do-date, notes); }
                }
                if column.id == "done" && column.tasks.length == 0: Text {
                    text: "Finished tasks land here.";
                    font-size: 13px;
                    color: Theme.text-muted;
                }
            }
        }
    }
}

/// Colour of a matrix quadrant.
global QuadrantTint {
    pure public function of(id: string) -> color {
        if id == "do_asap" { return #F43F5E; }
        if id == "do_later_today" { return #22C55E; }
        if id == "do_mid_week" { return #F59E0B; }
        return #94A3B8;
    }
}

/// Four coloured dots under an unsorted card. Each sorts the task into its
/// quadrant; hovering one names it.
component QuadrantDots inherits HorizontalLayout {
    in property <string> task-id;
    spacing: 2px;
    padding-left: 22px;
    alignment: start;
    for q in [
        { id: "do_asap", name: "Do ASAP" },
        { id: "do_later_today", name: "Do Later Today" },
        { id: "do_mid_week", name: "Do Mid Week" },
        { id: "leave_till_end", name: "Leave Till End" },
    ]: CardAction {
        tip: q.name;
        clicked => { AppData.task-quadrant-set(root.task-id, q.id); }
        Rectangle { width: 12px; height: 12px; border-radius: 6px; background: QuadrantTint.of(q.id); }
    }
}

/// One matrix quadrant: a coloured header, then its cards or an empty line.
component QuadrantPanel inherits Rectangle {
    in property <SpaceColumn> quadrant;
    callback launched();
    horizontal-stretch: 1;
    border-radius: 20px;
    border-width: 1px;
    border-color: Theme.glass-border;
    background: @linear-gradient(180deg, QuadrantTint.of(root.quadrant.id).with-alpha(0.12) 0%, Theme.glass-fill 30%);
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            padding: 20px;
            padding-bottom: 16px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: root.quadrant.title; font-size: 20px; font-weight: 600; color: QuadrantTint.of(root.quadrant.id); }
                Text { text: root.quadrant.caption; font-size: 14px; color: Theme.text-muted; }
            }
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.glass-fill-strong;
                    Text { text: "\{root.quadrant.total}"; font-size: 13px; font-weight: 600; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.glass-border; }
        Rectangle {
            vertical-stretch: 1;
            if root.quadrant.tasks.length == 0: Text {
                width: 100%;
                height: 100%;
                text: "No tasks yet. Sort one in from Matrix Review.";
                font-size: 14px;
                font-italic: true;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Flickable {
                content-height: cards.preferred-height;
                cards := VerticalLayout {
                    width: parent.width;
                    padding: 14px;
                    spacing: 10px;
                    alignment: start;
                    for task in root.quadrant.tasks: TaskCard {
                        drag-view: "matrix";
                        task: task;
                        can-back: true;
                        toggled => { AppData.space-task-toggled(task.id); }
                        // Back takes the task out of the quadrant again.
                        back => { AppData.task-quadrant-set(task.id, ""); }
                        launched => { AppData.task-launched(task.id); root.launched(); }
                        deleted => { AppData.space-task-deleted(task.id); }
                        saved(title, estimate, notes, do-date, deadline) => { AppData.space-task-edited(task.id, title, estimate, notes, do-date, deadline); }
                        step-added(title) => { AppData.step-added(task.id, title); }
                        step-toggled(id) => { AppData.space-task-toggled(id); }
                    }
                }
            }
        }
    }
    DropZone { width: 100%; height: 100%; zone: root.quadrant.id; view: "matrix"; tint: QuadrantTint.of(root.quadrant.id); }
}

/// One unsorted group (Today, This Week or Backlog) that folds away.
component UnsortedGroup inherits VerticalLayout {
    in property <SpaceColumn> group;
    callback launched();
    property <bool> open: true;
    spacing: 10px;
    Rectangle {
        height: 32px;
        HorizontalLayout {
            padding-left: 8px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                IconChevronDown {
                    width: 14px; height: 14px; stroke-color: Theme.text-muted;
                    transform-rotation: root.open ? 0deg : -90deg;
                    animate transform-rotation { duration: 200ms; easing: ease-out; }
                }
            }
            Text { text: root.group.title.to-uppercase(); font-size: 15px; color: Theme.text-secondary; vertical-alignment: center; }
            Text { text: "\{root.group.total}"; font-size: 14px; color: Theme.text-muted; vertical-alignment: center; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
    }
    if root.open && root.group.tasks.length == 0: Text {
        text: "Nothing waiting here";
        font-size: 14px;
        font-italic: true;
        color: Theme.text-muted;
    }
    if root.open: VerticalLayout {
        spacing: 10px;
        for task in root.group.tasks: TaskCard {
            drag-view: "matrix";
            task: task;
            toggled => { AppData.space-task-toggled(task.id); }
            launched => { AppData.task-launched(task.id); root.launched(); }
            deleted => { AppData.space-task-deleted(task.id); }
            saved(title, estimate, notes, do-date, deadline) => { AppData.space-task-edited(task.id, title, estimate, notes, do-date, deadline); }
            step-added(title) => { AppData.step-added(task.id, title); }
            step-toggled(id) => { AppData.space-task-toggled(id); }
            QuadrantDots { task-id: task.id; }
        }
    }
}

/// The matrix: Matrix Review with the unsorted tasks on the left, the four
/// quadrants on the right.
component MatrixView inherits Rectangle {
    callback launched();
    property <int> sorted: AppData.matrix-quadrants.length < 4 ? 0
        : AppData.matrix-quadrants[0].total + AppData.matrix-quadrants[1].total
            + AppData.matrix-quadrants[2].total + AppData.matrix-quadrants[3].total;
    property <int> all: root.sorted + AppData.matrix-unsorted-count;
    HorizontalLayout {
        spacing: 22px;
        Rectangle {
            width: min(540px, root.width * 0.32);
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.glass-border;
            background: Theme.glass-fill;
            clip: true;
            VerticalLayout {
                VerticalLayout {
                    padding: 22px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text { horizontal-stretch: 1; text: "Matrix Review"; font-size: 20px; font-weight: 700; color: Theme.text-primary; }
                        Text { text: "\{root.sorted}/\{root.all}"; font-size: 14px; color: Theme.text-muted; vertical-alignment: center; }
                    }
                    Text { text: "Sort each task with the coloured dots, or one by one."; font-size: 14px; color: Theme.text-muted; wrap: word-wrap; }
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.glass-fill-hover;
                        Rectangle {
                            x: 0;
                            width: root.all == 0 ? 0px : parent.width * root.sorted / root.all;
                            border-radius: 3px;
                            background: @linear-gradient(90deg, #A78BFA 0%, #4CC36B 100%);
                            animate width { duration: 300ms; easing: ease-out; }
                        }
                    }
                    Rectangle {
                        height: 44px;
                        border-radius: 22px;
                        background: sort-touch.has-hover ? Theme.accent-violet.with-alpha(0.45) : Theme.accent-violet.with-alpha(0.30);
                        animate background { duration: 200ms; easing: ease-out; }
                        Text {
                            text: "Sort one by one  ·  \{AppData.matrix-unsorted-count}";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        sort-touch := TouchArea { mouse-cursor: pointer; clicked => { AppData.triage-start(); } }
                    }
                }
                Rectangle { height: 1px; background: Theme.glass-border; }
                Flickable {
                    vertical-stretch: 1;
                    content-height: unsorted.preferred-height;
                    unsorted := VerticalLayout {
                        width: parent.width;
                        padding: 22px;
                        padding-top: 16px;
                        spacing: 14px;
                        alignment: start;
                        HorizontalLayout {
                            Text { horizontal-stretch: 1; text: "Unsorted"; font-size: 16px; color: Theme.text-secondary; }
                            Text { text: "\{AppData.matrix-unsorted-count}"; font-size: 15px; color: Theme.text-secondary; }
                        }
                        for group in AppData.matrix-unsorted: UnsortedGroup { group: group; launched => { root.launched(); } }
                    }
                }
            }
            DropZone { width: 100%; height: 100%; zone: "unsorted"; view: "matrix"; }
        }
        VerticalLayout {
            spacing: 22px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 22px;
                QuadrantPanel { quadrant: AppData.matrix-quadrants[0]; launched => { root.launched(); } }
                QuadrantPanel { quadrant: AppData.matrix-quadrants[1]; launched => { root.launched(); } }
            }
            HorizontalLayout {
                spacing: 22px;
                QuadrantPanel { quadrant: AppData.matrix-quadrants[2]; launched => { root.launched(); } }
                QuadrantPanel { quadrant: AppData.matrix-quadrants[3]; launched => { root.launched(); } }
            }
        }
    }
}

/// The calendar: tasks with no day on the left, the week on the right.
component CalendarView inherits Rectangle {
    callback launched();
    HorizontalLayout {
        spacing: 14px;
        GlassCard {
            corner: 20px;
            width: min(340px, root.width * 0.32);
            // Dropping a planned task here takes it off the calendar. Drawn
            // first, so the cards above it still take clicks.
            DropZone { width: 100%; height: 100%; zone: "unscheduled"; view: "calendar"; }
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Unscheduled"; font-size: 17px; font-weight: 700; color: Theme.text-primary; }
                Text { text: "Pick a day under a task to plan it."; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                Flickable {
                    vertical-stretch: 1;
                    content-height: rail.preferred-height;
                    rail := VerticalLayout {
                        width: parent.width;
                        spacing: 10px;
                        alignment: start;
                        for group in AppData.calendar-unscheduled: VerticalLayout {
                            spacing: 8px;
                            Text { text: "\{group.title.to-uppercase()}  \{group.total}"; font-size: 12px; font-weight: 600; color: group.id == "today" ? Theme.accent-green : Theme.text-muted; }
                            if group.tasks.length == 0: Text { text: "All planned."; font-size: 12px; color: Theme.text-muted; font-italic: true; }
                            for task in group.tasks: TaskCard {
                                drag-view: "calendar";
                                task: task;
                                toggled => { AppData.space-task-toggled(task.id); }
                                launched => { AppData.task-launched(task.id); root.launched(); }
                                deleted => { AppData.space-task-deleted(task.id); }
                                saved(title, estimate, notes, do-date, deadline) => { AppData.space-task-edited(task.id, title, estimate, notes, do-date, deadline); }
                                step-added(title) => { AppData.step-added(task.id, title); }
                                step-toggled(id) => { AppData.space-task-toggled(id); }
                                HorizontalLayout {
                                    spacing: 4px;
                                    padding-left: 28px;
                                    for day[i] in AppData.calendar-days: Chip {
                                        label: day.name;
                                        tint: day.today ? Theme.accent-green : Theme.accent-violet;
                                        clicked => { AppData.task-day-set(task.id, i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        GlassCard {
            corner: 20px;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout { alignment: center; IconCalendar { width: 20px; height: 20px; stroke-color: Theme.text-secondary; } }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: AppData.calendar-label; font-size: 17px; font-weight: 700; color: Theme.text-primary; }
                        Text { text: "Weekly schedule"; font-size: 12px; color: Theme.text-muted; }
                    }
                    VerticalLayout { alignment: center; GlassIconButton { dia: 32px; clicked => { AppData.calendar-shift(-1); }
                        IconChevronLeft { width: 12px; height: 12px; stroke-color: Theme.text-secondary; } } }
                    VerticalLayout { alignment: center; Chip { label: "Today"; clicked => { AppData.calendar-shift(0); } } }
                    VerticalLayout { alignment: center; GlassIconButton { dia: 32px; clicked => { AppData.calendar-shift(1); }
                        IconChevronRight { width: 12px; height: 12px; stroke-color: Theme.text-secondary; } } }
                }
                week-scroll := Flickable {
                    vertical-stretch: 1;
                    content-width: max(self.width, 7 * 150px);
                    HorizontalLayout {
                        width: max(week-scroll.width, 7 * 150px);
                        height: week-scroll.height;
                        spacing: 8px;
                        for day[i] in AppData.calendar-days: Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 14px;
                            background: day.today ? Theme.accent-green.with-alpha(0.10) : Theme.glass-fill;
                            border-width: 1px;
                            border-color: day.today ? Theme.accent-green.with-alpha(0.5) : Theme.glass-border;
                            DropZone { width: 100%; height: 100%; corner: 14px; zone: "\{i}"; view: "calendar"; tint: Theme.accent-green; }
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text { text: day.name; font-size: 12px; font-weight: 600; color: day.today ? Theme.accent-green : Theme.text-muted; horizontal-alignment: center; }
                                Text { text: day.number; font-size: 20px; font-weight: 700; color: day.today ? Theme.accent-green : Theme.text-primary; horizontal-alignment: center; }
                                Flickable {
                                    vertical-stretch: 1;
                                    content-height: day-cards.preferred-height;
                                    day-cards := VerticalLayout {
                                        width: parent.width;
                                        spacing: 8px;
                                        alignment: start;
                                        for task in day.tasks: TaskCard {
                                            drag-view: "calendar";
                                            task: task;
                                            compact: true;
                                            can-back: false;
                                            can-launch: true;
                                            toggled => { AppData.space-task-toggled(task.id); }
                                            launched => { AppData.task-launched(task.id); root.launched(); }
                                            deleted => { AppData.space-task-deleted(task.id); }
                                            saved(title, estimate, notes, do-date, deadline) => { AppData.space-task-edited(task.id, title, estimate, notes, do-date, deadline); }
                                            Chip { label: "Unplan"; tint: Theme.text-muted; clicked => { AppData.task-day-set(task.id, -1); } }
                                        }
                                        AddTaskField {
                                            label: "Add";
                                            added(text) => { AppData.calendar-task-added(i, text); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// SpacesScreen: spaces on the left; the chosen space (or all of them) as a
/// board, a matrix or a calendar on the right.
export component SpacesScreen inherits Rectangle {
    // Asks the shell to open Pomodoro after a task is launched.
    callback open-pomodoro();

    clip: true;
    background: transparent;

    property <bool> creating: false;
    property <bool> plan-open: false;
    property <string> menu-id: "";
    property <length> menu-y: 0px;
    property <bool> confirm-delete: false;
    property <string> edit-id: "";
    property <string> edit-name: "";
    property <string> edit-hex: "";
    property <string> edit-letter: "";
    property <length> list-width: 230px;

    HorizontalLayout {
        padding-top: 16px;
        padding-bottom: 20px;
        padding-right: 24px;
        spacing: 18px;

        // Space list
        GlassCard {
            corner: 20px;
            width: root.list-width;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 6px;
                    Text { horizontal-stretch: 1; text: "SPACES"; font-size: 12px; font-weight: 600; color: Theme.text-muted; vertical-alignment: center; }
                    GlassIconButton {
                        dia: 32px;
                        clicked => { root.creating = true; root.menu-id = ""; root.edit-id = ""; }
                        IconPlus { width: 13px; height: 13px; stroke-color: Theme.text-primary; }
                    }
                }
                SpaceItem {
                    name: "All spaces";
                    tint: Theme.accent-violet;
                    letter: "A";
                    count: AppData.all-open-count;
                    has-menu: false;
                    selected: AppData.space-id == "";
                    clicked => { AppData.space-selected(""); }
                }
                for space[i] in AppData.spaces: SpaceItem {
                    name: space.name;
                    tint: space.color;
                    letter: space.letter;
                    count: space.count;
                    selected: AppData.space-id == space.id;
                    clicked => { AppData.space-selected(space.id); }
                    menu => {
                        root.menu-id = space.id;
                        root.confirm-delete = false;
                        root.menu-y = 12px + 38px + 4px + (i + 1) * 48px;
                        root.edit-name = space.name;
                        root.edit-hex = space.hex;
                        root.edit-letter = space.letter;
                    }
                }
            }
        }

        // Chosen space
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 16px;
            HorizontalLayout {
                spacing: 12px;
                height: 48px;
                VerticalLayout {
                    alignment: center;
                    SpaceBadge { size: 40px; tint: AppData.space-color; letter: AppData.space-letter; }
                }
                Text { text: AppData.space-name; font-size: 28px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                VerticalLayout { alignment: center; CardAction { tip: AppData.can-undo ? "Undo" : ""; clicked => { AppData.space-undo(); }
                    IconUndo { stroke-color: AppData.can-undo ? Theme.text-secondary : Theme.text-muted.with-alpha(0.4); } } }
                VerticalLayout { alignment: center; CardAction { tip: AppData.can-redo ? "Redo" : ""; clicked => { AppData.space-redo(); }
                    IconRedo { stroke-color: AppData.can-redo ? Theme.text-secondary : Theme.text-muted.with-alpha(0.4); } } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    IconTab { label: "Plan with AI"; clicked => { root.plan-open = true; }
                        IconStar { width: 16px; height: 16px; stroke-color: Theme.accent-violet; } }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        IconTab { label: "Board"; selected: AppData.space-view == "board"; clicked => { AppData.space-view = "board"; }
                            IconBoard { stroke-color: AppData.space-view == "board" ? Theme.accent-violet : Theme.text-secondary; } }
                        IconTab { label: "Matrix"; selected: AppData.space-view == "matrix"; clicked => { AppData.space-view = "matrix"; }
                            IconGrid { stroke-color: AppData.space-view == "matrix" ? Theme.accent-violet : Theme.text-secondary; } }
                        IconTab { label: "Calendar"; selected: AppData.space-view == "calendar"; clicked => { AppData.space-view = "calendar"; }
                            IconCalendar { width: 16px; height: 16px; stroke-color: AppData.space-view == "calendar" ? Theme.accent-violet : Theme.text-secondary; } }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if AppData.spaces.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    Text { text: "Create your first space"; font-size: 26px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; }
                    Text {
                        text: "Spaces give your tasks a real home. Start with one project, goal, or area you want to move forward.";
                        font-size: 15px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 160px;
                            height: 44px;
                            border-radius: 22px;
                            background: @linear-gradient(90deg, #5EEAD4 0%, #A78BFA 100%);
                            Text { text: "Create a space"; font-size: 15px; font-weight: 600; color: #1C1917; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.creating = true; } }
                        }
                    }
                }
                if AppData.spaces.length > 0 && AppData.space-view == "board": BoardView { launched => { root.open-pomodoro(); } }
                if AppData.spaces.length > 0 && AppData.space-view == "matrix": MatrixView { launched => { root.open-pomodoro(); } }
                if AppData.spaces.length > 0 && AppData.space-view == "calendar": CalendarView { launched => { root.open-pomodoro(); } }
            }
        }
    }

    // Clicking outside a menu or form closes it.
    if root.menu-id != "" || root.creating || root.edit-id != "": TouchArea {
        clicked => { root.menu-id = ""; root.creating = false; root.edit-id = ""; }
    }

    // Space menu: Edit and Delete.
    if root.menu-id != "": GlassCard {
        x: root.list-width - 20px;
        y: root.menu-y;
        width: 190px;
        height: 84px;
        corner: 14px;
        background: Theme.dark-mode ? #221C3AF5 : #FFFFFFF5;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000059;
        VerticalLayout {
            padding: 8px;
            spacing: 0px;
            MenuRow {
                label: "Edit";
                clicked => { root.edit-id = root.menu-id; root.menu-id = ""; }
                IconNote { width: 15px; height: 15px; stroke-color: Theme.text-secondary; }
            }
            MenuRow {
                label: root.confirm-delete ? "Delete space and its tasks" : "Delete";
                danger: true;
                clicked => {
                    if root.confirm-delete {
                        AppData.space-deleted(root.menu-id);
                        root.menu-id = "";
                    } else {
                        root.confirm-delete = true;
                    }
                }
                IconTrash { width: 15px; height: 15px; stroke-color: Theme.destructive; }
            }
        }
    }

    if root.creating: SpaceForm {
        x: root.list-width - 20px;
        y: 60px;
        action: "Save";
        letter: "+";
        name: "";
        hex: "#E879F9";
        saved(name, color) => { AppData.space-created(name, color); root.creating = false; }
        cancelled => { root.creating = false; }
    }

    if root.edit-id != "": SpaceForm {
        x: root.list-width - 20px;
        y: root.menu-y;
        action: "Update";
        letter: root.edit-letter;
        name: root.edit-name;
        hex: root.edit-hex;
        saved(name, color) => { AppData.space-edited(root.edit-id, name, color); root.edit-id = ""; }
        cancelled => { root.edit-id = ""; }
    }

    if root.plan-open: PlanPanel {
        width: root.width;
        height: root.height;
        closed => { root.plan-open = false; }
        focus-started => { root.open-pomodoro(); }
    }
}
