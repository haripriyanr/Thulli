import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ShellState } from "../shell_state.slint";
import { TaskModel } from "../types.slint";

/// State and callbacks for the matrix screen. Rust fills the models and
/// handles the callbacks; see src/app/matrix.rs.
export global MatrixState {
    in-out property <[TaskModel]> do-asap: [];
    in-out property <[TaskModel]> do-later-today: [];
    in-out property <[TaskModel]> do-mid-week: [];
    in-out property <[TaskModel]> leave-till-end: [];
    /// Tasks not yet placed, grouped by section for the review rail.
    in-out property <[TaskModel]> unsorted-today: [];
    in-out property <[TaskModel]> unsorted-this-week: [];
    in-out property <[TaskModel]> unsorted-backlog: [];
    in-out property <int> unsorted-count: 0;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    /// The "prioritize one by one" card. `review-task` is shown while open.
    in-out property <bool> review-open: false;
    in-out property <TaskModel> review-task;
    in-out property <int> review-remaining: 0;

    callback request-refresh();
    callback place-task(string, string);     // task id, quadrant ("" clears)
    callback review-quadrant(string);        // quadrant id
    callback start-review();                 // prioritize one by one
    callback next-review-task();             // skip the current task
    callback close-review();
    callback undo();
    callback redo();
}

/// Small text button.
component TextAction inherits TouchArea {
    in property <string> label;
    in property <bool> emphasis: false;
    width: 72px;
    height: 26px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-sm;
        background: root.has-hover ? Theme.bg-card-hover : transparent;
        border-width: root.emphasis ? 1px : 0px;
        border-color: Theme.border-light;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: root.emphasis ? Theme.accent-cyan : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// The four quadrant buttons for placing one task.
component PlaceButtons inherits HorizontalLayout {
    in property <string> task-id;
    spacing: 3px;

    TextAction { width: 48px; label: "ASAP"; clicked => { MatrixState.place-task(root.task-id, "do_asap"); } }
    TextAction { width: 48px; label: "Later"; clicked => { MatrixState.place-task(root.task-id, "do_later_today"); } }
    TextAction { width: 48px; label: "Week"; clicked => { MatrixState.place-task(root.task-id, "do_mid_week"); } }
    TextAction { width: 48px; label: "Leave"; clicked => { MatrixState.place-task(root.task-id, "leave_till_end"); } }
}

/// A task inside a quadrant, with a control to take it back out.
component QuadrantTaskRow inherits Rectangle {
    in property <TaskModel> task;

    height: 40px;
    background: Theme.bg-card;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        Text {
            text: root.task.title;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-primary;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        TextAction { width: 56px; label: "Clear"; clicked => { MatrixState.place-task(root.task.id, ""); } }
    }
}

/// One quadrant panel with its heading, count, review action and tasks.
component Quadrant inherits Rectangle {
    in property <string> quadrant-id;
    in property <string> heading;
    in property <string> hint;
    in property <color> accent;
    in property <[TaskModel]> items;

    background: Theme.bg-panel;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: 8px;
                border-radius: 4px;
                background: root.accent;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: root.heading + "  (" + root.items.length + ")";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: root.hint;
                    font-size: 10px;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
            TextAction {
                width: 64px;
                label: "Review";
                clicked => { MatrixState.review-quadrant(root.quadrant-id); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                for task in root.items: QuadrantTaskRow { task: task; }
                if root.items.length == 0: Text {
                    text: "Nothing here yet.";
                    font-size: 11px;
                    color: Theme.text-muted;
                }
            }
        }
    }
}

/// MatrixScreen: the four quadrants, the unsorted rail and the review card.
export component MatrixScreen inherits Rectangle {
    background: transparent;

    init => { MatrixState.request-refresh(); }

    HorizontalLayout {
        // Review rail
        Rectangle {
            width: 260px;
            background: Theme.bg-sidebar;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Unsorted  (" + MatrixState.unsorted-count + ")";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    TextAction {
                        width: 84px;
                        label: "Review all";
                        emphasis: true;
                        clicked => { MatrixState.start-review(); }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        if MatrixState.unsorted-today.length > 0: Text {
                            text: "Today";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        for task in MatrixState.unsorted-today: VerticalLayout {
                            spacing: 4px;
                            Text { text: task.title; font-size: 12px; color: Theme.text-primary; overflow: elide; }
                            PlaceButtons { task-id: task.id; }
                        }

                        if MatrixState.unsorted-this-week.length > 0: Text {
                            text: "This Week";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        for task in MatrixState.unsorted-this-week: VerticalLayout {
                            spacing: 4px;
                            Text { text: task.title; font-size: 12px; color: Theme.text-primary; overflow: elide; }
                            PlaceButtons { task-id: task.id; }
                        }

                        if MatrixState.unsorted-backlog.length > 0: Text {
                            text: "Backlog";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        for task in MatrixState.unsorted-backlog: VerticalLayout {
                            spacing: 4px;
                            Text { text: task.title; font-size: 12px; color: Theme.text-primary; overflow: elide; }
                            PlaceButtons { task-id: task.id; }
                        }

                        if MatrixState.unsorted-count == 0: Text {
                            text: "Every task has a place.";
                            font-size: 12px;
                            color: Theme.text-muted;
                        }
                    }
                }
            }
        }

        // Quadrants
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 16px;
            padding-bottom: ShellState.content-bottom-inset;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Matrix";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                TextAction { width: 60px; label: "Undo"; clicked => { MatrixState.undo(); } }
                TextAction { width: 60px; label: "Redo"; clicked => { MatrixState.redo(); } }
            }

            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;
                    Quadrant {
                        quadrant-id: "do_asap";
                        heading: "Do ASAP";
                        hint: "Today, urgent and important";
                        accent: Theme.destructive;
                        items: MatrixState.do-asap;
                        vertical-stretch: 1;
                    }
                    Quadrant {
                        quadrant-id: "do_mid_week";
                        heading: "Do Mid Week";
                        hint: "This week, important";
                        accent: Theme.accent-blue;
                        items: MatrixState.do-mid-week;
                        vertical-stretch: 1;
                    }
                }
                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;
                    Quadrant {
                        quadrant-id: "do_later_today";
                        heading: "Do Later Today";
                        hint: "Today, important";
                        accent: Theme.accent-amber;
                        items: MatrixState.do-later-today;
                        vertical-stretch: 1;
                    }
                    Quadrant {
                        quadrant-id: "leave_till_end";
                        heading: "Leave Till End";
                        hint: "Backlog, low value";
                        accent: Theme.text-muted;
                        items: MatrixState.leave-till-end;
                        vertical-stretch: 1;
                    }
                }
            }
        }
    }

    // Review card: prioritize one by one.
    if MatrixState.review-open: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000b0;

        TouchArea { clicked => { MatrixState.close-review(); } }

        Rectangle {
            width: 420px;
            height: 260px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg-card-selected;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-light;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: "Prioritize one by one  (" + MatrixState.review-remaining + " left)";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text-muted;
                        horizontal-stretch: 1;
                    }
                    TextAction { width: 60px; label: "Close"; clicked => { MatrixState.close-review(); } }
                }

                Text {
                    text: MatrixState.review-task.title;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 6px;
                    TextAction { label: "Do ASAP"; clicked => { MatrixState.place-task(MatrixState.review-task.id, "do_asap"); } }
                    TextAction { label: "Later Today"; clicked => { MatrixState.place-task(MatrixState.review-task.id, "do_later_today"); } }
                    TextAction { label: "Mid Week"; clicked => { MatrixState.place-task(MatrixState.review-task.id, "do_mid_week"); } }
                    TextAction { label: "Leave"; clicked => { MatrixState.place-task(MatrixState.review-task.id, "leave_till_end"); } }
                }

                HorizontalLayout {
                    alignment: end;
                    TextAction { label: "Skip"; clicked => { MatrixState.next-review-task(); } }
                }
            }
        }
    }
}
