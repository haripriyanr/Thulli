import { Theme } from "../theme.slint";
import { ShellState } from "../shell_state.slint";
import { ThulliEmptyState } from "../components/empty_state.slint";
import { IconNote, IconFolder, IconInbox, IconTrash, IconStar, IconCalendar, IconPlus, IconClose, IconArrowRight } from "../icons.slint";
import { NoteModel, NoteFolderModel, QuickCaptureModel, MeetingNoteModel, BragModel, ChoiceModel } from "../types.slint";
import { NoteBlockModel, SlashItemModel, ThulliNoteField, ThulliGhostButton, ThulliNoteNavItem, ThulliNoteBlockRow } from "../components/notes_widgets.slint";

export { NoteBlockModel, SlashItemModel }

/// State and callbacks for the notes screen. The screen owner edits this
/// global freely; the shell re-exports it, so app.slint does not change.
export global NotesState {
    /// "all", "unsorted", "trash", "quick-capture", "meetings", "brag-book" or a folder id.
    in-out property <string> section: "all";
    in-out property <[NoteModel]> notes: [];
    in-out property <[NoteFolderModel]> folders: [];
    in-out property <[QuickCaptureModel]> captures: [];
    in-out property <[MeetingNoteModel]> meetings: [];
    in-out property <[BragModel]> brags: [];
    in-out property <string> open-note-id: "";

    // Counts for the sidebar
    in-out property <int> all-count: 0;
    in-out property <int> unsorted-count: 0;
    in-out property <int> trash-count: 0;

    // The open item (a note or a meeting)
    /// "note", "meeting" or "" when nothing is open.
    in-out property <string> open-kind: "";
    in-out property <string> open-title: "";
    in-out property <string> open-stamp: "";
    in-out property <int> open-backlinks: 0;
    in-out property <string> open-task-title: "";
    in-out property <bool> open-in-trash: false;
    in-out property <bool> open-ended: false;
    in-out property <string> open-folder-name: "Unsorted";
    in-out property <[NoteBlockModel]> blocks: [];
    /// Which block should hold the cursor; `focus-serial` changes to re-apply it.
    in-out property <int> focus-block: -1;
    in-out property <int> focus-serial: 0;
    in-out property <int> focus-cursor: -1;

    // Slash command menu (hidden while `slash-block` is -1)
    in-out property <int> slash-block: -1;
    in-out property <[SlashItemModel]> slash-items: [];

    // Link prompt and pickers
    in-out property <int> link-block: -1;
    in-out property <string> link-text: "";
    in-out property <[ChoiceModel]> folder-choices: [];
    in-out property <[ChoiceModel]> task-choices: [];
    in-out property <string> message: "";

    callback new-note();
    callback new-folder(string);
    callback open-note(string);
    callback save-note(string, string, string);   // id, title, body
    callback trash-note(string);
    callback restore-note(string);
    callback add-capture(string);
    callback add-brag(string);
    callback task-from-selection(string);

    callback select-section(string);
    callback title-edited(string);
    callback delete-note-forever(string);
    callback empty-trash();
    callback delete-folder(string);
    callback move-note(string, string);            // note id, folder id ("" = Unsorted)
    callback link-task(string);                    // task id ("" = unlink)
    callback prepare-pickers();

    callback block-edited(int, string);
    callback block-enter(int, int);                // index, cursor byte offset
    callback block-backspace-start(int) -> bool;
    callback block-indent(int);
    callback block-outdent(int);
    callback block-toggle-todo(int);
    callback block-checked(int, bool);
    callback block-task-from-selection(int, int, int);   // index, anchor, cursor
    callback block-link-request(int, int, int);          // index, anchor, cursor
    callback block-add-link(int, string, string);        // index, text, url
    callback slash-apply(int, string);
    callback slash-dismiss();

    callback capture-to-task(string);
    callback capture-to-note(string);
    callback delete-capture(string);
    callback start-meeting();
    callback end-meeting(string);
    callback delete-meeting(string);
    callback open-meeting(string);
    callback delete-brag(string);
    callback open-floating-notes();
    callback open-quick-capture();
}

/// Section header for the editor pane buttons.
component SectionTitle inherits Text {
    font-size: 20px;
    font-weight: 700;
    color: Theme.text-primary;
}

/// The note or meeting editor: title, header facts, actions and the block list.
component NoteEditorPane inherits Rectangle {
    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    property <bool> in-trash: NotesState.open-in-trash;
    property <bool> is-meeting: NotesState.open-kind == "meeting";

    VerticalLayout {
        padding: 18px;
        spacing: 10px;

        // Title
        title-box := Rectangle {
            height: 34px;
            title-input := TextInput {
                width: 100%;
                height: 100%;
                text: NotesState.open-title;
                font-size: 22px;
                font-weight: 700;
                color: Theme.text-primary;
                single-line: true;
                read-only: root.in-trash;
                vertical-alignment: center;
                selection-background-color: #3CC9C455;
                edited => {
                    NotesState.title-edited(self.text);
                }
                accepted => {
                    NotesState.focus-block = 0;
                    NotesState.focus-cursor = 0;
                    NotesState.focus-serial += 1;
                }
            }
            Text {
                text: "Untitled";
                font-size: 22px;
                font-weight: 700;
                color: Theme.text-muted;
                visible: title-input.text == "";
                vertical-alignment: center;
            }
        }

        // Header facts and actions
        HorizontalLayout {
            spacing: 10px;
            height: 28px;

            Text {
                text: NotesState.open-stamp;
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            Text {
                text: "\u{00B7}  " + NotesState.open-backlinks + (NotesState.open-backlinks == 1 ? " backlink" : " backlinks");
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
                visible: !root.is-meeting;
                width: root.is-meeting ? 0px : self.preferred-width;
            }
            if NotesState.open-task-title != "": Text {
                text: "\u{00B7}  Task: " + NotesState.open-task-title;
                font-size: 12px;
                color: Theme.accent-cyan;
                vertical-alignment: center;
                overflow: elide;
                min-width: 0px;
            }
            Rectangle { }

            if !root.is-meeting && !root.in-trash: folder-btn := ThulliGhostButton {
                text: NotesState.open-folder-name;
                clicked => {
                    NotesState.prepare-pickers();
                    folder-popup.show();
                }
            }
            if !root.is-meeting && !root.in-trash: task-btn := ThulliGhostButton {
                text: NotesState.open-task-title == "" ? "Link task" : "Change task";
                clicked => {
                    NotesState.prepare-pickers();
                    task-popup.show();
                }
            }
            if is-meeting && !NotesState.open-ended: ThulliGhostButton {
                text: "End meeting";
                clicked => {
                    NotesState.end-meeting(NotesState.open-note-id);
                }
            }
            if !root.in-trash: ThulliGhostButton {
                text: root.is-meeting ? "Delete" : "Move to Trash";
                danger: true;
                clicked => {
                    if (root.is-meeting) {
                        NotesState.delete-meeting(NotesState.open-note-id);
                    } else {
                        NotesState.trash-note(NotesState.open-note-id);
                    }
                }
            }
            if root.in-trash: ThulliGhostButton {
                text: "Restore";
                clicked => {
                    NotesState.restore-note(NotesState.open-note-id);
                }
            }
            if root.in-trash: ThulliGhostButton {
                text: "Delete forever";
                danger: true;
                clicked => {
                    NotesState.delete-note-forever(NotesState.open-note-id);
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        if NotesState.message != "": Text {
            text: NotesState.message;
            font-size: 12px;
            color: Theme.accent-green;
        }

        // Link prompt (Ctrl+Alt+K)
        if NotesState.link-block >= 0: Rectangle {
            height: 40px;
            HorizontalLayout {
                spacing: 8px;
                alignment: stretch;
                link-field := ThulliNoteField {
                    placeholder: "Paste a web address and press Enter";
                    submitted(url) => {
                        NotesState.block-add-link(NotesState.link-block, NotesState.link-text, url);
                    }
                    cancelled => {
                        NotesState.link-block = -1;
                    }
                    init => {
                        self.focus-field();
                    }
                }
                ThulliGhostButton {
                    text: "Cancel";
                    clicked => {
                        NotesState.link-block = -1;
                    }
                }
            }
        }

        // Blocks
        Flickable {
            content-height: block-list.preferred-height + 120px;
            block-list := VerticalLayout {
                alignment: start;
                spacing: 1px;

                for block[i] in NotesState.blocks: ThulliNoteBlockRow {
                    block: block;
                    index: i;
                    is-target: i == NotesState.focus-block;
                    focus-serial: NotesState.focus-serial;
                    focus-cursor: NotesState.focus-cursor;
                    read-only: root.in-trash;
                    slash-open: NotesState.slash-block == i;
                    text-edited(t) => {
                        NotesState.block-edited(i, t);
                    }
                    enter-pressed(cursor) => {
                        NotesState.block-enter(i, cursor);
                    }
                    backspace-at-start => {
                        return NotesState.block-backspace-start(i);
                    }
                    indent => {
                        NotesState.block-indent(i);
                    }
                    outdent => {
                        NotesState.block-outdent(i);
                    }
                    toggle-todo => {
                        NotesState.block-toggle-todo(i);
                    }
                    checked-changed(c) => {
                        NotesState.block-checked(i, c);
                    }
                    task-from-selection(a, c) => {
                        NotesState.block-task-from-selection(i, a, c);
                    }
                    add-link-requested(a, c) => {
                        NotesState.block-link-request(i, a, c);
                    }
                    slash-accept => {
                        if (NotesState.slash-items.length > 0) {
                            NotesState.slash-apply(i, NotesState.slash-items[0].id);
                        }
                    }
                    slash-dismiss => {
                        NotesState.slash-dismiss();
                    }
                }

                // Click below the last block to keep typing there.
                TouchArea {
                    height: 60px;
                    clicked => {
                        NotesState.focus-block = NotesState.blocks.length - 1;
                        NotesState.focus-cursor = -1;
                        NotesState.focus-serial += 1;
                    }
                }
            }
        }
    }

    folder-popup := PopupWindow {
        x: root.width - 470px;
        y: 96px;
        width: 180px;
        Rectangle {
            background: Theme.bg-panel;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-light;
            VerticalLayout {
                padding: 4px;
                for choice in NotesState.folder-choices: TouchArea {
                    height: 28px;
                    clicked => {
                        NotesState.move-note(NotesState.open-note-id, choice.id);
                    }
                    Rectangle {
                        background: parent.has-hover ? Theme.bg-card-hover : transparent;
                        border-radius: 4px;
                        Text {
                            x: 8px;
                            text: choice.label;
                            font-size: 12px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    task-popup := PopupWindow {
        x: root.width - 290px;
        y: 96px;
        width: 260px;
        Rectangle {
            background: Theme.bg-panel;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-light;
            VerticalLayout {
                padding: 4px;
                for choice in NotesState.task-choices: TouchArea {
                    height: 28px;
                    clicked => {
                        NotesState.link-task(choice.id);
                    }
                    Rectangle {
                        background: parent.has-hover ? Theme.bg-card-hover : transparent;
                        border-radius: 4px;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: choice.label;
                            font-size: 12px;
                            color: choice.id == "" ? Theme.text-secondary : Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // Slash command menu
    if NotesState.slash-block >= 0 && NotesState.slash-items.length > 0: Rectangle {
        x: 18px;
        y: parent.height - self.height - 18px;
        width: 260px;
        height: NotesState.slash-items.length * 40px + 8px;
        background: Theme.bg-panel;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;

        VerticalLayout {
            padding: 4px;
            for item[n] in NotesState.slash-items: TouchArea {
                height: 40px;
                clicked => {
                    NotesState.slash-apply(NotesState.slash-block, item.id);
                }
                Rectangle {
                    background: parent.has-hover || n == 0 ? Theme.bg-card-hover : transparent;
                    border-radius: 6px;
                    VerticalLayout {
                        padding-left: 10px;
                        alignment: center;
                        Text {
                            text: item.label;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: item.hint;
                            font-size: 11px;
                            color: Theme.text-muted;
                        }
                    }
                }
            }
        }
    }
}

/// The scrolling list of notes (or meetings) beside the editor.
component NoteListPane inherits Rectangle {
    in property <bool> meetings: false;

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            height: 30px;
            SectionTitle {
                text: root.meetings ? "Meeting notes" : (NotesState.section == "trash" ? "Trash" : (NotesState.section == "unsorted" ? "Unsorted" : (NotesState.section == "all" ? "All notes" : "Notes")));
                font-size: 16px;
                vertical-alignment: center;
            }
            Rectangle { }
            if NotesState.section == "trash" && NotesState.trash-count > 0: ThulliGhostButton {
                text: "Empty Trash";
                danger: true;
                clicked => {
                    NotesState.empty-trash();
                }
            }
            if NotesState.section != "trash" && !root.meetings: ThulliGhostButton {
                text: "New note";
                clicked => {
                    NotesState.new-note();
                }
            }
            if root.meetings: ThulliGhostButton {
                text: "Start meeting";
                clicked => {
                    NotesState.start-meeting();
                }
            }
        }

        Flickable {
            content-height: rows.preferred-height;
            rows := VerticalLayout {
                alignment: start;
                spacing: 6px;

                if !root.meetings: VerticalLayout {
                    spacing: 6px;
                    for note in NotesState.notes: TouchArea {
                        height: 66px;
                        clicked => {
                            NotesState.open-note(note.id);
                        }
                        Rectangle {
                            background: note.id == NotesState.open-note-id ? Theme.bg-card-selected : (parent.has-hover ? Theme.bg-card-hover : Theme.bg-card);
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: note.id == NotesState.open-note-id ? Theme.accent-cyan : Theme.border-subtle;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text {
                                    text: note.title == "" ? "Untitled" : note.title;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: note.preview == "" ? "No content yet" : note.preview;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                                Text {
                                    text: note.updated-label + (note.backlink-count > 0 ? "  \u{00B7}  " + note.backlink-count + " backlinks" : "");
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                }
                            }
                        }
                    }
                }

                if root.meetings: VerticalLayout {
                    spacing: 6px;
                    for meeting in NotesState.meetings: TouchArea {
                        height: 56px;
                        clicked => {
                            NotesState.open-meeting(meeting.id);
                        }
                        Rectangle {
                            background: meeting.id == NotesState.open-note-id ? Theme.bg-card-selected : (parent.has-hover ? Theme.bg-card-hover : Theme.bg-card);
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: meeting.id == NotesState.open-note-id ? Theme.accent-cyan : Theme.border-subtle;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text {
                                    text: meeting.title == "" ? "Meeting" : meeting.title;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: meeting.started-label;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Quick Capture inbox: a scratch list with an add row.
component CapturePane inherits VerticalLayout {
    spacing: 10px;
    SectionTitle {
        text: "Quick Capture";
    }
    Text {
        text: "Jot anything down now. Turn it into a task or a note when you are ready.";
        font-size: 12px;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    ThulliNoteField {
        placeholder: "Capture a thought and press Enter";
        submitted(text) => {
            NotesState.add-capture(text);
        }
    }
    Flickable {
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            alignment: start;
            spacing: 6px;
            for c in NotesState.captures: Rectangle {
                height: 48px;
                background: Theme.bg-card;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                opacity: c.processed ? 0.55 : 1.0;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: c.text;
                            font-size: 13px;
                            color: Theme.text-primary;
                            overflow: elide;
                        }
                        Text {
                            text: c.processed ? c.created-label + "  \u{00B7}  Sorted" : c.created-label;
                            font-size: 11px;
                            color: Theme.text-muted;
                        }
                    }
                    if !c.processed: ThulliGhostButton {
                        y: 10px;
                        text: "To task";
                        clicked => {
                            NotesState.capture-to-task(c.id);
                        }
                    }
                    if !c.processed: ThulliGhostButton {
                        y: 10px;
                        text: "To note";
                        clicked => {
                            NotesState.capture-to-note(c.id);
                        }
                    }
                    TouchArea {
                        width: 28px;
                        height: 28px;
                        y: 10px;
                        clicked => {
                            NotesState.delete-capture(c.id);
                        }
                        IconTrash {
                            width: 14px;
                            height: 14px;
                            x: 7px;
                            y: 7px;
                        }
                    }
                }
            }
        }
    }
}

/// Brag Book: dated accomplishments with an add row.
component BragPane inherits VerticalLayout {
    spacing: 10px;
    SectionTitle {
        text: "Brag Book";
    }
    Text {
        text: "Keep a record of what you have accomplished. Start with a date such as 2026-03-04 to back-date an entry.";
        font-size: 12px;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    ThulliNoteField {
        placeholder: "What did you accomplish?";
        submitted(text) => {
            NotesState.add-brag(text);
        }
    }
    Flickable {
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            alignment: start;
            spacing: 6px;
            for b in NotesState.brags: Rectangle {
                height: 44px;
                background: Theme.bg-card;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 12px;
                    IconStar {
                        width: 16px;
                        height: 16px;
                        y: 14px;
                    }
                    Text {
                        text: b.date-label;
                        font-size: 12px;
                        color: Theme.accent-amber;
                        font-weight: 600;
                        vertical-alignment: center;
                        width: 90px;
                    }
                    Text {
                        text: b.text;
                        font-size: 13px;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TouchArea {
                        width: 28px;
                        height: 28px;
                        y: 8px;
                        clicked => {
                            NotesState.delete-brag(b.id);
                        }
                        IconTrash {
                            width: 14px;
                            height: 14px;
                            x: 7px;
                            y: 7px;
                        }
                    }
                }
            }
        }
    }
}

/// NotesScreen: sidebar of sections and folders, a list, and the editor.
export component NotesScreen inherits Rectangle {
    background: transparent;

    property <string> section: NotesState.section;
    property <bool> new-folder-open: false;
    property <bool> notes-section: root.section != "quick-capture" && root.section != "brag-book" && root.section != "meetings";

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 14px;
        padding-bottom: ShellState.content-bottom-inset;
        spacing: 16px;

        // Sidebar
        Rectangle {
            width: 210px;
            VerticalLayout {
                spacing: 4px;
                alignment: start;

                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Text {
                        text: "Notes";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                ThulliNoteNavItem {
                    label: "All notes";
                    count: NotesState.all-count;
                    selected: root.section == "all";
                    clicked => {
                        NotesState.select-section("all");
                    }
                    IconNote {
                        width: 15px;
                        height: 15px;
                    }
                }
                ThulliNoteNavItem {
                    label: "Unsorted";
                    count: NotesState.unsorted-count;
                    selected: root.section == "unsorted";
                    clicked => {
                        NotesState.select-section("unsorted");
                    }
                    IconInbox {
                        width: 15px;
                        height: 15px;
                    }
                }

                HorizontalLayout {
                    height: 30px;
                    padding-left: 10px;
                    Text {
                        text: "FOLDERS";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                    TouchArea {
                        width: 26px;
                        height: 26px;
                        clicked => {
                            root.new-folder-open = !root.new-folder-open;
                        }
                        IconPlus {
                            width: 14px;
                            height: 14px;
                            x: 6px;
                            y: 6px;
                        }
                    }
                }

                if root.new-folder-open: ThulliNoteField {
                    placeholder: "Folder name";
                    submitted(name) => {
                        NotesState.new-folder(name);
                        root.new-folder-open = false;
                    }
                    cancelled => {
                        root.new-folder-open = false;
                    }
                    init => {
                        self.focus-field();
                    }
                }

                for folder in NotesState.folders: ThulliNoteNavItem {
                    label: folder.name;
                    count: folder.note-count;
                    selected: root.section == folder.id;
                    removable: true;
                    clicked => {
                        NotesState.select-section(folder.id);
                    }
                    remove => {
                        NotesState.delete-folder(folder.id);
                    }
                    IconFolder {
                        width: 15px;
                        height: 15px;
                    }
                }

                Rectangle {
                    height: 10px;
                }

                ThulliNoteNavItem {
                    label: "Quick Capture";
                    selected: root.section == "quick-capture";
                    clicked => {
                        NotesState.select-section("quick-capture");
                    }
                    IconInbox {
                        width: 15px;
                        height: 15px;
                        stroke-color: Theme.accent-cyan;
                    }
                }
                ThulliNoteNavItem {
                    label: "Meeting Notes";
                    selected: root.section == "meetings";
                    clicked => {
                        NotesState.select-section("meetings");
                    }
                    IconCalendar {
                        width: 15px;
                        height: 15px;
                    }
                }
                ThulliNoteNavItem {
                    label: "Brag Book";
                    selected: root.section == "brag-book";
                    clicked => {
                        NotesState.select-section("brag-book");
                    }
                    IconStar {
                        width: 15px;
                        height: 15px;
                    }
                }
                ThulliNoteNavItem {
                    label: "Trash";
                    count: NotesState.trash-count;
                    selected: root.section == "trash";
                    clicked => {
                        NotesState.select-section("trash");
                    }
                    IconTrash {
                        width: 15px;
                        height: 15px;
                    }
                }

                Rectangle {
                    height: 10px;
                }
                ThulliGhostButton {
                    text: "Floating notes";
                    clicked => {
                        NotesState.open-floating-notes();
                    }
                }
                ThulliGhostButton {
                    text: "Quick capture window";
                    clicked => {
                        NotesState.open-quick-capture();
                    }
                }
            }
        }

        // Content
        if root.notes-section || root.section == "meetings": NoteListPane {
            width: 260px;
            meetings: root.section == "meetings";
        }

        if root.section == "quick-capture": CapturePane { }
        if root.section == "brag-book": BragPane { }

        if (root.notes-section || root.section == "meetings") && NotesState.open-kind != "": NoteEditorPane { }

        if (root.notes-section || root.section == "meetings") && NotesState.open-kind == "": ThulliEmptyState {
            title: root.section == "trash" ? "Trash is empty" : (root.section == "meetings" ? "No meeting open" : "Pick a note to start");
            subtitle: root.section == "meetings" ? "Start a meeting to capture notes as you go." : "Choose a note from the list, or create a new one.";

            IconNote {
                width: 44px;
                height: 44px;
            }
        }
    }
}

/// Small always-on-top window: the notes for the current task, plus a quick
/// capture inbox. It has its own properties because a second window does not
/// share `NotesState`.
export component FloatingNotesWindow inherits Window {
    title: "Thulli notes";
    no-frame: true;
    always-on-top: true;
    width: 340px;
    height: 460px;
    background: Theme.bg-canvas;

    /// "notes" or "capture".
    in-out property <string> mode: "notes";
    in-out property <string> note-title: "";
    in-out property <string> note-body: "";
    in-out property <string> task-title: "";
    in-out property <[QuickCaptureModel]> captures: [];

    callback body-edited(string);
    callback capture-added(string);
    callback capture-to-task(string);
    callback capture-deleted(string);
    callback close-requested();
    callback drag-started();

    Rectangle {
        background: Theme.bg-canvas;
        border-width: 1px;
        border-color: Theme.border-light;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            Rectangle {
                height: 28px;
                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.drag-started();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    ThulliGhostButton {
                        text: "Notes";
                        active: root.mode == "notes";
                        clicked => {
                            root.mode = "notes";
                        }
                    }
                    ThulliGhostButton {
                        text: "Capture";
                        active: root.mode == "capture";
                        clicked => {
                            root.mode = "capture";
                        }
                    }
                    Rectangle { }
                    TouchArea {
                        width: 28px;
                        height: 28px;
                        clicked => {
                            root.close-requested();
                        }
                        IconClose {
                            width: 14px;
                            height: 14px;
                            x: 7px;
                            y: 7px;
                        }
                    }
                }
            }

            if root.mode == "notes": VerticalLayout {
                spacing: 8px;
                Text {
                    text: root.task-title == "" ? "Notes" : root.note-title;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: root.task-title == "" ? "No task is running. Start a task to see its notes here." : "Notes for " + root.task-title;
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                if root.task-title != "": Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    body-input := TextInput {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        text: root.note-body;
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Theme.text-primary;
                        selection-background-color: #3CC9C455;
                        edited => {
                            root.body-edited(self.text);
                        }
                    }
                }
            }

            if root.mode == "capture": VerticalLayout {
                spacing: 8px;
                ThulliNoteField {
                    placeholder: "Capture a thought";
                    submitted(text) => {
                        root.capture-added(text);
                    }
                }
                Flickable {
                    content-height: capture-rows.preferred-height;
                    capture-rows := VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        for c in root.captures: Rectangle {
                            height: 40px;
                            background: Theme.bg-card;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            opacity: c.processed ? 0.55 : 1.0;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 6px;
                                spacing: 6px;
                                Text {
                                    text: c.text;
                                    font-size: 12px;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if !c.processed: TouchArea {
                                    width: 28px;
                                    height: 28px;
                                    y: 6px;
                                    clicked => {
                                        root.capture-to-task(c.id);
                                    }
                                    IconArrowRight {
                                        width: 14px;
                                        height: 14px;
                                        x: 7px;
                                        y: 7px;
                                    }
                                }
                                TouchArea {
                                    width: 28px;
                                    height: 28px;
                                    y: 6px;
                                    clicked => {
                                        root.capture-deleted(c.id);
                                    }
                                    IconTrash {
                                        width: 14px;
                                        height: 14px;
                                        x: 7px;
                                        y: 7px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
