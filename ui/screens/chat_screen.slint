import { Theme } from "../theme.slint";
import { IconChat, IconArrowRight, IconCheck, IconClose, IconCopy, IconEdit, IconFork, IconTrash, IconChevronLeft, IconChevronRight, IconSearch } from "../icons.slint";
import { GlassCard } from "../components/glass.slint";
import { GoalButton, GoalChoice } from "../components/goal_widgets.slint";
import { MicButton } from "../components/space_widgets.slint";
import { HoverTip } from "../components/tips.slint";
import { ThinkingBar, ScrollToBottomButton, BorderBeam, VoiceRing, TraceLine } from "../components/ai_kit.slint";
import { ChatMessageModel, ChoiceModel } from "../types.slint";
import { AppData } from "../app_data.slint";

/// A small round icon button.
component MsgIcon inherits Rectangle {
    in property <bool> active: true;
    in property <color> tint: transparent;
    in property <string> tip;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    opacity: root.active ? 1 : 0;
    background: root.tint != transparent ? root.tint : (touch.pressed ? Theme.glass-fill-strong : (touch.has-hover ? Theme.glass-fill-hover : transparent));
    animate background { duration: 150ms; easing: ease-out; }
    animate opacity { duration: 150ms; easing: ease-out; }
    @children
    touch := TouchArea { enabled: root.active; mouse-cursor: pointer; clicked => { root.clicked(); } }
    HoverTip { tip: root.tip; hovered: touch.has-hover; pressed: touch.pressed; }
}

/// One message with its day header, bubble and footer. The person's messages
/// sit on the right; "edit" turns the bubble itself into the input. Replies
/// sit on the left and can be forked from; after an edit the older replies
/// stay readable with the arrows. The bubble width follows the text (up to
/// `max-w`); a hidden copy of the text measures it so the bubble never
/// depends on its own size.
component MessageRow inherits Rectangle {
    in property <ChatMessageModel> m;
    in property <length> max-w;
    callback edited(string);
    callback copy(string);
    callback fork();

    property <int> count: root.m.versions.length + 1;
    // Which reply is on show; -1 means the newest.
    property <int> pick: -1;
    property <int> cur: root.pick < 0 ? root.count - 1 : min(root.pick, root.count - 1);
    property <string> shown: root.cur == root.count - 1 ? root.m.text : root.m.versions[root.cur];
    property <bool> editing: false;
    property <string> ed;
    property <length> bubble-w: root.editing ? root.max-w : min(root.max-w, measure.preferred-width + 28px);
    height: col.preferred-height;

    function start-edit() {
        root.ed = root.m.text;
        root.editing = true;
        ei.focus();
    }
    function submit() {
        if root.ed != "" && root.ed != root.m.text {
            root.edited(root.ed);
        }
        root.editing = false;
    }

    measure := Text { text: root.shown; font-size: 14px; visible: false; }

    col := VerticalLayout {
        spacing: 4px;
        if root.m.day-kind != "": Text {
            text: root.m.day-kind == "today" ? @tr("Today") : (root.m.day-kind == "yesterday" ? @tr("Yesterday") : root.m.day-date);
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
        Rectangle {
            height: bubble.height;
            bubble := Rectangle {
                x: root.m.from-user ? parent.width - self.width : 0px;
                width: root.bubble-w;
                height: (root.editing ? ei.preferred-height : msg.preferred-height) + 20px;
                border-radius: 16px;
                background: root.m.from-user ? Theme.accent-violet.with-alpha(root.editing ? 0.4 : 0.28) : Theme.glass-fill;
                border-width: 1px;
                border-color: root.editing ? Theme.accent-violet : (root.m.from-user ? Theme.accent-violet.with-alpha(0.5) : Theme.glass-border);
                animate width { duration: 220ms; easing: ease-out; }
                animate height { duration: 220ms; easing: ease-out; }
                animate background { duration: 220ms; easing: ease-out; }
                animate border-color { duration: 220ms; easing: ease-out; }
                msg := Text {
                    x: 14px;
                    y: 10px;
                    width: parent.width - 28px;
                    visible: !root.editing;
                    text: root.shown;
                    font-size: 14px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                ei := TextInput {
                    x: 14px;
                    y: 10px;
                    width: parent.width - 28px;
                    visible: root.editing;
                    enabled: root.editing;
                    text <=> root.ed;
                    font-size: 14px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                    single-line: false;
                    key-pressed(event) => {
                        if event.text == Key.Escape { root.editing = false; return accept; }
                        if event.text == Key.Return && !event.modifiers.shift { root.submit(); return accept; }
                        return reject;
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: root.m.from-user ? end : start;
            spacing: 2px;
            padding-left: 4px;
            padding-right: 4px;
            Text { text: root.m.time; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
            // Room between the time and the actions.
            Rectangle { width: 10px; }
            if root.count > 1 && !root.editing: HorizontalLayout {
                spacing: 4px;
                MsgIcon { tip: @tr("Previous version"); active: root.cur > 0; clicked => { root.pick = root.cur - 1; } IconChevronLeft { x: 7px; y: 7px; width: 14px; height: 14px; stroke-color: Theme.text-secondary; } }
                Text { text: "\{root.cur + 1}/\{root.count}"; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; }
                MsgIcon { tip: @tr("Next version"); active: root.cur < root.count - 1; clicked => { root.pick = root.cur + 1; } IconChevronRight { x: 7px; y: 7px; width: 14px; height: 14px; stroke-color: Theme.text-secondary; } }
            }
            if !root.editing: MsgIcon { tip: @tr("Copy"); clicked => { root.copy(root.shown); } IconCopy { x: 6px; y: 6px; } }
            if root.m.from-user && !root.editing: MsgIcon { tip: @tr("Edit"); clicked => { root.start-edit(); } IconEdit { x: 6px; y: 6px; } }
            if !root.m.from-user: MsgIcon { tip: @tr("Fork from here"); clicked => { root.fork(); } IconFork { x: 6px; y: 6px; } }
            if root.editing: MsgIcon { tip: @tr("Cancel"); clicked => { root.editing = false; } IconClose { x: 7px; y: 7px; width: 14px; height: 14px; stroke-color: Theme.text-secondary; } }
            if root.editing: MsgIcon { tip: @tr("Save"); tint: Theme.accent-violet.with-alpha(0.45); clicked => { root.submit(); } IconCheck { x: 7px; y: 7px; width: 14px; height: 14px; stroke-color: Theme.text-primary; } }
        }
    }
}

/// A conversation in the list. Fork and delete appear on hover; delete asks
/// once more by turning red.
component ThreadTile inherits Rectangle {
    in property <string> id;
    in property <string> title;
    in property <string> label;
    in property <bool> selected;
    callback open();
    callback fork();
    callback delete();

    property <bool> over: tile-touch.has-hover || fork-touch.has-hover || del-touch.has-hover;
    property <bool> confirm: false;
    changed over => { if !root.over { root.confirm = false; } }
    height: 52px;
    border-radius: 12px;
    background: root.selected ? Theme.glass-fill-strong : (root.over ? Theme.glass-fill-hover : transparent);
    animate background { duration: 150ms; easing: ease-out; }

    tile-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 4px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text { text: root.title == "" ? @tr("New chat") : root.title; font-size: 13px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
            Text { text: root.label; font-size: 11px; color: Theme.text-muted; }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 0px;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    opacity: root.over ? 1 : 0;
                    background: fork-touch.has-hover ? Theme.glass-fill-strong : transparent;
                    animate opacity { duration: 150ms; easing: ease-out; }
                    IconFork { x: 6px; y: 6px; }
                    fork-touch := TouchArea { enabled: root.over; mouse-cursor: pointer; clicked => { root.fork(); } }
                    HoverTip { tip: @tr("Fork this chat"); hovered: fork-touch.has-hover; pressed: fork-touch.pressed; }
                }
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    opacity: root.over ? 1 : 0;
                    background: root.confirm ? Theme.destructive.with-alpha(0.35) : (del-touch.has-hover ? Theme.glass-fill-strong : transparent);
                    animate opacity { duration: 150ms; easing: ease-out; }
                    animate background { duration: 150ms; easing: ease-out; }
                    IconTrash { x: 6px; y: 6px; }
                    del-touch := TouchArea {
                        enabled: root.over;
                        mouse-cursor: pointer;
                        clicked => {
                            if root.confirm { root.delete(); root.confirm = false; } else { root.confirm = true; }
                        }
                    }
                    HoverTip { tip: root.confirm ? @tr("Click again to delete") : @tr("Delete chat"); hovered: del-touch.has-hover; pressed: del-touch.pressed; }
                }
            }
        }
    }
}

/// ChatScreen: talk to the on-device assistant. It answers questions and can
/// propose changes, which wait here until the person applies or discards them.
export component ChatScreen inherits Rectangle {
    clip: true;
    background: transparent;

    property <bool> wide: root.width >= 720px;
    property <string> draft;
    // The welcome laps of the beam play once per conversation, the first time
    // the message box is clicked.
    property <bool> greeted: false;
    property <string> thread-id: AppData.chat-thread;
    changed thread-id => { root.greeted = false; }
    // Narrow windows show the conversation list in place of the conversation.
    property <bool> list-open: false;
    property <bool> confirm-delete: false;
    property <string> thread: AppData.chat-thread;
    // "chat" answers from the assistant alone; the others search the web first.
    property <string> mode: "chat";
    property <[ChoiceModel]> modes: [
        { id: "chat", label: @tr("Chat") },
        { id: "quick", label: @tr("Quick") },
        { id: "standard", label: @tr("Standard") },
        { id: "deep", label: @tr("Deep") },
    ];

    function send() {
        if root.draft != "" && !AppData.chat-busy {
            if root.mode == "chat" || !AppData.setting-web-search {
                AppData.chat-send(root.draft);
            } else {
                AppData.chat-research(root.draft, root.mode);
            }
            root.draft = "";
        }
    }

    // How a research step reads, from its kind and the words it carries.
    function trace-title(kind: string, text: string) -> string {
        if kind == "plan" { return @tr("Planned the searches"); }
        if kind == "search" { return @tr("Searching: {}", text); }
        if kind == "read" { return @tr("Reading {}", text); }
        if kind == "note" { return @tr("Took notes from {}", text); }
        if kind == "skip" { return @tr("Skipped {}", text); }
        if kind == "merge" { return @tr("Merging the notes"); }
        return @tr("Writing the answer");
    }

    // Leaving a conversation drops a half-finished delete.
    changed thread => { root.confirm-delete = false; }

    HorizontalLayout {
        padding: 20px;
        padding-left: 28px;
        padding-right: 28px;
        spacing: 16px;

        // Conversations
        if root.wide || root.list-open: GlassCard {
            horizontal-stretch: root.wide ? 0 : 1;
            min-width: root.wide ? 230px : 0px;
            max-width: root.wide ? 230px : 100000px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Rectangle {
                    height: 38px;
                    GoalButton { label: @tr("New chat"); kind: "primary"; width: parent.width; clicked => { AppData.chat-new(); root.list-open = false; } }
                }
                Flickable {
                    interactive: false;
                    content-height: list.preferred-height;
                    content-width: self.width;
                    list := VerticalLayout {
                        width: parent.width;
                        spacing: 4px;
                        alignment: start;
                        for th in AppData.chat-threads: ThreadTile {
                            id: th.id;
                            title: th.title;
                            label: th.updated-label;
                            selected: th.id == AppData.chat-thread;
                            open => { AppData.chat-open(th.id); root.list-open = false; }
                            fork => { AppData.chat-fork-thread(th.id); }
                            delete => { AppData.chat-delete(th.id); }
                        }
                    }
                }
            }
        }

        // The conversation
        if root.wide || !root.list-open: VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 4px;
                Text { text: @tr("Chat"); font-size: 28px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                if !root.wide: GoalButton { label: @tr("Chats"); clicked => { root.list-open = true; } }
                if !root.wide: GoalButton { label: @tr("New chat"); clicked => { AppData.chat-new(); } }
                if AppData.chat-thread != "" && AppData.chat-messages.length > 0 && !root.confirm-delete: MsgIcon { tip: @tr("Fork this chat"); clicked => { AppData.chat-fork(-1); } IconFork { x: 6px; y: 6px; } }
                if AppData.chat-thread != "" && !root.confirm-delete: MsgIcon { tip: @tr("Delete chat"); clicked => { root.confirm-delete = true; } IconTrash { x: 6px; y: 6px; } }
                if root.confirm-delete: Text { text: @tr("Delete this chat?"); font-size: 13px; color: Theme.text-secondary; vertical-alignment: center; }
                if root.confirm-delete: MsgIcon { tip: @tr("Yes, delete"); tint: Theme.destructive.with-alpha(0.35); clicked => { AppData.chat-delete(AppData.chat-thread); root.confirm-delete = false; } IconCheck { x: 7px; y: 7px; width: 14px; height: 14px; stroke-color: Theme.text-primary; } }
                if root.confirm-delete: MsgIcon { tip: @tr("Cancel"); clicked => { root.confirm-delete = false; } IconClose { x: 7px; y: 7px; width: 14px; height: 14px; stroke-color: Theme.text-secondary; } }
            }

            Rectangle {
            vertical-stretch: 1;
            scroller := Flickable {
                width: parent.width;
                height: parent.height;
                interactive: false;
                // Stick to the bottom while the person is there; scrolling up lets go,
                // scrolling back down (or the button) picks it up again.
                in-out property <bool> stuck: true;
                property <bool> near-bottom: self.content-height <= self.height || self.content-y <= self.height - self.content-height + 24px;
                changed content-y => { self.stuck = self.near-bottom; }
                changed content-height => { if self.stuck { self.content-y = min(0px, self.height - self.content-height); } }
                content-height: msgs.preferred-height;
                content-width: self.width;
                msgs := VerticalLayout {
                    width: parent.width;
                    spacing: 10px;
                    alignment: start;
                    padding-bottom: 6px;
                    if AppData.chat-messages.length == 0: VerticalLayout {
                        padding-top: 40px;
                        spacing: 10px;
                        alignment: start;
                        HorizontalLayout { alignment: center; IconChat { width: 36px; height: 36px; stroke-color: Theme.text-muted; } }
                        Text {
                            text: @tr("Ask about your tasks, or describe what you want to plan. Nothing changes until you approve it.");
                            font-size: 14px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    for m in AppData.chat-messages: MessageRow {
                        m: m;
                        max-w: scroller.width * 0.8;
                        edited(text) => { AppData.chat-edit(m.index, text); }
                        copy(text) => { AppData.chat-copy(text); }
                        fork => { AppData.chat-fork(m.index); }
                    }
                }
            }
            ScrollToBottomButton {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                shown: !scroller.stuck;
                clicked => { scroller.content-y = min(0px, scroller.height - scroller.content-height); scroller.stuck = true; }
            }
            }

            if AppData.chat-busy && AppData.chat-trace.length > 0: GlassCard {
                height: min(trace-col.preferred-height, 220px);
                clip: true;
                trace-col := VerticalLayout {
                    padding: 12px;
                    spacing: 2px;
                    alignment: end;
                    for row in AppData.chat-trace: TraceLine {
                        title: root.trace-title(row.kind, row.text);
                        description: row.kind == "search" && row.detail != "" ? @tr("{} results", row.detail) : (row.kind == "skip" ? row.detail : "");
                        status: row.status;
                        IconSearch { x: 1px; y: 1px; width: 14px; height: 14px; stroke-color: Theme.text-secondary; }
                    }
                }
            }

            if AppData.chat-proposals.length > 0: GlassCard {
                height: props.preferred-height;
                props := VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: @tr("Proposed changes"); font-size: 14px; font-weight: 600; color: Theme.text-primary; }
                    for line in AppData.chat-proposals: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout { alignment: start; padding-top: 2px; IconCheck { width: 14px; height: 14px; stroke-color: Theme.accent-green; } }
                        Text { horizontal-stretch: 1; text: line; font-size: 13px; color: Theme.text-secondary; wrap: word-wrap; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        GoalButton { label: @tr("Discard"); clicked => { AppData.chat-discard(); } }
                        GoalButton { label: @tr("Apply all"); kind: "primary"; clicked => { AppData.chat-apply(); } }
                    }
                }
            }

            if AppData.chat-busy: ThinkingBar {
                // Download progress comes as text; otherwise the phase picks the words.
                text: AppData.chat-status != "" ? AppData.chat-status
                    : AppData.chat-phase == "loading" ? @tr("Loading the AI...")
                    : AppData.chat-phase == "reading" ? @tr("Reading your message...")
                    : AppData.chat-phase == "searching" ? @tr("Searching the web...")
                    : @tr("Thinking...");
                stop-label: @tr("Stop");
                orb-state: AppData.chat-phase == "loading" ? "solving"
                    : AppData.chat-phase == "searching" || AppData.chat-trace.length > 0 ? "searching"
                    : AppData.chat-phase == "reading" ? "listening"
                    : "thinking";
                stopped => { AppData.chat-stop(); }
            }
            if !AppData.chat-busy && AppData.chat-status == "" && AppData.chat-phase == "stopped": Text { text: @tr("Stopped."); font-size: 13px; color: Theme.text-secondary; }
            // The answer tried to change something but nothing usable came of it.
            if !AppData.chat-busy && AppData.chat-status == "" && AppData.chat-phase == "no-changes": Text { text: @tr("No changes were made."); font-size: 13px; color: Theme.text-secondary; }
            if !AppData.chat-busy && AppData.chat-status != "": Text { text: AppData.chat-status; font-size: 13px; color: Theme.text-secondary; wrap: word-wrap; }

            if AppData.setting-web-search: HorizontalLayout {
                alignment: start;
                GoalChoice { choices: root.modes; selected: root.mode; picked(id) => { root.mode = id; } }
            }

            // Composer
            Rectangle {
                height: 52px;
                border-radius: 26px;
                background: Theme.glass-fill;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent-violet : Theme.glass-border;
                animate border-color { duration: 150ms; easing: ease-out; }
                // A light runs round the edge while the answer is being written.
                beam := BorderBeam { width: parent.width; height: parent.height; border-radius: parent.border-radius; active: AppData.chat-busy; }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 8px;
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        // The text inside must never decide how wide the chat is.
                        preferred-width: 0px;
                        min-width: 0px;
                        clip: true;
                        if root.draft == "": Text {
                            x: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: @tr("Message");
                            font-size: 14px;
                            color: Theme.text-muted;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }
                        input := TextInput {
                            width: parent.width;
                            height: parent.height;
                            text <=> root.draft;
                            font-size: 14px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            horizontal-alignment: left;
                            single-line: true;
                            accepted => { root.send(); }
                            changed has-focus => {
                                if self.has-focus && !root.greeted && !AppData.chat-busy {
                                    root.greeted = true;
                                    beam.play-intro();
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            if AppData.mic-listening == "chat" || AppData.mic-busy: VoiceRing {
                                width: 52px;
                                height: 52px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                state: AppData.mic-busy ? "processing" : "listening";
                                level: AppData.mic-level;
                            }
                            MicButton { x: 4px; y: 4px; owner: "chat"; heard(t) => { root.draft = root.draft == "" ? t : root.draft + " " + t; } }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            opacity: root.draft != "" && !AppData.chat-busy ? 1 : 0.4;
                            background: Theme.accent-violet.with-alpha(send-touch.pressed ? 0.6 : 0.4);
                            IconArrowRight { width: 18px; height: 18px; x: 10px; y: 10px; stroke-color: Theme.text-primary; }
                            send-touch := TouchArea { mouse-cursor: pointer; clicked => { root.send(); } }
                            HoverTip { tip: @tr("Send"); hovered: send-touch.has-hover; pressed: send-touch.pressed; }
                        }
                    }
                }
            }
        }
    }
}
