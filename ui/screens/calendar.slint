import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { IconClose } from "../icons.slint";
import { ShellState } from "../shell_state.slint";
import { TaskModel, CalendarItemModel, TimeBlockModel } from "../types.slint";

/// State and callbacks for the calendar screen. Rust fills the models and
/// handles the callbacks; see src/app/calendar.rs.
export global CalendarState {
    /// "day" or "week".
    in-out property <string> view: "week";
    in-out property <string> range-label: "";
    /// One label per visible day, e.g. "Mon 2".
    in-out property <[string]> day-labels: [];
    in-out property <[CalendarItemModel]> items: [];
    /// Tracked blocks for the anchor day (drawn in day view only).
    in-out property <[TimeBlockModel]> tracked: [];
    in-out property <[TaskModel]> unscheduled-today: [];
    in-out property <[TaskModel]> unscheduled-this-week: [];
    in-out property <[TaskModel]> unscheduled-backlog: [];
    /// Task picked from the rail; the next slot click places it. Empty for none.
    in-out property <string> armed-task-id: "";
    /// Index of the day showing the now-line, or -1 when today is not visible.
    in-out property <int> now-day: -1;
    in-out property <int> now-minutes: 0;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;

    callback request-refresh();
    callback set-view(string);
    callback previous();
    callback next();
    callback go-today();
    /// Day index and the y offset (from the top of the time grid) that was clicked.
    callback slot-clicked(int, length);
    callback unschedule(string);
    callback undo();
    callback redo();
}

/// Small text button.
component TextAction inherits TouchArea {
    in property <string> label;
    in property <bool> emphasis: false;
    in property <bool> usable: true;
    width: 64px;
    height: 28px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-sm;
        background: (root.has-hover && root.usable) ? Theme.bg-card-hover : transparent;
        border-width: root.emphasis ? 1px : 0px;
        border-color: Theme.border-light;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: !root.usable ? Theme.text-muted : (root.emphasis ? Theme.accent-cyan : Theme.text-secondary);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// Unscheduled rail row. Clicking arms the task for the next slot click.
component RailRow inherits Rectangle {
    in property <TaskModel> task;

    height: 36px;
    border-radius: Theme.radius-sm;
    background: CalendarState.armed-task-id == root.task.id ? Theme.bg-card-selected : (rail-touch.has-hover ? Theme.bg-card-hover : transparent);
    border-width: CalendarState.armed-task-id == root.task.id ? 1px : 0px;
    border-color: Theme.accent-cyan;

    rail-touch := TouchArea {
        clicked => {
            CalendarState.armed-task-id = CalendarState.armed-task-id == root.task.id ? "" : root.task.id;
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.task.title;
            font-size: 12px;
            color: Theme.text-primary;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

/// CalendarScreen: unscheduled rail, day or week grid, and navigation.
export component CalendarScreen inherits Rectangle {
    background: transparent;

    init => { CalendarState.request-refresh(); }

    property <length> gutter: 52px;
    property <length> hour-h: 48px;
    property <length> grid-top: 28px;

    HorizontalLayout {
        // Unscheduled rail
        Rectangle {
            width: 220px;
            background: Theme.bg-sidebar;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "Unscheduled";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: CalendarState.armed-task-id == "" ? "Pick a task, then click a time slot." : "Now click a time slot to place it.";
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }

                Rectangle { height: 8px; }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        if CalendarState.unscheduled-today.length > 0: Text {
                            text: "Today";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        for task in CalendarState.unscheduled-today: RailRow { task: task; }

                        if CalendarState.unscheduled-this-week.length > 0: Text {
                            text: "This Week";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        for task in CalendarState.unscheduled-this-week: RailRow { task: task; }

                        if CalendarState.unscheduled-backlog.length > 0: Text {
                            text: "Backlog";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        for task in CalendarState.unscheduled-backlog: RailRow { task: task; }
                    }
                }
            }
        }

        // Main: navigation, day headers and the time grid
        main := Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            property <length> col-w: (self.width - root.gutter - 16px) / Math.max(1, CalendarState.day-labels.length);

            VerticalLayout {
                padding: 16px;
                padding-bottom: ShellState.content-bottom-inset;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    TextAction { width: 64px; label: "Today"; clicked => { CalendarState.go-today(); } }
                    TextAction { width: 36px; label: "<"; clicked => { CalendarState.previous(); } }
                    TextAction { width: 36px; label: ">"; clicked => { CalendarState.next(); } }
                    Text {
                        text: CalendarState.range-label;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    TextAction {
                        width: 56px;
                        label: "Day";
                        emphasis: CalendarState.view == "day";
                        clicked => { CalendarState.set-view("day"); }
                    }
                    TextAction {
                        width: 60px;
                        label: "Week";
                        emphasis: CalendarState.view == "week";
                        clicked => { CalendarState.set-view("week"); }
                    }
                    TextAction { width: 60px; label: "Undo"; usable: CalendarState.can-undo; clicked => { CalendarState.undo(); } }
                    TextAction { width: 60px; label: "Redo"; usable: CalendarState.can-redo; clicked => { CalendarState.redo(); } }
                }

                // Day header row: sits above the scrolling grid.
                Rectangle {
                    height: 24px;
                    for label[i] in CalendarState.day-labels: Text {
                        x: root.gutter + i * main.col-w;
                        width: main.col-w;
                        text: label;
                        font-size: 12px;
                        font-weight: 700;
                        color: (CalendarState.now-day == i) ? Theme.accent-cyan : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    grid := Rectangle {
                        width: main.width - 16px;
                        height: root.grid-top + 24 * root.hour-h;

                        // Hour lines and labels
                        for h in 24: Rectangle {
                            x: 0px;
                            y: root.grid-top + h * root.hour-h;
                            width: grid.width;
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        for h in 24: Text {
                            x: 0px;
                            y: root.grid-top + h * root.hour-h + 4px;
                            width: root.gutter - 8px;
                            text: (h < 10 ? "0" : "") + h + ":00";
                            font-size: 10px;
                            color: Theme.text-muted;
                            horizontal-alignment: right;
                        }

                        // Empty slots: a click places a task or creates one.
                        for label[i] in CalendarState.day-labels: TouchArea {
                            x: root.gutter + i * main.col-w;
                            y: root.grid-top;
                            width: main.col-w;
                            height: 24 * root.hour-h;
                            clicked => { CalendarState.slot-clicked(i, self.mouse-y); }
                        }

                        // Now line
                        if CalendarState.now-day >= 0: Rectangle {
                            x: root.gutter + CalendarState.now-day * main.col-w;
                            y: root.grid-top + CalendarState.now-minutes * root.hour-h / 60;
                            width: main.col-w;
                            height: 2px;
                            background: Theme.accent-pink;
                        }

                        // Tracked blocks (day view)
                        for block in CalendarState.tracked: Rectangle {
                            visible: CalendarState.view == "day";
                            x: root.gutter + 4px;
                            y: root.grid-top + block.start-mins * root.hour-h / 60;
                            width: main.col-w - 8px;
                            height: Math.max(18px, block.length-mins * root.hour-h / 60);
                            border-radius: 6px;
                            background: Theme.bg-card-selected;
                            border-width: 1px;
                            border-color: Theme.border-light;
                            Text {
                                x: 8px;
                                y: 3px;
                                width: parent.width - 16px;
                                text: block.label;
                                font-size: 11px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }

                        // Scheduled tasks: all-day chips in the strip, timed chips on the grid.
                        for item in CalendarState.items: Rectangle {
                            x: root.gutter + item.day-index * main.col-w + 2px;
                            y: item.start-mins < 0 ? 2px : root.grid-top + item.start-mins * root.hour-h / 60;
                            width: main.col-w - 4px;
                            height: item.start-mins < 0 ? 22px : Math.max(22px, item.length-mins * root.hour-h / 60);
                            border-radius: 6px;
                            background: item.color.transparentize(0.7);
                            border-width: 1px;
                            border-color: item.color;

                            Text {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 30px;
                                text: item.title;
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                overflow: elide;
                            }

                            remove-touch := TouchArea {
                                x: parent.width - 24px;
                                y: 3px;
                                width: 20px;
                                height: 20px;
                                clicked => { CalendarState.unschedule(item.task-id); }
                                IconClose {
                                    width: 9px;
                                    height: 9px;
                                    x: 5px;
                                    y: 5px;
                                    stroke-color: remove-touch.has-hover ? Theme.destructive : Theme.text-muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
