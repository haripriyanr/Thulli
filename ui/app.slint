import { Theme } from "theme.slint";
import { WindowControls } from "window_controls.slint";
import { LineEdit, Button, ScrollView, CheckBox } from "std-widgets.slint";

export struct TaskModel {
    id: string,
    list_id: string,
    title: string,
    estimate_mins: int,
    completed: bool,
    board: string, // "today", "week", "backlog", "done"
}

export struct ListModel {
    id: string,
    name: string,
    color: string,
    pending_count: int,
    is_archived: bool,
}

export struct BlockedAppModel {
    id: string,
    name: string,
    process_name: string,
    active: bool,
}

export component MainWindow inherits Window {
    title: "Thulli";
    no-frame: true;
    preferred-width: 1240px;
    preferred-height: 780px;
    min-width: 980px;
    min-height: 620px;
    background: Theme.bg-canvas;
    default-font-family: "Segoe UI, Inter, sans-serif";

    // Application state
    in-out property <string> active-nav: "all_lists"; // "all_lists", "archived", "board", "reports", "blocker", "scratchpad"
    in-out property <string> selected-list-id: "";
    in-out property <string> selected-list-name: "Personal";
    in-out property <string> active-mode: "dashboard"; // "dashboard", "tower", "pill"
    in-out property <string> user-name: "Hari";
    in-out property <string> timer-display: "25:00";
    in-out property <bool> timer-running: false;
    in-out property <string> active-task-name: "Deep Work Session";
    in-out property <bool> show-create-list-modal: false;
    in-out property <bool> show-preferences-modal: false;

    // Data models
    in-out property <[ListModel]> lists: [];
    in-out property <[TaskModel]> tasks: [];
    in-out property <[BlockedAppModel]> blocked-apps: [];

    // Inputs
    in-out property <string> new-list-name: "";
    in-out property <string> new-list-color: "#3CC9C4";
    in-out property <string> new-task-input: "";
    in-out property <string> scratchpad-text: "";

    // Window action callbacks
    callback window-drag-start();
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    // Functional callbacks
    callback toggle-timer();
    callback reset-timer();
    callback select-list(string);
    callback toggle-task(string);
    callback add-task(string, string, string); // (title, list_id, board)
    callback create-list(string, string);
    callback toggle-blocked-app(string);
    callback switch-app-mode(string);
    callback save-scratchpad(string);

    // Root layout
    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Custom Top Bar (Window Header & Native Draggable Region)
        Rectangle {
            height: 48px;
            background: Theme.bg-canvas;

            // Touch area for native window dragging
            TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        root.window-drag-start();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 14px;
                alignment: space-between;

                // Drag region title
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    // Brand Badge
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: Theme.radius-sm;
                        background: @linear-gradient(135deg, Theme.accent-cyan 0%, Theme.accent-lime 100%);
                        y: 11px;

                        Text {
                            text: "⚡";
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "THULLI";
                        font-size: 15px;
                        font-weight: 800;
                        color: Theme.text-primary;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 1px;
                        height: 16px;
                        background: Theme.border-subtle;
                        y: 16px;
                    }

                    // Mode switch buttons
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: root.active-mode == "dashboard" ? Theme.bg-card-selected : transparent;
                            border-width: root.active-mode == "dashboard" ? 1px : 0px;
                            border-color: Theme.border-light;
                            TouchArea {
                                clicked => { root.switch-app-mode("dashboard"); }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    Text {
                                        text: "Dashboard";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.active-mode == "dashboard" ? Theme.text-primary : Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: root.active-mode == "tower" ? Theme.bg-card-selected : transparent;
                            border-width: root.active-mode == "tower" ? 1px : 0px;
                            border-color: Theme.border-light;
                            TouchArea {
                                clicked => { root.switch-app-mode("tower"); }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    Text {
                                        text: "BlitzTower";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.active-mode == "tower" ? Theme.text-primary : Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: root.active-mode == "pill" ? Theme.bg-card-selected : transparent;
                            border-width: root.active-mode == "pill" ? 1px : 0px;
                            border-color: Theme.border-light;
                            TouchArea {
                                clicked => { root.switch-app-mode("pill"); }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    Text {
                                        text: "Pill HUD";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.active-mode == "pill" ? Theme.text-primary : Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Window right actions & controls
                HorizontalLayout {
                    spacing: 14px;
                    alignment: end;

                    // Preferences Gear Button
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: Theme.radius-sm;
                        background: pref-touch.has-hover ? Theme.bg-card-hover : transparent;
                        y: 9px;

                        pref-touch := TouchArea {
                            clicked => { root.show-preferences-modal = !root.show-preferences-modal; }
                        }

                        Text {
                            text: "⚙";
                            font-size: 15px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Window Controls
                    WindowControls {
                        minimize => { root.window-minimize(); }
                        maximize => { root.window-maximize(); }
                        close => { root.window-close(); }
                    }
                }
            }
        }

        // Horizontal Split: Left Navigation + Main Canvas
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;

            // Sidebar
            Rectangle {
                width: 250px;
                background: Theme.bg-panel;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    // Plan Info Box (Blitzit style)
                    Rectangle {
                        height: 72px;
                        background: Theme.bg-card;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "THULLI CORE";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: Theme.accent-cyan;
                                }
                                Text {
                                    text: "v0.1.0";
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                }
                            }
                            Text {
                                text: "Encrypted AES-256 Vault";
                                font-size: 11px;
                                color: Theme.text-secondary;
                            }
                        }
                    }

                    // + Create New List Button
                    Rectangle {
                        height: 42px;
                        border-radius: Theme.radius-md;
                        background: btn-add-list.has-hover ? Theme.bg-card-hover : Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-light;

                        btn-add-list := TouchArea {
                            clicked => { root.show-create-list-modal = true; }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "+";
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.accent-cyan;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Create new list";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { height: 8px; }

                    // Navigation Tabs
                    Rectangle {
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: root.active-nav == "all_lists" ? Theme.bg-card-selected : transparent;
                        TouchArea {
                            clicked => { root.active-nav = "all_lists"; }
                            HorizontalLayout {
                                padding-left: 14px;
                                alignment: center;
                                Text {
                                    text: "📋 All my lists";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.active-nav == "all_lists" ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: root.active-nav == "archived" ? Theme.bg-card-selected : transparent;
                        TouchArea {
                            clicked => { root.active-nav = "archived"; }
                            HorizontalLayout {
                                padding-left: 14px;
                                alignment: center;
                                Text {
                                    text: "📁 Archived lists";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.active-nav == "archived" ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle { height: 8px; }

                    // Locu Focus Tools Section
                    Text {
                        text: "FOCUS & SHIELD";
                        font-size: 10px;
                        font-weight: 800;
                        color: Theme.text-muted;
                        letter-spacing: 1px;
                    }

                    Rectangle {
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: root.active-nav == "blocker" ? Theme.bg-card-selected : transparent;
                        TouchArea {
                            clicked => { root.active-nav = "blocker"; }
                            HorizontalLayout {
                                padding-left: 14px;
                                alignment: center;
                                Text {
                                    text: "🛡️ App Shield";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.active-nav == "blocker" ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: root.active-nav == "scratchpad" ? Theme.bg-card-selected : transparent;
                        TouchArea {
                            clicked => { root.active-nav = "scratchpad"; }
                            HorizontalLayout {
                                padding-left: 14px;
                                alignment: center;
                                Text {
                                    text: "📝 Scratchpad";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.active-nav == "scratchpad" ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Spacer
                    Rectangle { }

                    // Persistent Sidebar Timer (Blitzit / Locu style)
                    Rectangle {
                        height: 120px;
                        background: Theme.bg-card;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: root.timer-display;
                                font-size: 26px;
                                font-weight: 800;
                                color: Theme.accent-cyan;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Rectangle {
                                    height: 32px;
                                    width: 90px;
                                    border-radius: Theme.radius-sm;
                                    background: @linear-gradient(135deg, Theme.accent-cyan 0%, Theme.accent-lime 100%);
                                    TouchArea {
                                        clicked => { root.toggle-timer(); }
                                    }
                                    Text {
                                        text: root.timer-running ? "Pause" : "Start";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #000000;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 32px;
                                    width: 60px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.bg-card-hover;
                                    border-width: 1px;
                                    border-color: Theme.border-light;
                                    TouchArea {
                                        clicked => { root.reset-timer(); }
                                    }
                                    Text {
                                        text: "Reset";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Main Content Area
            Rectangle {
                background: Theme.bg-canvas;

                VerticalLayout {
                    padding: 32px;
                    spacing: 24px;

                    // Header: Greeting + Subtitle
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Good Morning, " + root.user-name;
                                font-size: 26px;
                                font-weight: 800;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: "Are you ready to blitz through your day?";
                                font-size: 14px;
                                color: Theme.text-secondary;
                            }
                        }

                        // Back to lists button if inside a Kanban board
                        if root.active-nav == "board": Rectangle {
                            height: 36px;
                            width: 120px;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-card;
                            border-width: 1px;
                            border-color: Theme.border-light;
                            TouchArea {
                                clicked => { root.active-nav = "all_lists"; }
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text { text: "← All Lists"; font-size: 12px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                            }
                        }
                    }

                    // View 1: All Lists (Grid of Cards)
                    if root.active-nav == "all_lists": VerticalLayout {
                        spacing: 20px;

                        Text {
                            text: "Your Lists";
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        // Grid of Cards
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;

                            // Display List Cards
                            for list in root.lists: Rectangle {
                                width: 260px;
                                height: 260px;
                                border-radius: Theme.radius-lg;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                TouchArea {
                                    clicked => {
                                        root.selected-list-id = list.id;
                                        root.selected-list-name = list.name;
                                        root.active-nav = "board";
                                        root.select-list(list.id);
                                    }
                                }

                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        // Color circle
                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            border-radius: Theme.radius-full;
                                            background: #3CC9C4;
                                            y: 2px;
                                            Text {
                                                text: "P";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: #000000;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: list.name;
                                            font-size: 16px;
                                            font-weight: 700;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Inner Card Content: Status
                                    Rectangle {
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;

                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: Theme.radius-full;
                                                border-width: 2px;
                                                border-color: Theme.accent-green;
                                                x: 94px;

                                                Text {
                                                    text: "✓";
                                                    font-size: 14px;
                                                    font-weight: 800;
                                                    color: Theme.accent-green;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Text {
                                                text: list.pending-count == 0 ? "ALL CLEAR" : "IN PROGRESS";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: list.pending-count == 0 ? Theme.text-muted : Theme.accent-cyan;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: list.pending-count + " pending tasks";
                                        font-size: 12px;
                                        color: Theme.text-muted;
                                    }
                                }
                            }

                            // + CREATE LIST Card (Blitzit dashed style)
                            Rectangle {
                                width: 260px;
                                height: 260px;
                                border-radius: Theme.radius-lg;
                                background: card-add-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card;
                                border-width: 1.5px;
                                border-color: Theme.border-light;

                                card-add-touch := TouchArea {
                                    clicked => { root.show-create-list-modal = true; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;

                                    Text {
                                        text: "+";
                                        font-size: 32px;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "CREATE LIST";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        letter-spacing: 1px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // View 2: Full Blitzit Kanban Board (Today | This Week | Backlog | Done)
                    if root.active-nav == "board": VerticalLayout {
                        spacing: 16px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.selected-list-name + " Board";
                                font-size: 20px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            // Smart Task Input
                            HorizontalLayout {
                                spacing: 8px;
                                width: 440px;
                                LineEdit {
                                    text <=> root.new-task-input;
                                    placeholder-text: "Add task (e.g. 'Build auth 45m @today')...";
                                    accepted => {
                                        if (root.new-task-input != "") {
                                            root.add-task(root.new-task-input, root.selected-list-id, "today");
                                            root.new-task-input = "";
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 70px;
                                    height: 36px;
                                    border-radius: Theme.radius-sm;
                                    background: @linear-gradient(135deg, Theme.accent-cyan 0%, Theme.accent-lime 100%);
                                    TouchArea {
                                        clicked => {
                                            if (root.new-task-input != "") {
                                                root.add-task(root.new-task-input, root.selected-list-id, "today");
                                                root.new-task-input = "";
                                            }
                                        }
                                    }
                                    Text {
                                        text: "+ Add";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #000000;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Kanban Columns
                        HorizontalLayout {
                            spacing: 16px;

                            // Column 1: Today (with Blitz Rocket Action)
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.bg-panel;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 12px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "TODAY"; font-size: 13px; font-weight: 800; color: Theme.accent-cyan; }
                                        Text { text: "Focus Queue"; font-size: 11px; color: Theme.text-muted; }
                                    }

                                    ScrollView {
                                        VerticalLayout {
                                            spacing: 8px;
                                            for task in root.tasks: Rectangle {
                                                visible: task.board == "today" && !task.completed;
                                                height: (task.board == "today" && !task.completed) ? 52px : 0px;
                                                background: Theme.bg-card;
                                                border-radius: Theme.radius-sm;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;

                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    alignment: space-between;

                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        alignment: center;
                                                        CheckBox {
                                                            checked: task.completed;
                                                            toggled => { root.toggle-task(task.id); }
                                                        }
                                                        Text {
                                                            text: task.title;
                                                            font-size: 13px;
                                                            color: Theme.text-primary;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Text {
                                                        text: task.estimate-mins + "m";
                                                        font-size: 11px;
                                                        color: Theme.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Blitzit Action Launch Button
                                    Rectangle {
                                        height: 38px;
                                        border-radius: Theme.radius-sm;
                                        background: @linear-gradient(135deg, Theme.accent-cyan 0%, Theme.accent-lime 100%);
                                        TouchArea {
                                            clicked => { root.switch-app-mode("tower"); }
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Text { text: "🚀"; font-size: 14px; }
                                            Text { text: "Launch BlitzTower Focus"; font-size: 12px; font-weight: 800; color: #000000; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            // Column 2: This Week
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.bg-panel;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 12px;

                                    Text { text: "THIS WEEK"; font-size: 13px; font-weight: 800; color: Theme.accent-lime; }

                                    ScrollView {
                                        VerticalLayout {
                                            spacing: 8px;
                                            for task in root.tasks: Rectangle {
                                                visible: task.board == "week" && !task.completed;
                                                height: (task.board == "week" && !task.completed) ? 52px : 0px;
                                                background: Theme.bg-card;
                                                border-radius: Theme.radius-sm;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    alignment: space-between;
                                                    Text { text: task.title; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; }
                                                    Text { text: task.estimate-mins + "m"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Column 3: Backlog
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.bg-panel;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 12px;

                                    Text { text: "BACKLOG"; font-size: 13px; font-weight: 800; color: Theme.accent-blue; }

                                    ScrollView {
                                        VerticalLayout {
                                            spacing: 8px;
                                            for task in root.tasks: Rectangle {
                                                visible: task.board == "backlog" && !task.completed;
                                                height: (task.board == "backlog" && !task.completed) ? 52px : 0px;
                                                background: Theme.bg-card;
                                                border-radius: Theme.radius-sm;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    alignment: space-between;
                                                    Text { text: task.title; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; }
                                                    Text { text: task.estimate-mins + "m"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Column 4: Done
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.bg-panel;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 12px;

                                    Text { text: "DONE 🎉"; font-size: 13px; font-weight: 800; color: Theme.accent-green; }

                                    ScrollView {
                                        VerticalLayout {
                                            spacing: 8px;
                                            for task in root.tasks: Rectangle {
                                                visible: task.completed;
                                                height: task.completed ? 52px : 0px;
                                                background: Theme.bg-card;
                                                border-radius: Theme.radius-sm;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    alignment: space-between;
                                                    Text { text: task.title; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; }
                                                    Text { text: "✓ Done"; font-size: 11px; color: Theme.accent-green; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // View 3: Blocker
                    if root.active-nav == "blocker": VerticalLayout {
                        spacing: 16px;
                        Text {
                            text: "Locu Distraction Shield";
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        ScrollView {
                            VerticalLayout {
                                spacing: 10px;
                                for app in root.blocked-apps: Rectangle {
                                    height: 56px;
                                    background: Theme.bg-card;
                                    border-radius: Theme.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: app.name;
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: Theme.text-primary;
                                            }
                                            Text {
                                                text: app.process-name;
                                                font-size: 11px;
                                                color: Theme.text-muted;
                                            }
                                        }

                                        Rectangle {
                                            width: 110px;
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: app.active ? Theme.accent-green : Theme.bg-card-hover;
                                            y: 12px;
                                            TouchArea {
                                                clicked => { root.toggle-blocked-app(app.id); }
                                            }
                                            Text {
                                                text: app.active ? "Shield Active" : "Shield Paused";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: app.active ? #000000 : Theme.text-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // View 4: Scratchpad
                    if root.active-nav == "scratchpad": VerticalLayout {
                        spacing: 16px;
                        Text {
                            text: "Locu Quick Scratchpad";
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            VerticalLayout {
                                padding: 16px;
                                LineEdit {
                                    text <=> root.scratchpad-text;
                                    placeholder-text: "Capture distractions or rapid thoughts...";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Overlay: Create List
    if root.show-create-list-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b0;

        TouchArea { }

        Rectangle {
            width: 440px;
            height: 480px;
            border-radius: Theme.radius-lg;
            background: #181C22;
            border-width: 1px;
            border-color: Theme.border-light;

            VerticalLayout {
                padding: 28px;
                spacing: 20px;

                HorizontalLayout {
                    alignment: space-between;
                    Rectangle { width: 1px; }
                    Text {
                        text: "Create a new list";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        TouchArea {
                            clicked => { root.show-create-list-modal = false; }
                        }
                        Text {
                            text: "✕";
                            font-size: 14px;
                            color: Theme.text-muted;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: Theme.radius-full;
                        background: #6FE2A4;
                        x: 160px;

                        Text {
                            text: "P";
                            font-size: 24px;
                            font-weight: 700;
                            color: #000000;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "UPLOAD AN ICON";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Optional (jpg, png, svg)";
                        font-size: 11px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Pick a list color";
                        font-size: 12px;
                        color: Theme.text-secondary;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Rectangle { width: 22px; height: 22px; border-radius: Theme.radius-full; background: #6F98E8; }
                        Rectangle { width: 22px; height: 22px; border-radius: Theme.radius-full; background: #B3C065; }
                        Rectangle { width: 22px; height: 22px; border-radius: Theme.radius-full; background: #EF82EF; }
                        Rectangle { width: 22px; height: 22px; border-radius: Theme.radius-full; background: #3CC9C4; border-width: 2px; border-color: #FFFFFF; }
                        Rectangle { width: 22px; height: 22px; border-radius: Theme.radius-full; background: #00FFF6; }
                        Rectangle { width: 22px; height: 22px; border-radius: Theme.radius-full; background: #FFF176; }
                        Rectangle { width: 22px; height: 22px; border-radius: Theme.radius-full; background: #000000; }
                    }
                }

                LineEdit {
                    text <=> root.new-list-name;
                    placeholder-text: "List name (e.g. Work, Personal)...";
                }

                HorizontalLayout {
                    spacing: 14px;
                    alignment: center;

                    Rectangle {
                        width: 140px;
                        height: 40px;
                        border-radius: Theme.radius-md;
                        background: transparent;
                        border-width: 1px;
                        border-color: Theme.border-light;
                        TouchArea {
                            clicked => { root.show-create-list-modal = false; }
                        }
                        Text {
                            text: "Cancel";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 140px;
                        height: 40px;
                        border-radius: Theme.radius-md;
                        background: @linear-gradient(135deg, Theme.accent-cyan 0%, Theme.accent-lime 100%);
                        TouchArea {
                            clicked => {
                                if (root.new-list-name != "") {
                                    root.create-list(root.new-list-name, root.new-list-color);
                                    root.new-list-name = "";
                                    root.show-create-list-modal = false;
                                }
                            }
                        }
                        Text {
                            text: "Create";
                            font-size: 13px;
                            font-weight: 700;
                            color: #000000;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Modal Overlay: Preferences
    if root.show-preferences-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b0;

        TouchArea { }

        Rectangle {
            width: 520px;
            height: 580px;
            border-radius: Theme.radius-lg;
            background: #181C22;
            border-width: 1px;
            border-color: Theme.border-light;

            VerticalLayout {
                padding: 28px;
                spacing: 20px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Preferences";
                            font-size: 20px;
                            font-weight: 800;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Customize your workflow for a personalized experience";
                            font-size: 12px;
                            color: Theme.text-secondary;
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        TouchArea {
                            clicked => { root.show-preferences-modal = false; }
                        }
                        Text {
                            text: "✕";
                            font-size: 15px;
                            color: Theme.text-muted;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Time";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Rectangle {
                        height: 42px;
                        background: Theme.bg-card;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;
                            Text {
                                text: "Timezone";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "(GMT+05:30) Asia/Calcutta ▾";
                                font-size: 12px;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "Blitz mode settings";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    Rectangle {
                        height: 42px;
                        background: Theme.bg-card;
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;
                            Text {
                                text: "Pomodoros";
                                font-size: 13px;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 38px;
                                height: 22px;
                                border-radius: Theme.radius-full;
                                background: Theme.accent-cyan;
                                y: 10px;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: Theme.radius-full;
                                    background: #FFFFFF;
                                    x: 19px;
                                    y: 3px;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 42px;
                        background: Theme.bg-card;
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;
                            Text {
                                text: "Default break length";
                                font-size: 13px;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "10 mins ▾";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 42px;
                        background: Theme.bg-card;
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;
                            Text {
                                text: "Scrolling title on live timer";
                                font-size: 13px;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 38px;
                                height: 22px;
                                border-radius: Theme.radius-full;
                                background: Theme.accent-cyan;
                                y: 10px;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: Theme.radius-full;
                                    background: #FFFFFF;
                                    x: 19px;
                                    y: 3px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
