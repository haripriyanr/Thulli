// Thulli shell: frameless window, one animated background shared by every
// screen, and glass panels on top of it.
//
// Motion: the background orbs drift on a shared phase value that the shell
// timer advances. Hover feedback and panel size changes stay immediate.

import { Theme } from "theme.slint";
import { WindowControls } from "window_controls.slint";
import { IconSun, IconMoon } from "icons.slint";
import { EdgeResize } from "resize_edges.slint";
import { ShellState } from "shell_state.slint";
import { NavigationRail } from "components/navigation_rail.slint";
import { AppBackground } from "components/ambient_background.slint";
import { AppData } from "app_data.slint";
import { PomodoroScreen } from "screens/pomodoro_screen.slint";
import { SpacesScreen } from "screens/spaces_screen.slint";
import { SortScreen } from "screens/ai_panels.slint";
import { DragGhost, TipLayer } from "components/drag.slint";
import { TodayScreen } from "screens/today_screen.slint";
import { NotesScreen } from "screens/notes_screen.slint";
import { InsightsScreen } from "screens/insights_screen.slint";
import { SettingsScreen } from "screens/settings_screen.slint";

export { ShellState }
export { Theme }
export { AppData }

export component MainWindow inherits Window {
    title: "Thulli";
    no-frame: true;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 360px;
    min-height: 480px;
    background: transparent;

    init => { focus-scope.focus(); }

    // Outer frame: smoothly rounded silhouette with crisp 1px border.
    // Clips all children to the border radius so the window never feels like a harsh rectangle.
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        border-radius: ShellState.is-maximized ? 0px : 16px;
        border-width: ShellState.is-maximized ? 0px : 1px;
        border-color: Theme.border-subtle;
        background: Theme.bg-canvas;

        // The one background for the whole app. Every screen sits on it.
        AppBackground {
            width: 100%;
            height: 100%;
            phase: AppData.background-phase;
            corner: ShellState.is-maximized ? 0px : 16px;
        }

        // Full screen: F11 toggles the immersive timer on the Pomodoro screen,
        // and Escape leaves it from anywhere.
        focus-scope := FocusScope {
            key-pressed(event) => {
                if event.text == Key.F11 && navigation-rail.active-item == "pomodoro" {
                    AppData.immersive = !AppData.immersive;
                    return accept;
                }
                if event.text == Key.Escape && AppData.immersive {
                    AppData.immersive = false;
                    return accept;
                }
                return reject;
            }
        }

        // --- Title strip: drag area + window controls ----------------------
        // x/y must be pinned: elements without a position binding default to
        // being centered in their parent, which shoved this strip mid-window.
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: Theme.title-bar-height;

            // Declared first so the controls stay on top of the drag region.
            // Plain clicks and drag still reach the move area; a double-click
            // on the strip toggles maximize.
            WindowMoveArea {
                width: 100%;
                height: 100%;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    double-clicked => { ShellState.window-maximize(); }
                }
            }

            // macOS Traffic lights (Top-Left)
            if ShellState.is-macos: WindowControls {
                width: 68px;
                height: 24px;
                x: 14px;
                y: (parent.height - 24px) / 2;
                is-maximized: ShellState.is-maximized;
                is-macos: true;
                minimize => { ShellState.window-minimize(); }
                maximize => { ShellState.window-maximize(); }
                close => { ShellState.window-close(); }
            }

            // Theme toggle: placed on the right
            Rectangle {
                width: 30px;
                height: 30px;
                x: ShellState.is-macos ? (parent.width - 30px - 14px) : (parent.width - 98px - 10px - 38px);
                y: (parent.height - 30px) / 2;
                theme-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        Theme.theme-choice = Theme.dark-mode ? "light" : "dark";
                        ShellState.theme-choice = Theme.theme-choice;
                        ShellState.theme-choice-changed(Theme.theme-choice);
                    }
                    Rectangle {
                        width: 100%; height: 100%; border-radius: 9px;
                        background: theme-touch.has-hover ? Theme.glass-fill-hover : transparent;
                        if Theme.light-mode: IconMoon { width: 16px; height: 16px; x: 7px; y: 7px; stroke-color: Theme.text-secondary; }
                        if !Theme.light-mode: IconSun { width: 18px; height: 18px; x: 6px; y: 6px; stroke-color: Theme.text-secondary; }
                    }
                }
            }

            // Windows / Linux controls (Top-Right)
            if !ShellState.is-macos: WindowControls {
                width: 98px;
                height: 30px;
                x: parent.width - 98px - 10px;
                y: (parent.height - 30px) / 2;
                is-maximized: ShellState.is-maximized;
                is-macos: false;
                minimize => { ShellState.window-minimize(); }
                maximize => { ShellState.window-maximize(); }
                close => { ShellState.window-close(); }
            }
        }

        // --- Screens sit directly on the shared background ----------------
        Rectangle {
            x: AppData.immersive ? 24px : (parent.width < 640px ? 14px : (navigation-rail.expanded ? 286px : 116px));
            y: Theme.title-bar-height + 2px;
            width: AppData.immersive
                ? parent.width - 48px
                : (parent.width < 640px
                    ? parent.width - 28px
                    : parent.width - (navigation-rail.expanded ? 300px : 130px));
            height: parent.height - Theme.title-bar-height - (parent.width < 640px ? 96px : 16px);
            clip: true;

            if navigation-rail.active-item == "today": TodayScreen {
                width: 100%;
                height: 100%;
            }

            if navigation-rail.active-item == "tasks": SpacesScreen {
                width: 100%;
                height: 100%;
                open-pomodoro => { navigation-rail.active-item = "pomodoro"; }
            }

            if navigation-rail.active-item == "pomodoro": PomodoroScreen {
                width: 100%;
                height: 100%;
                view-all-tasks => { navigation-rail.active-item = "tasks"; }
            }

            if navigation-rail.active-item == "notes": NotesScreen {
                width: 100%;
                height: 100%;
            }

            if navigation-rail.active-item == "insights": InsightsScreen {
                width: 100%;
                height: 100%;
            }

            if navigation-rail.active-item == "settings": SettingsScreen {
                width: 100%;
                height: 100%;
            }
        }

        navigation-rail := NavigationRail {
            visible: !AppData.immersive;
            x: parent.width < 640px ? 12px : 24px;
            y: parent.width < 640px ? parent.height - self.height - 14px : Theme.title-bar-height + 2px;
            compact: parent.width < 640px;
            compact-width: parent.width - 24px;
            desktop-height: parent.height - Theme.title-bar-height - 16px;
        }

        // Sort screen: covers the whole window while open.
        if AppData.triage-open: SortScreen {
            x: 0px;
            y: Theme.title-bar-height;
            width: parent.width;
            height: parent.height - Theme.title-bar-height;
        }

        // The card following the pointer while a task is dragged.
        DragGhost {}
        // Hover tooltips, above every container.
        TipLayer {}

        // --- Frameless resize edges: transparent strips pinned to the ------
        // window frame, on top of everything, hidden while maximized.
        // Corners come last so they win over the edge strips.
        if !ShellState.is-maximized: EdgeResize {
            edge: "left";
            x: 0px;
            y: 0px;
            width: 6px;
            height: 100%;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "right";
            x: parent.width - 6px;
            y: 0px;
            width: 6px;
            height: 100%;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "top";
            x: 0px;
            y: 0px;
            width: 100%;
            height: 6px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "bottom";
            x: 0px;
            y: parent.height - 6px;
            width: 100%;
            height: 6px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "top-left";
            x: 0px;
            y: 0px;
            width: 16px;
            height: 16px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "top-right";
            x: parent.width - 16px;
            y: 0px;
            width: 16px;
            height: 16px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "bottom-left";
            x: 0px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "bottom-right";
            x: parent.width - 16px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
        }
    }
}
