// Thulli shell — frameless, warm neutral surfaces with muted teal accents.
// A slow orb field sits behind a softly layered panel and an adaptive dock.
//
// Motion policy: hover feedback 120ms ease-out + ambient orb drift (slow,
// sub-3px/s, ease-in-out) — nothing else.

import { Theme } from "theme.slint";
import { WindowControls } from "window_controls.slint";
import { IconSun, IconMoon } from "icons.slint";
import { EdgeResize } from "resize_edges.slint";
import { ShellState } from "shell_state.slint";
import { NavigationRail } from "components/navigation_rail.slint";

export { ShellState }
export { Theme }

export component MainWindow inherits Window {
    title: "Thulli";
    no-frame: true;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 360px;
    min-height: 480px;
    background: Theme.bg-canvas;

    // Outer frame: 1px gradient edge so the window has a defined silhouette
    // against any wallpaper. Everything else lives inside.
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        border-width: 1px;
        border-color: @linear-gradient(140deg,
            rgba(255, 255, 255, 0.28) 0%,
            rgba(255, 255, 255, 0.06) 40%,
            rgba(255, 255, 255, 0.10) 100%);

        background: Theme.dark-mode
            ? @linear-gradient(195deg, #111820 0%, #0D1118 48%, #0B0E13 100%)
            : @linear-gradient(195deg, #F8F7F2 0%, #F2F0E9 52%, #EAEDE7 100%);

        // --- Orb field: bright, soft, silver with two color accents --------
        // Each orb is a multi-stop radial circle faking a gaussian falloff.

        // Large bright silver orb, upper right. Mostly horizontal drift.
        orb1 := Rectangle {
            x: parent.width - 500px + (ShellState.orb-drift ? 44px : -16px);
            y: -240px + (ShellState.orb-drift ? 8px : -6px);
            width: 720px;
            height: 720px;
            border-radius: 360px;
            animate x { duration: 16s; easing: ease-in-out; }
            animate y { duration: 16s; easing: ease-in-out; }
            background: @radial-gradient(circle,
                rgba(236, 241, 248, 0.22) 0%,
                rgba(216, 226, 240, 0.12) 28%,
                rgba(190, 204, 228, 0.05) 55%,
                rgba(190, 204, 228, 0.00) 80%);
        }

        // Large dim silver orb, lower left. Mostly vertical drift.
        orb2 := Rectangle {
            x: -300px + (ShellState.orb-drift ? -10px : 8px);
            y: parent.height - 560px + (ShellState.orb-drift ? 40px : -12px);
            width: 760px;
            height: 760px;
            border-radius: 380px;
            animate x { duration: 16s; easing: ease-in-out; }
            animate y { duration: 16s; easing: ease-in-out; }
            background: @radial-gradient(circle,
                rgba(224, 230, 242, 0.13) 0%,
                rgba(196, 206, 226, 0.06) 38%,
                rgba(196, 206, 226, 0.00) 76%);
        }

        // Small cyan accent glow, mid left. Mostly horizontal drift.
        orb3 := Rectangle {
            x: -40px + (ShellState.orb-drift ? 36px : -12px);
            y: parent.height * 0.42 + (ShellState.orb-drift ? 14px : -10px);
            width: 360px;
            height: 360px;
            border-radius: 180px;
            animate x { duration: 16s; easing: ease-in-out; }
            animate y { duration: 16s; easing: ease-in-out; }
            background: @radial-gradient(circle,
                rgba(60, 201, 196, 0.22) 0%,
                rgba(60, 201, 196, 0.07) 42%,
                rgba(60, 201, 196, 0.00) 78%);
        }

        // Faint pink accent, top left. Mostly vertical drift.
        orb4 := Rectangle {
            x: -60px + (ShellState.orb-drift ? -8px : 12px);
            y: -100px + (ShellState.orb-drift ? 34px : -14px);
            width: 420px;
            height: 420px;
            border-radius: 210px;
            animate x { duration: 16s; easing: ease-in-out; }
            animate y { duration: 16s; easing: ease-in-out; }
            background: @radial-gradient(circle,
                rgba(239, 130, 239, 0.11) 0%,
                rgba(239, 130, 239, 0.04) 40%,
                rgba(239, 130, 239, 0.00) 76%);
        }

        // --- Title strip: drag area + window controls, nothing else -------
        // x/y must be pinned: elements without a position binding default to
        // being centered in their parent, which shoved this strip mid-window.
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: Theme.title-bar-height;

            // Declared first so the controls stay on top of the drag region.
            // Plain clicks and drag still reach the move area; a double-click
            // on the strip toggles maximize.
            WindowMoveArea {
                width: 100%;
                height: 100%;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    double-clicked => { ShellState.window-maximize(); }
                }
            }

            Image {
                source: @image-url("../assets/Thulli-Mark.png");
                image-fit: contain;
                x: 20px;
                y: (parent.height - 24px) / 2;
                width: 24px;
                height: 24px;
            }

            Rectangle {
                width: 30px;
                height: 30px;
                x: parent.width - 98px - 10px - 38px;
                y: (parent.height - 30px) / 2;
                theme-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        Theme.theme-choice = Theme.dark-mode ? "light" : "dark";
                        ShellState.theme-choice = Theme.theme-choice;
                        ShellState.theme-choice-changed(Theme.theme-choice);
                    }
                    Rectangle {
                        width: 100%; height: 100%; border-radius: 9px;
                        background: theme-touch.has-hover ? Theme.glass-fill-hover : transparent;
                        animate background { duration: 120ms; easing: ease-out; }
                        if Theme.light-mode: IconMoon { width: 16px; height: 16px; x: 7px; y: 7px; stroke-color: Theme.text-secondary; }
                        if !Theme.light-mode: IconSun { width: 16px; height: 16px; x: 7px; y: 7px; stroke-color: Theme.text-secondary; }
                    }
                }
            }
            WindowControls {
                width: 98px;
                height: 30px;
                x: parent.width - 98px - 10px;
                y: (parent.height - 30px) / 2;
                is-maximized: ShellState.is-maximized;
                minimize => { ShellState.window-minimize(); }
                maximize => { ShellState.window-maximize(); }
                close => { ShellState.window-close(); }
            }
        }

        // --- Frosted glass panel -------------------------------------------
        Rectangle {
            x: parent.width < 640px ? 14px : (navigation-rail.expanded ? 286px : 116px);
            y: Theme.title-bar-height + 2px;
            width: parent.width < 640px
                ? parent.width - 28px
                : parent.width - (navigation-rail.expanded ? 300px : 130px);
            height: parent.height - Theme.title-bar-height - (parent.width < 640px ? 96px : 16px);
            border-radius: 26px;

            // Body: a diagonal light sweep — brighter top-left, mild dark
            // falloff bottom-right, like light raking across dark glass.
            background: Theme.dark-mode
                ? @linear-gradient(150deg,
                    rgba(255, 255, 255, 0.085) 0%,
                    rgba(255, 255, 255, 0.030) 36%,
                    rgba(255, 255, 255, 0.020) 58%,
                    rgba(0, 0, 0, 0.05) 100%)
                : @linear-gradient(150deg,
                    rgba(255, 255, 255, 0.92) 0%,
                    rgba(255, 255, 255, 0.74) 36%,
                    rgba(255, 255, 255, 0.60) 58%,
                    rgba(220, 235, 231, 0.70) 100%);

            border-width: 1px;
            border-color: Theme.dark-mode
                ? @linear-gradient(140deg,
                    rgba(255, 255, 255, 0.26) 0%,
                    rgba(255, 255, 255, 0.05) 34%,
                    rgba(255, 255, 255, 0.04) 60%,
                    rgba(255, 255, 255, 0.12) 100%)
                : @linear-gradient(140deg,
                    rgba(64, 86, 80, 0.24) 0%,
                    rgba(64, 86, 80, 0.08) 40%,
                    rgba(64, 86, 80, 0.10) 100%);

            drop-shadow-blur: 34px;
            drop-shadow-color: rgba(0, 0, 0, 0.38);
            drop-shadow-offset-y: 12px;

            // Specular top rim.
            Rectangle {
                x: 1px;
                y: 0px;
                width: parent.width - 2px;
                height: 1px;
                background: @linear-gradient(90deg,
                    transparent 0%,
                    rgba(255, 255, 255, 0.36) 18%,
                    rgba(255, 255, 255, 0.10) 55%,
                    rgba(255, 255, 255, 0.16) 85%,
                    transparent 100%);
            }

            // Corner glow where the silver orb sits behind the glass.
            Rectangle {
                x: parent.width - 340px;
                y: -160px;
                width: 400px;
                height: 400px;
                border-radius: 200px;
                background: @radial-gradient(circle,
                    rgba(255, 255, 255, 0.10) 0%,
                    rgba(255, 255, 255, 0.04) 40%,
                    rgba(255, 255, 255, 0.00) 75%);
            }
        }

        navigation-rail := NavigationRail {
            x: parent.width < 640px ? 12px : 24px;
            y: parent.width < 640px ? parent.height - self.height - 14px : Theme.title-bar-height + 2px;
            compact: parent.width < 640px;
            compact-width: parent.width - 24px;
            desktop-height: parent.height - Theme.title-bar-height - 16px;
        }

        // --- Frameless resize edges: transparent strips pinned to the ------
        // window frame, on top of everything, hidden while maximized.
        // Corners come last so they win over the edge strips.
        if !ShellState.is-maximized: EdgeResize {
            edge: "left";
            x: 0px;
            y: 0px;
            width: 6px;
            height: 100%;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "right";
            x: parent.width - 6px;
            y: 0px;
            width: 6px;
            height: 100%;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "top";
            x: 0px;
            y: 0px;
            width: 100%;
            height: 6px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "bottom";
            x: 0px;
            y: parent.height - 6px;
            width: 100%;
            height: 6px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "top-left";
            x: 0px;
            y: 0px;
            width: 16px;
            height: 16px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "top-right";
            x: parent.width - 16px;
            y: 0px;
            width: 16px;
            height: 16px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "bottom-left";
            x: 0px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
        }

        if !ShellState.is-maximized: EdgeResize {
            edge: "bottom-right";
            x: parent.width - 16px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
        }
    }
}
