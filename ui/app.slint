import { Theme } from "theme.slint";
import { TaskModel, ListModel, BlockedAppModel } from "types.slint";
import { WindowControls } from "window_controls.slint";

export { TaskModel, ListModel, BlockedAppModel }

/// MainWindow — Blank dark window with custom window border and window controls
export component MainWindow inherits Window {
    title: "Thulli";
    no-frame: true;
    preferred-width: 1240px;
    preferred-height: 780px;
    min-width: 800px;
    min-height: 500px;
    background: Theme.bg-canvas;
    default-font-family: "Segoe UI, Inter, sans-serif";

    // Application state (retained for backend service compatibility)
    in-out property <string> active-nav: "all_lists";
    in-out property <string> selected-list-id: "";
    in-out property <string> selected-list-name: "All Lists";
    in-out property <string> active-mode: "dashboard";
    in-out property <string> timer-display: "25:00";
    in-out property <bool> timer-running: false;
    in-out property <string> active-task-name: "";
    in-out property <bool> show-create-list-modal: false;
    in-out property <bool> show-preferences-modal: false;

    // Data models
    in-out property <[ListModel]> lists: [];
    in-out property <[TaskModel]> tasks: [];
    in-out property <[BlockedAppModel]> blocked-apps: [];

    // Inputs
    in-out property <string> new-list-name: "";
    in-out property <string> new-list-color: "#3CC9C4";
    in-out property <string> new-task-input: "";
    in-out property <string> scratchpad-text: "";

    // Window action callbacks
    callback window-drag-start();
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    // Functional callbacks
    callback toggle-timer();
    callback reset-timer();
    callback select-list(string);
    callback toggle-task(string);
    callback add-task(string, string, string);
    callback delete-task(string);
    callback create-list(string, string);
    callback delete-list(string);
    callback toggle-blocked-app(string);
    callback switch-app-mode(string);
    callback save-scratchpad(string);

    // Custom Window Frame Container with subtle border
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-canvas;
        border-width: 1px;
        border-color: Theme.border-subtle;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Custom Title Bar with Native Drag Area and Window Controls
            Rectangle {
                height: 40px;
                background: Theme.bg-canvas;

                // Drag hit test area across the title bar
                TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.window-drag-start();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    alignment: space-between;

                    // App Title / Branding
                    HorizontalLayout {
                        alignment: start;

                        Text {
                            text: "THULLI";
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1.5px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    // Window Controls (minimize, maximize, close)
                    WindowControls {
                        minimize => { root.window-minimize(); }
                        maximize => { root.window-maximize(); }
                        close => { root.window-close(); }
                    }
                }

                // Subtle bottom border for the title bar
                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Theme.border-subtle;
                }
            }

            // Blank dark canvas window body
            Rectangle {
                background: Theme.bg-canvas;
            }
        }
    }
}
