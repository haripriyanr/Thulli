import { Theme } from "../theme.slint";
import { IconChevronDown, IconCheck, IconInfo } from "../icons.slint";
import { SelectOption } from "../types.slint";

/// Switch: an on/off toggle with a mint gradient track when on.
export component Switch inherits Rectangle {
    in property <bool> on: false;
    callback toggled(bool);

    width: 50px;
    height: 28px;
    border-radius: 14px;
    background: root.on ? @linear-gradient(90deg, #5EEAD4 0%, #A3E635 100%) : Theme.glass-fill-strong;
    border-width: root.on ? 0px : 1px;
    border-color: Theme.glass-border;
    Rectangle {
        width: 22px;
        height: 22px;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        border-radius: 11px;
        background: root.on ? #1C1917 : Theme.text-muted;
        animate x { duration: 200ms; easing: ease-out; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.on); } }
}

/// SelectBox: a dropdown. Shows `current` and opens a list of `options`.
export component SelectBox inherits Rectangle {
    in property <[SelectOption]> options;
    in property <int> current: 0;
    in property <string> label;
    callback selected(int);

    width: 200px;
    height: 44px;
    border-radius: 12px;
    background: touch.has-hover ? Theme.glass-fill-hover : Theme.glass-fill-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    animate background { duration: 200ms; easing: ease-out; }

    Text {
        x: 16px;
        width: parent.width - 48px;
        height: 100%;
        text: root.label;
        font-size: 15px;
        font-weight: 700;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }
    IconChevronDown {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        stroke-color: Theme.text-muted;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { list.show(); } }

    list := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        height: min(root.options.length * 38px + 12px, 260px);
        Rectangle {
            border-radius: 12px;
            background: Theme.dark-mode ? #221C3A : #FFFFFF;
            border-width: 1px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 20px;
            drop-shadow-color: #00000059;
            clip: true;
            Flickable {
                y: 6px;
                height: parent.height - 12px;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    width: parent.width;
                    padding-left: 6px;
                    padding-right: 6px;
                    for option in root.options: Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: row-touch.has-hover ? Theme.glass-fill-hover : transparent;
                        Text {
                            x: 12px;
                            height: 100%;
                            text: option.label;
                            font-size: 14px;
                            font-weight: option.value == root.current ? 700 : 400;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        if option.value == root.current: IconCheck {
                            x: parent.width - self.width - 12px;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            stroke-color: Theme.accent-violet;
                        }
                        row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected(option.value); } }
                    }
                }
            }
        }
    }
}

/// InfoTip: a small info icon that shows `tip` while hovered.
export component InfoTip inherits Rectangle {
    in property <string> tip;
    width: 18px;
    height: 18px;
    touch := TouchArea {
        IconInfo { x: 1px; y: 1px; }
    }
    if touch.has-hover: Rectangle {
        x: 24px;
        y: -6px;
        width: tip-text.preferred-width + 20px;
        height: 30px;
        border-radius: 8px;
        background: Theme.dark-mode ? #2A2440 : #FFFFFF;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000040;
        tip-text := Text { text: root.tip; font-size: 12px; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    }
}

/// SettingRow: a label with an optional hint and info tip, and its control
/// on the right. The control goes in as a child. `strong` uses the larger
/// heading style for a top-level setting.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> info;
    in property <bool> strong: false;

    min-height: root.hint == "" ? 64px : 76px;
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                Text { text: root.label; font-size: root.strong ? 18px : 17px; font-weight: 600; color: Theme.text-secondary; vertical-alignment: center; }
                if root.info != "": VerticalLayout { alignment: center; InfoTip { tip: root.info; } }
            }
            if root.hint != "": Text { text: root.hint; font-size: 14px; color: Theme.text-muted; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout { alignment: end; @children }
        }
    }
}
