import { Theme } from "../theme.slint";
import { CheckBox } from "std-widgets.slint";
import { IconCheck, IconPlus, IconClose } from "../icons.slint";
import { ThulliIconButton } from "buttons.slint";

/// ThulliListCard — Reusable list item card for overview grids
export component ThulliListCard inherits TouchArea {
    in property <string> list-name: "List";
    in property <color> list-color: #6FDBAB;
    in property <int> pending-count: 0;
    in property <bool> is-archived: false;
    callback select();
    callback delete();

    width: 260px;
    height: 260px;
    clicked => { root.select(); }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-lg;
        background: root.has-hover ? Theme.bg-card-hover : Theme.bg-card;
        border-width: 1px;
        border-color: Theme.border-subtle;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.radius-full;
                        background: root.list-color;
                        y: 2px;
                        Text {
                            text: "P";
                            font-size: 13px;
                            font-weight: 700;
                            color: #000000;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.list-name;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                del-btn := ThulliIconButton {
                    size: 26px;
                    clicked => { root.delete(); }
                    IconClose {
                        width: 12px;
                        height: 12px;
                        stroke-color: del-btn.has-hover ? #EF4444 : Theme.text-muted;
                        x: 7px;
                        y: 7px;
                    }
                }
            }

            Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: Theme.radius-full;
                        border-width: 1.5px;
                        border-color: Theme.accent-lime;
                        background: #B3C06520;
                        x: 94px;

                        IconCheck {
                            width: 16px;
                            height: 16px;
                            stroke-color: Theme.accent-lime;
                            fill-color: transparent;
                            x: 8px;
                            y: 8px;
                        }
                    }

                    Text {
                        text: root.pending-count == 0 ? "ALL CLEAR" : "IN PROGRESS";
                        font-size: 11px;
                        font-weight: 700;
                        color: root.pending-count == 0 ? Theme.text-muted : Theme.accent-cyan;
                        horizontal-alignment: center;
                    }
                }
            }

            Text {
                text: root.pending-count + " pending tasks";
                font-size: 12px;
                color: Theme.text-muted;
            }
        }
    }
}

/// ThulliCreateListCard — Reusable "+ CREATE LIST" placeholder card
export component ThulliCreateListCard inherits TouchArea {
    callback action();

    width: 260px;
    height: 260px;
    clicked => { root.action(); }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-lg;
        background: root.has-hover ? Theme.bg-card-hover : Theme.bg-card;
        border-width: 1.5px;
        border-color: Theme.border-light;

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            IconPlus {
                width: 32px;
                height: 32px;
                stroke-color: root.has-hover ? Theme.accent-cyan : Theme.text-secondary;
                x: 114px;
            }

            Text {
                text: @tr("CREATE LIST");
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-primary;
                letter-spacing: 1px;
                horizontal-alignment: center;
            }
        }
    }
}

/// ThulliTaskCard — Reusable task card inside Kanban columns
export component ThulliTaskCard inherits Rectangle {
    in property <string> title: @tr("Task");
    in property <int> estimate-mins: 25;
    in property <bool> completed: false;
    callback toggled();
    callback deleted();

    height: 52px;
    background: Theme.bg-card;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            CheckBox {
                checked: root.completed;
                toggled => { root.toggled(); }
            }
            Text {
                text: root.title;
                font-size: 13px;
                color: root.completed ? Theme.text-muted : Theme.text-primary;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: root.estimate-mins + "m";
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            del-touch := ThulliIconButton {
                size: 22px;
                clicked => { root.deleted(); }
                IconClose {
                    width: 10px;
                    height: 10px;
                    stroke-color: del-touch.has-hover ? #EF4444 : Theme.text-muted;
                    x: 6px;
                    y: 6px;
                }
            }
        }
    }
}
