import { Theme } from "../theme.slint";

/// ThulliToggleSwitch: an on/off switch drawn with a translucent track and a
/// ring-style knob (no solid colour blocks).
///
/// Properties:
/// - `checked`: current state, set by the owner.
/// Callbacks:
/// - `toggled()`: the user clicked the switch; the owner flips its own state.
export component ThulliToggleSwitch inherits TouchArea {
    in property <bool> checked: false;
    callback toggled();

    width: 40px;
    height: 22px;

    clicked => { root.toggled(); }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-full;
        background: root.checked ? #3CC9C42E : (root.has-hover ? Theme.bg-card-hover : Theme.bg-card);
        border-width: 1.5px;
        border-color: root.checked ? Theme.accent-cyan : Theme.border-light;
        animate background { duration: 120ms; }

        Rectangle {
            x: root.checked ? parent.width - self.width - 3px : 3px;
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            border-radius: Theme.radius-full;
            background: root.checked ? #3CC9C455 : #9EABBE33;
            border-width: 1.5px;
            border-color: root.checked ? Theme.accent-cyan : Theme.text-secondary;
            animate x { duration: 120ms; }
        }
    }
}
