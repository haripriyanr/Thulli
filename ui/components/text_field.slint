import { Theme } from "../theme.slint";

/// ThulliTextField: a single-line text box with placeholder text.
///
/// `text` is two-way bindable; `accepted()` fires on Enter.
///
///   ThulliTextField { placeholder: "HH:MM"; text <=> start-time; }
export component ThulliTextField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback accepted();

    height: 34px;
    min-width: 60px;
    background: Theme.bg-panel;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-cyan.with-alpha(0.7) : Theme.border-light;

    input := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        font-size: 12px;
        color: Theme.text-primary;
        vertical-alignment: center;
        single-line: true;
        accepted => {
            root.accepted();
        }
    }

    Text {
        visible: input.text == "";
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        font-size: 12px;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
}
