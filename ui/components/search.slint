import { Theme } from "../theme.slint";
import { LineEdit } from "std-widgets.slint";
import { IconSearch, IconClose, IconFolder, IconPlus, IconFlag } from "../icons.slint";

/// One row of global search results. `encoded-id` is `task:<id>`, `list:<id>`
/// or `action:<name>`, built by the search service.
export struct SearchHitModel {
    encoded-id: string,
    kind: string,      // "task", "list" or "action"
    title: string,
    subtitle: string,
}

/// ThulliSearchField: a search box with a clear control. `text` is two-way
/// bound. `changed` fires on every edit so the owner can refresh results.
export component ThulliSearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: @tr("Search tasks");
    callback changed(string);

    height: 34px;
    background: Theme.bg-card;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-cyan : Theme.border-subtle;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;

        IconSearch {
            width: 14px;
            height: 14px;
            y: 10px;
            stroke-color: Theme.text-muted;
        }

        input := LineEdit {
            horizontal-stretch: 1;
            placeholder-text: root.placeholder;
            text <=> root.text;
            edited(_) => { root.changed(root.text); }
        }

        clear-touch := TouchArea {
            width: 24px;
            height: 24px;
            y: 5px;
            visible: root.text != "";
            clicked => {
                root.text = "";
                root.changed("");
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: Theme.radius-sm;
                background: clear-touch.has-hover ? Theme.bg-card-hover : transparent;
                IconClose {
                    width: 10px;
                    height: 10px;
                    x: 7px;
                    y: 7px;
                    stroke-color: Theme.text-muted;
                }
            }
        }
    }
}

/// ThulliSearchResults: grouped result rows. `picked` returns the encoded id.
export component ThulliSearchResults inherits Rectangle {
    in property <[SearchHitModel]> hits;
    callback picked(string);

    background: transparent;

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        for hit in root.hits: Rectangle {
            height: 52px;
            border-radius: Theme.radius-sm;
            background: row-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card;
            border-width: 1px;
            border-color: Theme.border-subtle;

            row-touch := TouchArea {
                clicked => { root.picked(hit.encoded-id); }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                alignment: start;

                if hit.kind == "list": IconFolder {
                    width: 16px;
                    height: 16px;
                    y: 18px;
                    stroke-color: Theme.accent-cyan;
                }
                if hit.kind == "task": IconFlag {
                    width: 16px;
                    height: 16px;
                    y: 18px;
                    stroke-color: Theme.accent-lime;
                }
                if hit.kind == "action": IconPlus {
                    width: 16px;
                    height: 16px;
                    y: 18px;
                    stroke-color: Theme.accent-pink;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: hit.title;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        overflow: elide;
                    }
                    Text {
                        text: hit.subtitle;
                        font-size: 11px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
