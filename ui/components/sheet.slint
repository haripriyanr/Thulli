import { Theme } from "../theme.slint";
import { IconClose } from "../icons.slint";

/// ThulliSheet: a modal panel over a dimmed backdrop.
///
/// Put the content inside it. Clicking the backdrop or the close button
/// fires `dismissed()`; the owner decides whether to hide the sheet. Place
/// it as the last child of a full-size container so it covers everything.
export component ThulliSheet inherits Rectangle {
    in property <string> title;
    in property <length> panel-width: 440px;
    in property <length> panel-height: 380px;
    in property <bool> closable: true;
    callback dismissed();

    background: #000000AA;

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    Rectangle {
        width: min(root.panel-width, root.width - 32px);
        height: min(root.panel-height, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: Theme.radius-lg;
        background: Theme.bg-panel;
        border-width: 1px;
        border-color: Theme.border-light;

        // Swallow clicks so they do not reach the backdrop.
        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            HorizontalLayout {
                height: 28px;
                Text {
                    text: root.title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.closable: close-area := TouchArea {
                    width: 28px;
                    height: 28px;
                    clicked => { root.dismissed(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: Theme.radius-sm;
                        background: close-area.has-hover ? Theme.bg-card-hover : transparent;
                        IconClose {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            @children
        }
    }
}
