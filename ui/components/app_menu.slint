import { Theme } from "../theme.slint";
import { IconNote, IconFolder, IconShield, IconChat, IconSettings, IconChart } from "../icons.slint";

/// One row of the app menu.
component ThulliMenuRow inherits TouchArea {
    in property <string> text;
    in property <string> icon-kind;

    height: 36px;
    width: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-sm;
        background: root.has-hover ? Theme.bg-card-hover : transparent;

        HorizontalLayout {
            padding-left: 10px;
            spacing: 10px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                if root.icon-kind == "notes": IconNote { }
                if root.icon-kind == "reports": IconChart { }
                if root.icon-kind == "lists": IconFolder { }
                if root.icon-kind == "shield": IconShield { }
                if root.icon-kind == "assistant": IconChat { }
                if root.icon-kind == "preferences": IconSettings { }
            }

            Text {
                text: root.text;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
    }
}

/// ThulliAppMenu: the "..." menu that reaches screens outside the three tabs.
/// `chosen(id)` carries the screen id ("notes", "lists", "shield",
/// "assistant", "preferences").
export component ThulliAppMenu inherits Rectangle {
    callback chosen(string);

    width: 220px;
    height: 6 * 36px + 2 * 6px + 2px;
    border-radius: Theme.radius-md;
    background: Theme.bg-card;
    border-width: 1px;
    border-color: Theme.border-light;

    VerticalLayout {
        padding: 6px;
        spacing: 0px;

        ThulliMenuRow { text: "Notes"; icon-kind: "notes"; clicked => { root.chosen("notes"); } }
        ThulliMenuRow { text: "Reports"; icon-kind: "reports"; clicked => { root.chosen("reports"); } }
        ThulliMenuRow { text: "Your lists"; icon-kind: "lists"; clicked => { root.chosen("lists"); } }
        ThulliMenuRow { text: "Distraction shield"; icon-kind: "shield"; clicked => { root.chosen("shield"); } }
        ThulliMenuRow { text: "Assistant"; icon-kind: "assistant"; clicked => { root.chosen("assistant"); } }
        ThulliMenuRow { text: "Preferences"; icon-kind: "preferences"; clicked => { root.chosen("preferences"); } }
    }
}
