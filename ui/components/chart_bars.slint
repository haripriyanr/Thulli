import { Theme } from "../theme.slint";
import { BarModel } from "../types.slint";

/// ThulliBarChart: vertical bars with a label under each and an optional
/// value above it.
///
/// `BarModel.value` is 0 to 1 of the tallest bar. `goal-line` draws a thin
/// horizontal marker at that fraction of the plot height (negative hides it).
/// Value labels are shown only when each bar has room for them. Day labels
/// are thinned so that roughly one label per 28px of width is drawn.
///
///   ThulliBarChart { bars: days; bar-color: Theme.accent-blue; goal-line: 0.8; height: 160px; }
export component ThulliBarChart inherits Rectangle {
    in property <[BarModel]> bars;
    in property <color> bar-color: Theme.accent-cyan;
    /// 0 to 1 of the plot height; negative hides the marker.
    in property <float> goal-line: -1;
    in property <bool> show-values: true;
    in property <length> label-height: 20px;
    in property <length> value-height: 16px;

    property <length> slot: root.bars.length > 0 ? root.width / root.bars.length : root.width;
    property <length> plot-height: max(1px, root.height - root.label-height - root.value-height);
    // Show every Nth day label so neighbouring labels never overlap.
    property <int> label-step: root.slot > 0px ? max(1, round(28px / root.slot)) : 1;

    min-height: 100px;
    background: transparent;

    // Baseline.
    Rectangle {
        y: root.value-height + root.plot-height;
        width: root.width;
        height: 1px;
        background: Theme.border-light;
    }

    // Goal marker.
    Rectangle {
        visible: root.goal-line >= 0;
        y: root.value-height + root.plot-height * (1 - root.goal-line);
        width: root.width;
        height: 1px;
        background: Theme.accent-amber.with-alpha(0.6);
    }

    for bar[i] in root.bars: Rectangle {
        x: i * root.slot;
        width: root.slot;
        height: root.height;

        Rectangle {
            width: min(root.slot * 0.62, 30px);
            x: (root.slot - self.width) / 2;
            height: max(bar.value > 0 ? 3px : 0px, root.plot-height * bar.value);
            y: root.value-height + root.plot-height - self.height;
            border-radius: 4px;
            background: @linear-gradient(180deg, root.bar-color 0%, root.bar-color.with-alpha(0.35) 100%);
        }

        Text {
            visible: root.show-values && root.slot >= 34px && bar.value > 0;
            x: 0px;
            width: root.slot;
            y: root.value-height + root.plot-height * (1 - bar.value) - root.value-height;
            height: root.value-height;
            text: bar.value_label;
            font-size: 10px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: bottom;
            overflow: clip;
        }

        Text {
            visible: root.label-height >= 12px && mod(i, root.label-step) == 0;
            x: -(root.slot * (root.label-step - 1)) / 2;
            width: root.slot * root.label-step;
            y: root.value-height + root.plot-height + 3px;
            height: root.label-height - 3px;
            text: bar.label;
            font-size: 10px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: clip;
        }
    }
}
