import { Theme } from "theme.slint";

// Duotone icon set. Every glyph sits on a 24 x 24 grid and has two layers:
// a translucent fill (`fill-color`, 15-20% alpha in the theme) for the body
// shape, and a crisp stroke (`stroke-color`) for the outline and details.
// Set `fill-color: transparent` for outline-only use.

component IconBase inherits Path {
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 1.7px;
    stroke-line-cap: round;
}

export component IconBolt inherits IconBase {
    in property <color> stroke-color: Theme.accent-amber;
    in property <color> fill-color: Theme.accent-amber-soft;
    width: 16px;
    height: 16px;
    stroke: stroke-color;
    fill: fill-color;
    commands: "M 13 2 L 4 14 L 11.5 14 L 10.5 22 L 20 9.5 L 12.5 9.5 Z";
}

