import { Theme } from "theme.slint";

// High-end Duotone / Non-Solid Filled Icons
// Soft translucent interior fills (15-20% opacity) with crisp geometric strokes

export component IconBolt inherits Path {
    in property <color> stroke-color: Theme.accent-cyan;
    in property <color> fill-color: #3CC9C433; // 20% alpha
    width: 16px;
    height: 16px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: stroke-color;
    stroke-width: 1.5px;
    fill: fill-color;
    commands: "M 13 2 L 3 14 L 12 14 L 11 22 L 21 10 L 12 10 Z";
}

