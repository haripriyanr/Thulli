// The disc and the rays are separate paths so the rays are never filled.
export component IconSun {
    in property <color> stroke-color: Theme.accent-amber;
    in property <color> fill-color: Theme.accent-amber-soft;
    width: 18px;
    height: 18px;
    IconBase {
        width: 100%;
        height: 100%;
        stroke: root.stroke-color;
        stroke-width: 1.8px;
        fill: root.fill-color;
        commands: "M 7.5 12 A 4.5 4.5 0 0 1 16.5 12 A 4.5 4.5 0 0 1 7.5 12 Z";
    }
    IconBase {
        width: 100%;
        height: 100%;
        stroke: root.stroke-color;
        stroke-width: 1.8px;
        fill: transparent;
        commands: "M 12 2 L 12 4 M 12 20 L 12 22 M 2 12 L 4 12 M 20 12 L 22 12 M 4.93 4.93 L 6.34 6.34 M 17.66 17.66 L 19.07 19.07 M 4.93 19.07 L 6.34 17.66 M 17.66 6.34 L 19.07 4.93";
    }
}

