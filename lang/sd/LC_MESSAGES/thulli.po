msgstr "جڏهن آن هجي، جيڪو ڳولي ٿو اهو لاڳاپيل ويب سائيٽن ڏانهن موڪليو وڃي ٿو. ٻيو سڀ ڪجهه هن ڊوائيس تي ئي رهي ٿو."

msgid "Writing the answer"
msgstr "جواب لکي پيو"

msgid "Yes, delete"
msgstr "ها، ختم ڪريو"

msgid "Yesterday"
msgstr "ڪالهه"

msgid "{} results"
msgstr "{} نتيجا"

msgid "A longer rest"
msgstr "وڏو آرام"

msgid "A short rest"
msgstr "ننڍو آرام"

msgid "A work session"
msgstr "ڪم جو سيشن"

msgid "Activity for the day"
msgstr "ڏينهن جي سرگرمي"

msgid "Activity for the month"
msgstr "مهيني جي سرگرمي"

msgid "Activity for the week"
msgstr "هفتي جي سرگرمي"

msgid "Activity for the year"
msgstr "سال جي سرگرمي"

msgid "Describe what you need and the assistant plans it"
msgstr "توهان کي جيڪو گهرجي بيان ڪريو ۽ اسسٽنٽ ان جي رٿابندي ڪندو"

msgid "Go to this week"
msgstr "هن هفتي ڏانهن وڃو"

msgid "Move to this week"
msgstr "هن هفتي ڏانهن منتقل ڪريو"

msgid "See tasks in columns"
