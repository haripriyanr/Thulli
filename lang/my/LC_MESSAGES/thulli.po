msgstr "သင်လိုအပ်သည်ကို ဖော်ပြပါ၊ လက်ထောက်က စီစဉ်ပေးပါမည်"

msgid "Go to this week"
msgstr "ယခုအပတ်သို့ သွားပါ"

msgid "Move to this week"
msgstr "ယခုအပတ်သို့ ရွှေ့ပါ"

msgid "See tasks in columns"
msgstr "အလုပ်များကို ကော်လံများဖြင့် ကြည့်ပါ"

msgid "See tasks on a weekly calendar"
msgstr "အပတ်စဉ် ပြက္ခဒိန်တွင် အလုပ်များ ကြည့်ပါ"

msgid "Set your own length"
msgstr "ကိုယ်ပိုင်ကြာချိန် သတ်မှတ်ပါ"

msgid "Sort tasks by urgency and importance"
msgstr "အရေးကြီးမှုနှင့် အရေးပေါ်မှုအလိုက် အလုပ်များ စီပါ"

msgid "Take it off the calendar"
msgstr "ပြက္ခဒိန်မှ ဖယ်ရှားပါ"
