msgid "Describe what you need and the assistant plans it"
msgstr "ನಿಮಗೆ ಬೇಕಾದ್ದನ್ನು ವಿವರಿಸಿ, ಸಹಾಯಕ ಯೋಜನೆ ರೂಪಿಸುತ್ತದೆ"

msgid "Go to this week"
msgstr "ಈ ವಾರಕ್ಕೆ ಹೋಗಿ"

msgid "Move to this week"
msgstr "ಈ ವಾರಕ್ಕೆ ಸರಿಸಿ"

msgid "See tasks in columns"
msgstr "ಕಾಲಂಗಳಲ್ಲಿ ಕಾರ್ಯಗಳನ್ನು ನೋಡಿ"

msgid "See tasks on a weekly calendar"
msgstr "ವಾರದ ಕ್ಯಾಲೆಂಡರ್‌ನಲ್ಲಿ ಕಾರ್ಯಗಳನ್ನು ನೋಡಿ"

msgid "Set your own length"
msgstr "ನಿಮ್ಮ ಸಮಯ ಹೊಂದಿಸಿ"

msgid "Sort tasks by urgency and importance"
msgstr "ತುರ್ತು ಮತ್ತು ಮಹತ್ವದಂತೆ ವಿಂಗಡಿಸಿ"

msgid "Take it off the calendar"
msgstr "ಕ್ಯಾಲೆಂಡರ್‌ನಿಂದ ತೆಗೆಯಿರಿ"
